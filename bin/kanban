STATES = ("backlog", "todo", "working", "review", "done", "archived", "trash")
TRANSITIONS = {
    "backlog": {"todo", "archived", "trash"},
    "todo": {"working", "archived", "trash"},
    # review: 开发已完成并 push, 等主控安排组级审核与集成; 修复轮次迁回 working.
    "working": {"review", "done", "archived", "trash"},
    "review": {"working", "done", "archived", "trash"},
    "done": {"archived", "trash"},
    "archived": {"trash"},
    "trash": set(),
}
TASK_ID_RE = re.compile(r"^\d{8}-[a-z0-9]+(?:-[a-z0-9]+)*-task$")
TASK_GROUP_RE = re.compile(r"^\d{8}-[a-z0-9]+(?:-[a-z0-9]+)*-group$")
SLUG_RE = re.compile(r"^[a-z0-9]+(?:-[a-z0-9]+)*$")
TYPE_NAMES = {
    "feature": "Feature",
    "bug": "Bug",
    "chore": "Chore",
    "research": "Research",
}
READY_SECTIONS = ("任务目标", "预期成果", "验收条件", "不在本轮范围")
ARCHIVE_RESULTS = {"completed", "cancelled", "duplicate", "wontfix"}
AGENT_NAMES = EXECUTION_AGENTS
NO_TITLE = t("(无标题)", "(untitled)")


class KanbanError(Exception):
    pass


@dataclass(frozen=True)
class Entry:
    task_id: str
    state: str
    path: Path
    document: Path
    kind: str


@dataclass(frozen=True)
class Board:
    """一次扫描的结果.

    无效入口不再让整个看板不可读: 它们进入 problems 由 `check` 汇报, 而与某个
    任务 ID 绑定的违规 (重复 ID, 大任务缺 spec.md) 另外记入 blocked, 只让操作
    该任务的命令失败. 未受影响的任务照常可读可迁移.
    """

    entries: Dict[str, Entry]
    blocked: Dict[str, str]
    problems: list["Problem"]


@dataclass(frozen=True)
class Problem:
    path: Path
    message: str


@dataclass(frozen=True)
class TaskDependencies:
    """一张任务卡的机器可读前置依赖及任务组展开结果."""

    prerequisite_ids: tuple[str, ...]
    internal_tasks: tuple[str, ...]
    external_tasks: tuple[str, ...]
    task_groups: tuple[str, ...]
    expanded_task_ids: tuple[str, ...]


def git_main_worktree(directory: Path) -> Optional[Path]:
    try:
        git = subprocess.run(
            ["git", "-C", str(directory), "worktree", "list", "--porcelain"],
            text=True,
            capture_output=True,
            check=False,
        )
    except OSError:
        return None
    if git.returncode != 0:
        return None
    for line in git.stdout.splitlines():
        if line.startswith("worktree "):
            return absolute_user_path(Path(line.removeprefix("worktree ")))
    return None


def absolute_user_path(path: Path) -> Path:
    """生成绝对路径；Windows 保留词法路径，不用 resolve 隐藏 junction."""
    expanded = path.expanduser()
    if os.name == "nt":
        return Path(os.path.abspath(os.fspath(expanded)))
    return expanded.resolve()


def ensure_windows_lexical_path_safe(path: Path) -> None:
    """Windows 上拒绝路径自身或任一已存在祖先中的 reparse point."""
    if os.name != "nt":
        return
    absolute = absolute_user_path(path)
    parts = absolute.parts
    if not parts:
        raise KanbanError(t(f"无效看板路径: {path}", f"Invalid board path: {path}"))
    current = Path(parts[0])
    candidates = [current]
    for part in parts[1:]:
        current /= part
        candidates.append(current)
    for candidate in candidates:
        if not os.path.lexists(candidate):
            # 后续分量不可能在缺失祖先下独立存在；init 可从这里安全创建.
            break
        if is_reparse_point(candidate):
            raise KanbanError(t(
                f"看板路径分量不得是符号链接/重解析点: {candidate}",
                f"Board path component must not be a symlink/reparse point: {candidate}",
            ))


def board_root() -> Path:
    configured = os.environ.get("KANBAN_DIR")
    if configured:
        root = absolute_user_path(Path(configured))
        ensure_windows_lexical_path_safe(root)
        return root
    main_worktree = git_main_worktree(Path.cwd())
    if main_worktree:
        candidate = main_worktree / "kanban"
        ensure_windows_lexical_path_safe(candidate)
        if candidate.is_dir():
            return absolute_user_path(candidate)
    current = absolute_user_path(Path.cwd())
    ensure_windows_lexical_path_safe(current)
    for parent in (current, *current.parents):
        candidate = parent / "kanban"
        ensure_windows_lexical_path_safe(candidate)
        if candidate.is_dir():
            return absolute_user_path(candidate)
    raise KanbanError(t(
        "找不到看板目录; 请在项目内运行或设置 KANBAN_DIR",
        "Board directory not found; run inside a project or set KANBAN_DIR",
    ))


def current_install_paths() -> InstallPaths:
    try:
        return install_paths(entry=Path(__file__))
    except ConfigError as error:
        raise KanbanError(str(error)) from error


def rules_path(paths: Optional[InstallPaths] = None) -> Path:
    return (paths or current_install_paths()).rules_dir / "KANBAN-RULES.md"


def command_rules() -> None:
    paths = current_install_paths()
    rules = rules_path(paths)
    if not rules.is_file():
        if paths.mode == "project":
            raise KanbanError(
                t(f"项目规则不存在: {rules}", f"Project rules file does not exist: {rules}")
            )
        raise KanbanError(
            t(f"全局规则不存在: {rules}", f"Global rules file does not exist: {rules}")
        )
    sys.stdout.write(rules.read_text(encoding="utf-8"))


def start_agent_prompt(task_id: str, paths: InstallPaths, task_group: str = "") -> str:
    """生成 start 交给执行 Agent 的固定说明.

    全局模式保持 PATH 中的 `kanban` 与相对的项目 AGENTS.md; 项目模式必须
    给出命令根和主 worktree 规则入口的绝对路径, 避免 Agent 改走 PATH 里
    的全局同名命令. 任务组卡只做到迁 review: 审核, 集成和收尾归主控.
    """
    if paths.mode == "project":
        if paths.project_root is None:
            raise KanbanError(
                t(
                    "项目安装路径缺少主 worktree",
                    "project install paths are missing the main worktree",
                )
            )
        kanban_cmd = str(paths.bin_dir / "kanban")
        follow = f"遵守 {paths.project_root / 'AGENTS.md'}"
    else:
        kanban_cmd = "kanban"
        follow = "遵守目标项目 AGENTS.md"
    head = (
        f"执行 Kanban 任务 {task_id}. 先运行 {kanban_cmd} rules, 再运行 "
        f"{kanban_cmd} show {task_id}. 卡片已进入 working. {follow}, "
    )
    if task_group:
        return head + (
            f"补充任务分支, 按看板规则的任务组流程完成任务、验证, 提交 push 并汇入组集成分支, "
            f"写好实施与验证后执行 {kanban_cmd} move {task_id} review 并退出; "
            "审核、集成和看板收尾由任务组主控负责, 不要自行审核或合回 develop."
        )
    return head + "补充任务分支, 并按项目规则完成任务、验证、审核、集成和看板收尾."
def add_git_exclude(root: Path) -> Optional[Path]:
    try:
        git_root_result = subprocess.run(
            ["git", "-C", str(root.parent), "rev-parse", "--show-toplevel"],
            text=True,
            capture_output=True,
            check=False,
        )
    except OSError:
        return None
    if git_root_result.returncode != 0:
        return None
    if os.name == "nt":
        git_root = Path(os.path.abspath(git_root_result.stdout.strip()))
        board_root = Path(os.path.abspath(os.fspath(root)))
    else:
        git_root = Path(git_root_result.stdout.strip()).resolve()
        board_root = root.resolve()
    try:
        relative = board_root.relative_to(git_root)
    except ValueError:
        return None
    exclude_result = subprocess.run(
        ["git", "-C", str(git_root), "rev-parse", "--git-path", "info/exclude"],
        text=True,
        capture_output=True,
        check=False,
    )
    if exclude_result.returncode != 0:
        raise KanbanError(t("无法定位 Git info/exclude", "Cannot locate Git info/exclude"))
    exclude = Path(exclude_result.stdout.strip())
    if not exclude.is_absolute():
        exclude = git_root / exclude
    pattern = f"/{relative.as_posix().strip('/')}/"
    if os.name == "nt":
        exclude = Path(os.path.abspath(os.fspath(exclude)))
        ensure_inherited_directory_path_nofollow(exclude.parent)
        anchor = Path(exclude.anchor)
        with open_append_file_nofollow(anchor, exclude) as file:
            with exclusive_file_lock(file):
                file.seek(0)
                existing = file.read().decode("utf-8")
                if pattern not in existing.splitlines():
                    addition = (
                        ("\n" if existing and not existing.endswith("\n") else "")
                        + pattern
                        + "\n"
                    )
                    file.write(addition.encode("utf-8"))
        return exclude

    existing = exclude.read_text(encoding="utf-8") if exclude.exists() else ""
    if pattern not in existing.splitlines():
        exclude.parent.mkdir(parents=True, exist_ok=True)
        with exclude.open("a", encoding="utf-8", newline="\n") as file:
            if existing and not existing.endswith("\n"):
                file.write("\n")
            file.write(pattern + "\n")
    return exclude.resolve()


def ensure_private_board_directory(path: Path) -> None:
    """Windows 上幂等打开私有目录，缺失时以 CREATE_NEW 安全发布."""
    if path.parent == path:
        raise KanbanError(t(
            f"看板目录不能是文件系统根: {path}",
            f"Board directory cannot be a filesystem root: {path}",
        ))
    ensure_inherited_directory_path_nofollow(path.parent)
    try:
        directory_identity_nofollow(path.parent, path)
    except FileNotFoundError:
        # 安全 probe 后发生同名创建时，严格 CREATE_NEW 必须失败，不能
        # 接受竞态产生的目录作为既有看板边界.
        create_private_directory_nofollow(path.parent, path)
    else:
        # 只迁移叶目录，既有父目录 ACL 保持不变；probe 后消失也不得
        # 静默重建，因此显式关闭 create.
        ensure_private_directory_nofollow(path.parent, path, create=False)


def command_init(args: argparse.Namespace) -> None:
    configured = os.environ.get("KANBAN_DIR")
    if args.project and configured:
        raise KanbanError(t("不能同时指定 project-path 和 KANBAN_DIR", "project-path and KANBAN_DIR cannot be used together"))
    if args.project:
        project = absolute_user_path(Path(args.project))
        ensure_windows_lexical_path_safe(project)
        if not project.is_dir():
            raise KanbanError(t(f"项目目录不存在: {project}", f"Project directory does not exist: {project}"))
        root = project / "kanban"
    elif configured:
        root = absolute_user_path(Path(configured))
    else:
        project = git_main_worktree(Path.cwd()) or absolute_user_path(Path.cwd())
        root = project / "kanban"
    ensure_windows_lexical_path_safe(root)
    if root.exists() and not root.is_dir():
        raise KanbanError(t(f"看板路径不是目录: {root}", f"Board path is not a directory: {root}"))
    if os.name == "nt":
        ensure_private_board_directory(root)
    else:
        root.mkdir(parents=True, exist_ok=True)
        ensure_windows_lexical_path_safe(root)
    for state in STATES:
        create_state_directory(root / state)
    exclude = add_git_exclude(root)
    print(t(f"已初始化: {root}", f"initialized: {root}"))
    if exclude:
        print(t(f"Git 排除文件: {exclude}", f"git exclude: {exclude}"))
    print(t(f"规则: {rules_path()}", f"rules: {rules_path()}"))


def create_state_directory(path: Path) -> None:
    """幂等创建一个状态目录; Windows 在创建时应用私有 DACL, 既有目录只迁移 ACL."""
    ensure_windows_lexical_path_safe(path)
    if path.exists() and not path.is_dir():
        raise KanbanError(t(f"状态路径不是目录: {path}", f"State path is not a directory: {path}"))
    if os.name == "nt":
        ensure_private_board_directory(path)
    else:
        path.mkdir(exist_ok=True)
        ensure_windows_lexical_path_safe(path)


# review 是后加的状态: 旧看板只有这 6 个目录.
LEGACY_STATES = tuple(state for state in STATES if state != "review")


def ensure_layout(root: Path) -> None:
    ensure_windows_lexical_path_safe(root)
    if not root.is_dir() or is_reparse_point(root):
        raise KanbanError(t(f"看板目录不存在或不得是符号链接/重解析点: {root}", f"Board directory does not exist or is a symlink/reparse point: {root}"))
    for state in STATES:
        path = root / state
        if is_reparse_point(path):
            raise KanbanError(t(f"状态目录不得是符号链接/重解析点: {path}", f"State directory must not be a symlink/reparse point: {path}"))
        if path.is_dir():
            continue
        if path.exists():
            raise KanbanError(t(f"状态路径不是目录: {path}", f"State path is not a directory: {path}"))
        if state == "review" and all(
            (root / legacy).is_dir() and not is_reparse_point(root / legacy) for legacy in LEGACY_STATES
        ):
            # 旧版看板升级: 其余 6 个目录齐全时自动补建 review, 不要求用户重跑 init.
            create_state_directory(path)
            continue
        raise KanbanError(t(f"状态目录不存在: {path}", f"State directory does not exist: {path}"))


def scan(root: Path) -> Board:
    ensure_layout(root)
    entries: Dict[str, Entry] = {}
    blocked: Dict[str, str] = {}
    problems: list[Problem] = []

    def reject(path: Path, message: str, task_id: Optional[str] = None) -> None:
        problems.append(Problem(path, message))
        if task_id:
            blocked[task_id] = message
            entries.pop(task_id, None)

    for state in STATES:
        for path in sorted((root / state).iterdir(), key=lambda item: item.name):
            if path.name.startswith("."):
                continue
            if is_reparse_point(path):
                reject(path, t(f"任务入口不得是符号链接/重解析点: {path}", f"Task entry must not be a symlink/reparse point: {path}"))
                continue
            if path.is_file() and path.name.endswith("-task.md"):
                task_id, document, kind = path.name[:-3], path, "small"
            elif path.is_dir() and path.name.endswith("-task"):
                task_id, document, kind = path.name, path / "spec.md", "large"
            else:
                reject(path, t(f"无效任务入口: {path}", f"Invalid task entry: {path}"))
                continue
            if not TASK_ID_RE.fullmatch(task_id):
                reject(path, t(f"无效任务 ID: {task_id}", f"Invalid task ID: {task_id}"))
                continue
            if kind == "large":
                if is_reparse_point(document):
                    reject(
                        path,
                        t(f"大任务 spec.md 不得是符号链接/重解析点: {document}", f"Large-task spec.md must not be a symlink/reparse point: {document}"),
                        task_id,
                    )
                    continue
                if not document.is_file():
                    reject(path, t(f"大任务缺少 spec.md: {path}", f"Large task is missing spec.md: {path}"), task_id)
                    continue
            if task_id in blocked:
                problems.append(Problem(path, t(f"任务 ID 存在冲突: {task_id}", f"Task ID conflict: {task_id}")))
                continue
            if task_id in entries:
                reject(path, t(f"重复任务 ID: {entries[task_id].path} 与 {path}", f"Duplicate task ID: {entries[task_id].path} and {path}"), task_id)
                continue
            entries[task_id] = Entry(task_id, state, path, document, kind)
    return Board(entries, blocked, problems)


def scan_targets_once(root: Path, task_ids: list[str]) -> tuple[Board, bool]:
    entries: Dict[str, Entry] = {}
    blocked: Dict[str, str] = {}
    problems: list[Problem] = []
    needs_confirmation = False
    for task_id in task_ids:
        matches: list[Entry] = []
        for state in STATES:
            state_path = root / state
            small_path = state_path / f"{task_id}.md"
            large_path = state_path / task_id

            if is_reparse_point(small_path):
                problems.append(Problem(small_path, t(
                    f"任务入口不得是符号链接/重解析点: {small_path}",
                    f"Task entry must not be a symlink/reparse point: {small_path}",
                )))
            else:
                try:
                    small_exists = regular_file_exists_nofollow(root, small_path)
                except OSError:
                    problems.append(Problem(small_path, t(
                        f"任务入口类型错误: {small_path}",
                        f"Task entry has the wrong type: {small_path}",
                    )))
                else:
                    if small_exists:
                        matches.append(Entry(task_id, state, small_path, small_path, "small"))

            if is_reparse_point(large_path):
                problems.append(Problem(large_path, t(
                    f"任务入口不得是符号链接/重解析点: {large_path}",
                    f"Task entry must not be a symlink/reparse point: {large_path}",
                )))
                continue
            try:
                large_exists = directory_exists_nofollow(root, large_path)
            except OSError:
                problems.append(Problem(large_path, t(
                    f"任务入口类型错误: {large_path}",
                    f"Task entry has the wrong type: {large_path}",
                )))
                continue
            if not large_exists:
                continue
            document = large_path / "spec.md"
            if is_reparse_point(document):
                problems.append(Problem(large_path, t(
                    f"大任务 spec.md 不得是符号链接/重解析点: {document}",
                    f"Large-task spec.md must not be a symlink/reparse point: {document}",
                )))
                continue
            try:
                spec_exists = regular_file_exists_nofollow(root, document)
            except OSError:
                problems.append(Problem(large_path, t(
                    f"大任务 spec.md 不是普通文件: {document}",
                    f"Large-task spec.md is not a regular file: {document}",
                )))
                continue
            if not spec_exists:
                problems.append(Problem(large_path, t(
                    f"大任务缺少 spec.md: {large_path}",
                    f"Large task is missing spec.md: {large_path}",
                )))
                continue
            matches.append(Entry(task_id, state, large_path, document, "large"))

        task_problems = [problem for problem in problems if problem.path.name in (task_id, f"{task_id}.md")]
        if len(matches) > 1:
            message = t(
                f"重复任务 ID: {' 与 '.join(str(entry.path) for entry in matches)}",
                f"Duplicate task ID: {' and '.join(str(entry.path) for entry in matches)}",
            )
            problems.append(Problem(matches[-1].path, message))
            blocked[task_id] = message
            needs_confirmation = True
        elif task_problems:
            blocked[task_id] = task_problems[0].message
        elif matches:
            entries[task_id] = matches[0]
        else:
            message = t(f"任务不存在: {task_id}", f"Task does not exist: {task_id}")
            problems.append(Problem(root, message))
            blocked[task_id] = message
            needs_confirmation = True
    return Board(entries, blocked, problems), needs_confirmation


def scan_targets(root: Path, values: Iterable[str]) -> Board:
    """只探测明确任务 ID；瞬时缺失或冲突须经有限复扫确认."""
    ensure_layout(root)
    task_ids = [normalize_task_id(value) for value in values]
    if len(task_ids) != len(set(task_ids)):
        raise KanbanError(t("指定任务 ID 不得重复", "Target task IDs must not be repeated"))
    board: Board
    for _ in range(3):
        board, needs_confirmation = scan_targets_once(root, task_ids)
        if not needs_confirmation:
            return board
    return board


def load_board(root: Path) -> Board:
    board = scan(root)
    if board.problems:
        print(
            t(
                f"kanban: 警告: {len(board.problems)} 个无效入口已忽略, 运行 kanban check 查看",
                f"kanban: warning: ignored {len(board.problems)} invalid entries; run kanban check for details",
            ),
            file=sys.stderr,
        )
    return board


def normalize_task_id(value: str) -> str:
    if "/" in value or "\\" in value:
        raise KanbanError(t("任务参数只能使用任务 ID 或入口名", "Task argument must be a task ID or entry name"))
    task_id = value[:-3] if value.endswith(".md") else value
    if not TASK_ID_RE.fullmatch(task_id):
        raise KanbanError(t(f"无效任务 ID: {value}", f"Invalid task ID: {value}"))
    return task_id


def locate(board: Board, value: str) -> Entry:
    task_id = normalize_task_id(value)
    if task_id in board.blocked:
        raise KanbanError(board.blocked[task_id])
    try:
        return board.entries[task_id]
    except KeyError as error:
        raise KanbanError(t(f"任务不存在: {task_id}", f"Task does not exist: {task_id}")) from error


def board_root_from_entry(entry: Entry) -> Path:
    # 入口恒为 <board>/<state>/<name>, 文档在入口内或即入口本身.
    return entry.path.parent.parent


def ensure_no_symlinks_under_board(root: Path, path: Path) -> None:
    """从看板根走到 path 的每一级分量都不得是软链, 防止中间目录被掉包."""
    root = root.resolve(strict=False)
    candidate = path if path.is_absolute() else root / path
    try:
        common = os.path.commonpath([str(root), str(candidate)])
    except ValueError as error:
        raise KanbanError(t(f"任务路径越出看板: {path}", f"Task path escapes the board: {path}")) from error
    if common != str(root):
        raise KanbanError(t(f"任务路径越出看板: {path}", f"Task path escapes the board: {path}"))
    relative = os.path.relpath(str(candidate), str(root))
    current = root
    if current.is_symlink():
        raise KanbanError(t(f"路径分量不得是符号链接: {current}", f"Path component must not be a symlink: {current}"))
    if relative in ("", "."):
        return
    for part in Path(relative).parts:
        current = current / part
        if current.is_symlink():
            raise KanbanError(t(f"路径分量不得是符号链接: {current}", f"Path component must not be a symlink: {current}"))


def openat_nofollow(dir_fd: int, name: str, flags: int) -> int:
    open_flags = flags
    if hasattr(os, "O_NOFOLLOW"):
        open_flags |= os.O_NOFOLLOW
    try:
        return os.open(name, open_flags, dir_fd=dir_fd)
    except OSError as error:
        if getattr(error, "errno", None) in {getattr(os, "ELOOP", 40), 40}:
            raise KanbanError(t(f"路径分量不得是符号链接: {name}", f"Path component must not be a symlink: {name}")) from error
        raise


def read_document(entry: Entry) -> str:
    try:
        try:
            data = read_regular_file_nofollow(
                board_root_from_entry(entry), entry.document
            )
        except UnsafePathError as error:
            raise KanbanError(t(
                f"任务路径不得包含符号链接/重解析点且文档必须是普通文件: {error}",
                f"Task path must not contain a symlink/reparse point and the document must be a regular file: {error}",
            )) from error
        return data.decode("utf-8")
    except UnicodeError as error:
        raise KanbanError(t(f"任务文档不是有效 UTF-8: {entry.document}", f"Task document is not valid UTF-8: {entry.document}")) from error


def title_from(text: str) -> str:
    for line in text.splitlines():
        if line.startswith("# "):
            return line[2:].strip()
    return NO_TITLE


def section_body(text: str, heading: str) -> Optional[str]:
    match = re.search(rf"(?m)^## {re.escape(heading)}\s*$", text)
    if not match:
        return None
    next_heading = re.search(r"(?m)^## ", text[match.end() :])
    end = match.end() + next_heading.start() if next_heading else len(text)
    return text[match.end() : end].strip()


def result_from(text: str) -> str:
    match = re.search(r"(?m)^- 结果:\s*(.*?)\s*$", text)
    return match.group(1) if match else ""


def metadata_from(text: str, name: str) -> str:
    match = re.search(rf"(?m)^- {re.escape(name)}:[ \t]*(.*?)[ \t]*$", text)
    return match.group(1) if match else ""


def task_group_from(text: str) -> str:
    task_group = metadata_from(text, "任务组")
    if task_group:
        return task_group
    discussion = section_body(text, "讨论与决策")
    if not discussion:
        return ""
    match = re.search(r"(?m)^任务组:[ \t]*(.*?)[ \t]*$", discussion)
    return match.group(1) if match else ""


def prerequisite_ids_from(text: str, task_id: str) -> tuple[str, ...]:
    """读取讨论章节开头的 `前置任务` 行; 旧卡缺行时返回空列表."""
    discussion = section_body(text, "讨论与决策")
    if not discussion:
        return ()
    lines = discussion.splitlines()
    positions = [
        index for index, line in enumerate(lines)
        if line.strip().startswith("前置任务")
    ]
    if not positions:
        return ()
    if (
        lines[0].strip() not in ("```", "```text")
        or len(positions) != 1
        or positions[0] != 1
    ):
        raise KanbanError(t(
            f"任务 {task_id} 的前置任务语法非法: 必须位于讨论与决策开头的代码块中",
            f"Task {task_id} has invalid prerequisite syntax: it must be in the opening discussion code block",
        ))
    if len(lines) < 3 or lines[2].strip() != "```":
        raise KanbanError(t(
            f"任务 {task_id} 的前置任务语法非法: 代码块必须在该行后结束",
            f"Task {task_id} has invalid prerequisite syntax: close the code block after the line",
        ))
    match = re.fullmatch(r"前置任务[ \t]*:[ \t]*(.*?)[ \t]*", lines[1].strip())
    if match is None or not match.group(1):
        raise KanbanError(t(
            f"任务 {task_id} 的前置任务语法非法: 无依赖时写 N/A",
            f"Task {task_id} has invalid prerequisite syntax: use N/A for no dependencies",
        ))
    value = match.group(1)
    if value == "N/A":
        return ()
    values = tuple(part.strip() for part in value.split(","))
    if any(not part for part in values) or any(
        not (TASK_ID_RE.fullmatch(part) or TASK_GROUP_RE.fullmatch(part))
        for part in values
    ):
        raise KanbanError(t(
            f"任务 {task_id} 的前置任务语法非法: {value}",
            f"Task {task_id} has invalid prerequisite syntax: {value}",
        ))
    return values


def task_dependencies(
    entry: Entry,
    board: Board,
    documents: Optional[Dict[str, str]] = None,
) -> TaskDependencies:
    """解析并分类依赖; 任务组引用展开为该组当前全部成员卡."""
    texts = documents if documents is not None else {
        task_id: read_document(candidate)
        for task_id, candidate in board.entries.items()
    }
    source_group = task_group_from(texts[entry.task_id])
    if not source_group:
        return TaskDependencies((), (), (), (), ())

    prerequisite_ids = prerequisite_ids_from(texts[entry.task_id], entry.task_id)
    group_members = task_group_members(texts)

    internal_tasks: list[str] = []
    external_tasks: list[str] = []
    task_groups: list[str] = []
    expanded: list[str] = []
    for prerequisite_id in prerequisite_ids:
        if TASK_GROUP_RE.fullmatch(prerequisite_id):
            members = group_members.get(prerequisite_id)
            if not members:
                raise KanbanError(t(
                    f"任务 {entry.task_id} 引用了不存在的前置 ID: {prerequisite_id}",
                    f"Task {entry.task_id} references a missing prerequisite ID: {prerequisite_id}",
                ))
            task_groups.append(prerequisite_id)
            expanded.extend(members)
            continue
        prerequisite = board.entries.get(prerequisite_id)
        if prerequisite is None:
            raise KanbanError(t(
                f"任务 {entry.task_id} 引用了不存在的前置 ID: {prerequisite_id}",
                f"Task {entry.task_id} references a missing prerequisite ID: {prerequisite_id}",
            ))
        prerequisite_group = task_group_from(texts.get(prerequisite.task_id, ""))
        if prerequisite_group == source_group:
            internal_tasks.append(prerequisite_id)
        else:
            external_tasks.append(prerequisite_id)
        expanded.append(prerequisite_id)

    return TaskDependencies(
        prerequisite_ids,
        tuple(internal_tasks),
        tuple(external_tasks),
        tuple(task_groups),
        tuple(dict.fromkeys(expanded)),
    )


def task_group_members(documents: Dict[str, str]) -> Dict[str, tuple[str, ...]]:
    """按任务组索引当前成员, 供依赖解析和只读监控共同使用."""
    members: Dict[str, list[str]] = {}
    for task_id, text in documents.items():
        task_group = task_group_from(text)
        if task_group:
            members.setdefault(task_group, []).append(task_id)
    return {
        task_group: tuple(sorted(task_ids))
        for task_group, task_ids in members.items()
    }


def dependency_problems(board: Board, selected: Optional[set[str]] = None) -> list[Problem]:
    """校验依赖引用与环; 定向检查只遍历所选任务可达的依赖图."""
    documents: Dict[str, str] = {}
    document_errors: Dict[str, KanbanError] = {}
    for task_id, entry in board.entries.items():
        try:
            documents[task_id] = read_document(entry)
        except KanbanError as error:
            document_errors[task_id] = error

    resolved: Dict[str, TaskDependencies] = {}
    resolution_errors: Dict[str, KanbanError] = {}

    def resolve(task_id: str) -> Optional[TaskDependencies]:
        if task_id in resolved:
            return resolved[task_id]
        if task_id in resolution_errors:
            return None
        if task_id in document_errors:
            resolution_errors[task_id] = document_errors[task_id]
            return None
        try:
            value = task_dependencies(board.entries[task_id], board, documents)
        except KanbanError as error:
            resolution_errors[task_id] = error
            return None
        resolved[task_id] = value
        return value

    roots = sorted(selected if selected is not None else board.entries)
    problems: list[Problem] = []
    reported_errors: set[str] = set()
    reported_cycles: set[tuple[str, ...]] = set()
    visiting: list[str] = []
    visited: set[str] = set()

    def visit(task_id: str) -> None:
        if task_id in visited:
            return
        if task_id in visiting:
            start = visiting.index(task_id)
            cycle = tuple(visiting[start:] + [task_id])
            if cycle not in reported_cycles:
                reported_cycles.add(cycle)
                source = board.entries[visiting[-1]]
                problems.append(Problem(source.path, t(
                    f"依赖成环: {' -> '.join(cycle)}",
                    f"Dependency cycle: {' -> '.join(cycle)}",
                )))
            return
        visiting.append(task_id)
        dependencies = resolve(task_id)
        if dependencies is None:
            if task_id not in reported_errors:
                reported_errors.add(task_id)
                problems.append(Problem(
                    board.entries[task_id].path,
                    str(resolution_errors[task_id]),
                ))
        else:
            for prerequisite_id in dependencies.expanded_task_ids:
                visit(prerequisite_id)
        visiting.pop()
        visited.add(task_id)

    for root in roots:
        if root in board.entries:
            visit(root)
    return problems


def completion_metadata(text: str) -> str:
    value = datetime.now().strftime("%Y-%m-%d %H:%M")
    matches = list(re.finditer(r"(?m)^- 完成时间:.*$", text))
    if len(matches) == 1:
        return re.sub(r"(?m)^- 完成时间:.*$", f"- 完成时间: {value}", text, count=1)
    if matches:
        raise KanbanError(t("任务文档缺少唯一元数据字段: 完成时间", "Task document must contain exactly one completion-time metadata field"))
    started = list(re.finditer(r"(?m)^- 开始时间:.*$", text))
    if len(started) != 1:
        raise KanbanError(t("任务文档缺少唯一元数据字段: 开始时间", "Task document must contain exactly one start-time metadata field"))
    return re.sub(
        r"(?m)^(- 开始时间:.*)$", rf"\1\n- 完成时间: {value}", text, count=1
    )


def open_dir_nofollow(root: Path, directory: Path) -> int:
    """打开目录 fd, 路径上每一级都不跟随软链."""
    ensure_no_symlinks_under_board(root, directory)
    root_resolved = root.resolve(strict=False)
    relative = os.path.relpath(str(directory), str(root_resolved))
    parts = [] if relative in ("", ".") else list(Path(relative).parts)
    dir_fd = os.open(root, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    try:
        for part in parts:
            next_fd = openat_nofollow(
                dir_fd, part, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0)
            )
            os.close(dir_fd)
            dir_fd = next_fd
        return dir_fd
    except BaseException:
        os.close(dir_fd)
        raise


def write_text_atomic(path: Path, text: str, *, entry: Optional[Entry] = None) -> None:
    """通过父目录 fd 创建临时文件并 replace, 避免校验后父路径被换成软链."""
    if entry is None:
        if is_reparse_point(path):
            raise KanbanError(t(f"任务文档不得是符号链接/重解析点: {path}", f"Task document must not be a symlink/reparse point: {path}"))
        handle, temp_name = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
        temp_path = Path(temp_name)
        try:
            with os.fdopen(handle, "w", encoding="utf-8", newline="\n") as file:
                file.write(text)
            if path.exists() and not path.is_symlink():
                os.chmod(temp_path, path.stat().st_mode)
            os.replace(temp_path, path)
        except BaseException:
            temp_path.unlink(missing_ok=True)
            raise
        return

    root = board_root_from_entry(entry)
    if os.name == "nt":
        try:
            write_text_atomic_nofollow(root, path, text)
        except UnsafePathError as error:
            raise KanbanError(t(
                f"任务路径不得包含符号链接/重解析点且文档必须是普通文件: {error}",
                f"Task path must not contain a symlink/reparse point and the document must be a regular file: {error}",
            )) from error
        return
    parent_fd = open_dir_nofollow(root, path.parent)
    temp_name = f".{path.name}.{os.getpid()}.{time.time_ns()}.tmp"
    temp_fd = None
    try:
        mode = None
        try:
            existing = openat_nofollow(parent_fd, path.name, os.O_RDONLY)
        except OSError as error:
            if error.errno != getattr(os, "ENOENT", 2):
                raise KanbanError(t(f"无法打开任务文档: {path}: {error}", f"Cannot open task document: {path}: {error}")) from error
            existing = None
        # openat_nofollow 对软链抛 KanbanError, 必须原样失败, 不得当缺失文件.
        if existing is not None:
            try:
                info = os.fstat(existing)
                if not stat.S_ISREG(info.st_mode):
                    raise KanbanError(t(f"任务文档必须是普通文件: {path}", f"Task document must be a regular file: {path}"))
                mode = stat.S_IMODE(info.st_mode)
            finally:
                os.close(existing)

        temp_fd = openat_nofollow(
            parent_fd, temp_name, os.O_WRONLY | os.O_CREAT | os.O_EXCL
        )
        if mode is not None:
            os.fchmod(temp_fd, mode)
        with os.fdopen(temp_fd, "w", encoding="utf-8", newline="\n") as file:
            temp_fd = None
            file.write(text)
            file.flush()
            os.fsync(file.fileno())
        os.replace(temp_name, path.name, src_dir_fd=parent_fd, dst_dir_fd=parent_fd)
    except BaseException:
        if temp_fd is not None:
            os.close(temp_fd)
        try:
            os.unlink(temp_name, dir_fd=parent_fd)
        except OSError:
            pass
        raise
    finally:
        os.close(parent_fd)


def validate_ready(entry: Entry, text: str) -> None:
    missing = []
    for heading in READY_SECTIONS:
        body = section_body(text, heading)
        if not body or "<填写>" in body:
            missing.append(heading)
    if missing:
        raise KanbanError(t("任务未满足 todo 条件: ", "Task does not meet todo requirements: ") + ", ".join(missing))


def validate_target(entry: Entry, target_state: str, text: str) -> None:
    if target_state == "todo":
        validate_ready(entry, text)
    elif target_state == "review":
        if not metadata_from(text, "任务分支"):
            raise KanbanError(t("移入 review 前必须填写: 任务分支", "Before moving to review, set: 任务分支"))
    elif target_state == "done":
        if result_from(text) != "completed":
            raise KanbanError(t("移入 done 前必须填写: 结果: completed", "Before moving to done, set: 结果: completed"))
        if entry.kind == "small":
            summary = section_body(text, "完成总结")
            if not summary or "<填写>" in summary:
                raise KanbanError(t("小任务移入 done 前必须填写完成总结", "Complete the summary before moving a small task to done"))
        else:
            report = entry.path / "report.md"
            if os.name == "nt":
                try:
                    report_data = read_regular_file_nofollow(
                        board_root_from_entry(entry), report
                    )
                except UnsafePathError as error:
                    raise KanbanError(t(
                        f"大任务 report.md 不得是符号链接/重解析点且必须是普通文件: {error}",
                        f"Large-task report.md must not be a symlink/reparse point and must be a regular file: {error}",
                    )) from error
                except OSError as error:
                    error_code = getattr(error, "winerror", None)
                    if error_code is None:
                        error_code = getattr(error, "errno", None)
                    if isinstance(error, FileNotFoundError) or error_code in (2, 3):
                        raise KanbanError(t(
                            "大任务移入 done 前必须完成 report.md",
                            "Complete report.md before moving a large task to done",
                        )) from error
                    raise KanbanError(t(
                        f"无法读取大任务 report.md: {error}",
                        f"Cannot read large-task report.md: {error}",
                    )) from error
                try:
                    report_text = report_data.decode("utf-8")
                except UnicodeError as error:
                    raise KanbanError(t(
                        f"大任务 report.md 不是有效 UTF-8: {report}",
                        f"Large-task report.md is not valid UTF-8: {report}",
                    )) from error
                report_complete = bool(report_text.strip())
            else:
                report_complete = (
                    report.is_file()
                    and bool(report.read_text(encoding="utf-8").strip())
                )
            if not report_complete:
                raise KanbanError(t("大任务移入 done 前必须完成 report.md", "Complete report.md before moving a large task to done"))
    elif target_state == "archived":
        result = result_from(text)
        if result not in ARCHIVE_RESULTS:
            allowed = ", ".join(sorted(ARCHIVE_RESULTS))
            raise KanbanError(t(f"移入 archived 前必须填写有效结果: {allowed}", f"Before moving to archived, set a valid result: {allowed}"))
    elif target_state == "trash" and result_from(text) != "trashed":
        raise KanbanError(t("移入 trash 前必须填写: 结果: trashed", "Before moving to trash, set: 结果: trashed"))


def render_contract(title: str, task_type: str) -> str:
    created = datetime.now().strftime("%Y-%m-%d %H:%M")
    return f"""# {title}

- 类型: {TYPE_NAMES[task_type]}
- 任务组:
- 创建时间: {created}
- 负责人:
- 会话:
- 窗口:
- 开始时间:
- 完成时间:
- 任务分支:
- 结果:

## 任务目标

<填写>

## 用户决策

N/A

## 预期成果

<填写>

## 验收条件

- [ ] <填写>

## 威胁模型

N/A

## 不在本轮范围

- <填写>

## 讨论与决策

"""


def command_new(args: argparse.Namespace, root: Path) -> None:
    if not SLUG_RE.fullmatch(args.slug):
        raise KanbanError(t("slug 只能包含小写 ASCII 字母, 数字和连字符", "slug may contain only lowercase ASCII letters, digits, and hyphens"))
    title = " ".join(args.title).strip()
    if not title or "\n" in title or "\r" in title:
        raise KanbanError(t("标题不能为空或包含换行", "Title must not be empty or contain newlines"))
    board = load_board(root)
    task_id = f"{datetime.now().strftime('%Y%m%d')}-{args.slug}-task"
    if task_id in board.entries or task_id in board.blocked:
        raise KanbanError(t(f"任务已存在: {task_id}", f"Task already exists: {task_id}"))
    contract = render_contract(title, args.type)
    if os.name == "nt":
        try:
            if args.large:
                target = create_directory_with_text_file_nofollow(
                    root,
                    root / "backlog" / task_id,
                    "spec.md",
                    contract,
                )
            else:
                target = root / "backlog" / f"{task_id}.md"
                content = contract + """## 实施与验证

<填写>

## 完成总结

<填写>
"""
                write_text_atomic_nofollow(
                    root,
                    target,
                    content,
                    replace=False,
                )
        except FileExistsError as error:
            raise KanbanError(
                t(f"任务已存在: {task_id}", f"Task already exists: {task_id}")
            ) from error
        except UnsafePathError as error:
            raise KanbanError(t(
                f"任务路径不得包含符号链接/重解析点: {error}",
                f"Task path must not contain a symlink/reparse point: {error}",
            )) from error
        print(target)
        return
    if args.large:
        target = root / "backlog" / task_id
        target.mkdir()
        try:
            (target / "spec.md").write_text(contract, encoding="utf-8")
        except Exception:
            (target / "spec.md").unlink(missing_ok=True)
            target.rmdir()
            raise
    else:
        target = root / "backlog" / f"{task_id}.md"
        content = contract + """## 实施与验证

<填写>

## 完成总结

<填写>
"""
        with target.open("x", encoding="utf-8", newline="\n") as file:
            file.write(content)
    print(target)


def selected_entries(entries: Dict[str, Entry], state: Optional[str]) -> Iterable[Entry]:
    state_order = {name: index for index, name in enumerate(STATES)}
    return sorted(
        (entry for entry in entries.values() if state is None or entry.state == state),
        key=lambda entry: (state_order[entry.state], entry.task_id),
    )


def select_from_state(board: Board, state: str) -> Entry:
    candidates = list(selected_entries(board.entries, state))
    if not candidates:
        raise KanbanError(t(f"{state} 中没有任务", f"No tasks in {state}"))
    for index, entry in enumerate(candidates, 1):
        print(f"{index}. {entry.task_id}\t{title_from(read_document(entry))}")
    while True:
        try:
            choice = input(t("选择任务编号: ", "Choose a task number: ")).strip()
        except EOFError as error:
            raise KanbanError(t("未选择任务; 请指定 task-id", "No task selected; specify task-id")) from error
        if choice.isdecimal() and 1 <= int(choice) <= len(candidates):
            return candidates[int(choice) - 1]
        print(t(f"请输入 1-{len(candidates)}", f"Enter a number from 1 to {len(candidates)}"))


def select_todo(board: Board, task: Optional[str]) -> Entry:
    if task:
        entry = locate(board, task)
        if entry.state != "todo":
            raise KanbanError(t(
                f"只能启动 todo 任务: {entry.task_id} 当前位于 {entry.state}",
                f"Only todo tasks can be started: {entry.task_id} is currently in {entry.state}",
            ))
        return entry
    return select_from_state(board, "todo")


def command_list(args: argparse.Namespace, root: Path) -> None:
    board = load_board(root)
    rows = []
    for entry in selected_entries(board.entries, args.state):
        text = read_document(entry)
        name = "开始时间" if entry.state in {"working", "review"} else "完成时间"
        timestamp = metadata_from(text, name) if entry.state in {"working", "review", "done"} else ""
        if entry.state == "done" and not timestamp:
            timestamp = datetime.fromtimestamp(entry.document.stat().st_mtime).strftime(
                "%Y-%m-%d %H:%M"
            )
        rows.append(
            (entry.state, entry.kind, timestamp or "-", entry.task_id, title_from(text))
        )
    rows.sort(key=lambda row: (row[2], row[3]), reverse=True)
    rows.sort(key=lambda row: STATES.index(row[0]))
    english_headers = ("STATE", "SIZE", "TIME")
    headers = tuple(t(chinese, english) for chinese, english in zip(
        ("状态", "规模", "时间"), english_headers
    ))

    def display_width(text: str) -> int:
        return sum(
            0 if unicodedata.combining(char) else
            2 if unicodedata.east_asian_width(char) in "WF" else 1
            for char in text
        )

    widths = [
        max([display_width(header), len(english_headers[index]), *(len(row[index]) for row in rows)])
        for index, header in enumerate(headers)
    ]
    use_color = "NO_COLOR" not in os.environ and (
        sys.stdout.isatty() or os.environ.get("CLICOLOR_FORCE") == "1"
    )

    def color(text: str, code: str) -> str:
        return f"\033[{code}m{text}\033[0m" if use_color else text

    light_background = os.environ.get("COLORFGBG", "").rsplit(";", 1)[-1] in {"7", "15"}
    palette = (
        {
            "backlog": "30", "todo": "33", "working": "34", "review": "35", "done": "32",
            "archived": "35", "trash": "31", "small": "30", "large": "1;35",
            "task": "34", "title": "35",
        }
        if light_background
        else {
            "backlog": "90", "todo": "93", "working": "96", "review": "95", "done": "92",
            "archived": "94", "trash": "91", "small": "90", "large": "1;95",
            "task": "96", "title": "95",
        }
    )
    if args.mobile:
        for index, row in enumerate(rows):
            if index:
                print()
            print(
                f"{color(row[0], palette[row[0]])}  "
                f"{color(row[1], palette[row[1]])}  {row[2]}"
            )
            print(color(row[3], palette["task"]))
            print(color(row[4], palette["title"]))
        return

    heading = "  ".join(
        header + " " * (width - display_width(header))
        for header, width in zip(headers, widths)
    )
    print(color(heading + t("  任务 ID / 标题", "  TASK ID / TITLE"), "1"))
    print("  ".join("-" * width for width in widths) + "  ---------------")
    for row in rows:
        state = color(f"{row[0]:<{widths[0]}}", palette[row[0]])
        size = color(f"{row[1]:<{widths[1]}}", palette[row[1]])
        timestamp = f"{row[2]:<{widths[2]}}"
        print(
            f"{state}  {size}  {timestamp}  "
            f"{color(row[3], palette['task'])}  {color(row[4], palette['title'])}"
        )


def command_show(args: argparse.Namespace, root: Path) -> None:
    entry = locate(load_board(root), args.task)
    sys.stdout.write(read_document(entry))


def rename_entry_nofollow(root: Path, entry: Entry, target_state: str) -> Path:
    """用状态目录 fd 完成 rename, 拒绝状态目录软链导致的越界迁移."""
    if os.name == "nt":
        target = root / target_state / entry.path.name
        try:
            rename_nofollow(root, entry.path, target)
        except FileExistsError as error:
            raise KanbanError(t(f"目标已存在: {target}", f"Target already exists: {target}")) from error
        except UnsafePathError as error:
            raise KanbanError(t(
                f"任务路径不得包含符号链接/重解析点: {error}",
                f"Task path must not contain a symlink/reparse point: {error}",
            )) from error
        except OSError as error:
            raise KanbanError(t(f"迁移失败: {error}", f"Move failed: {error}")) from error
        if os.path.lexists(entry.path) or not target.exists() or is_reparse_point(target):
            raise KanbanError(t("迁移后状态校验失败, 请保留现场", "Post-move state verification failed; preserve the current state"))
        return target
    ensure_no_symlinks_under_board(root, entry.path)
    source_state_fd = open_dir_nofollow(root, root / entry.state)
    try:
        target_state_fd = open_dir_nofollow(root, root / target_state)
        try:
            name = entry.path.name
            try:
                os.lstat(name, dir_fd=target_state_fd)
            except FileNotFoundError:
                pass
            else:
                raise KanbanError(t(f"目标已存在: {root / target_state / name}", f"Target already exists: {root / target_state / name}"))
            try:
                os.rename(
                    name,
                    name,
                    src_dir_fd=source_state_fd,
                    dst_dir_fd=target_state_fd,
                )
            except OSError as error:
                raise KanbanError(t(f"迁移失败: {error}", f"Move failed: {error}")) from error
        finally:
            os.close(target_state_fd)
    finally:
        os.close(source_state_fd)
    target = root / target_state / entry.path.name
    if entry.path.exists() or not target.exists() or is_reparse_point(target):
        raise KanbanError(t("迁移后状态校验失败, 请保留现场", "Post-move state verification failed; preserve the current state"))
    return target


def move_entry(entry: Entry, root: Path, target_state: str) -> Entry:
    if target_state not in TRANSITIONS[entry.state]:
        raise KanbanError(t(f"不允许迁移: {entry.state} -> {target_state}", f"Move not allowed: {entry.state} -> {target_state}"))
    text = read_document(entry)
    validate_target(entry, target_state, text)
    updated = completion_metadata(text) if target_state == "done" else text
    target = rename_entry_nofollow(root, entry, target_state)
    document = target if entry.kind == "small" else target / "spec.md"
    moved = Entry(entry.task_id, target_state, target, document, entry.kind)
    if updated != text:
        try:
            write_text_atomic(document, updated, entry=moved)
        except (OSError, UnicodeError, KanbanError) as error:
            try:
                rename_entry_nofollow(root, moved, entry.state)
            except (OSError, UnicodeError, KanbanError) as rollback_error:
                raise KanbanError(t(
                    f"记录完成时间失败且回滚失败; 卡片保留在 done: {error}; {rollback_error}",
                    f"Failed to record completion time and rollback; task remains in done: {error}; {rollback_error}",
                )) from error
            raise KanbanError(t(f"记录完成时间失败: {error}", f"Failed to record completion time: {error}")) from error
    return moved


def command_move(args: argparse.Namespace, root: Path) -> None:
    entry = locate(load_board(root), args.task)
    print(move_entry(entry, root, args.state).path)


def command_pick(args: argparse.Namespace, root: Path) -> None:
    board = load_board(root)
    entry = locate(board, args.task) if args.task else select_from_state(board, "backlog")
    print(move_entry(entry, root, "todo").path)


def start_metadata(text: str, agent: str, session: "AgentSession", window: str) -> str:
    for name, value in (
        ("负责人", agent),
        ("开始时间", datetime.now().strftime("%Y-%m-%d %H:%M")),
    ):
        pattern = rf"(?m)^- {name}:\s*$"
        if len(re.findall(pattern, text)) != 1:
            raise KanbanError(t(f"任务文档缺少唯一元数据字段: {name}", f"Task document must contain exactly one metadata field: {name}"))
        text = re.sub(pattern, f"- {name}: {value}", text, count=1)
    # 会话字段是后加的: 旧模板没有该行时插在负责人之后, 不要求用户改写旧卡.
    session_lines = re.findall(rf"(?m)^- {SESSION_FIELD}:.*$", text)
    if len(session_lines) > 1:
        raise KanbanError(t(f"任务文档缺少唯一元数据字段: {SESSION_FIELD}", f"Task document must contain exactly one metadata field: {SESSION_FIELD}"))
    rendered = f"- {SESSION_FIELD}: {session.render()}"
    if session_lines:
        text = re.sub(rf"(?m)^- {SESSION_FIELD}:.*$", lambda _match: rendered, text, count=1)
    else:
        text = re.sub(r"(?m)^(- 负责人: .*)$", lambda match: f"{match.group(1)}\n{rendered}", text, count=1)
    # 窗口字段与会话字段一起后加. 已有字段也归一到会话之后, 让读取方有稳定布局.
    window_lines = re.findall(rf"(?m)^- {WINDOW_FIELD}:.*$", text)
    if len(window_lines) > 1:
        raise KanbanError(t(f"任务文档缺少唯一元数据字段: {WINDOW_FIELD}", f"Task document must contain exactly one metadata field: {WINDOW_FIELD}"))
    if window_lines:
        text = re.sub(rf"(?m)^- {WINDOW_FIELD}:.*\n?", "", text, count=1)
    rendered_window = f"- {WINDOW_FIELD}: {window}".rstrip()
    return re.sub(
        rf"(?m)^(- {SESSION_FIELD}:.*)$",
        lambda match: f"{match.group(1)}\n{rendered_window}",
        text,
        count=1,
    )


def window_metadata(text: str, value: str) -> str:
    lines = re.findall(rf"(?m)^- {WINDOW_FIELD}:.*$", text)
    if len(lines) > 1:
        raise KanbanError(t(f"任务文档缺少唯一元数据字段: {WINDOW_FIELD}", f"Task document must contain exactly one metadata field: {WINDOW_FIELD}"))
    if not lines:
        session_lines = re.findall(rf"(?m)^- {SESSION_FIELD}:.*$", text)
        if len(session_lines) != 1:
            raise KanbanError(t(f"任务文档缺少唯一元数据字段: {SESSION_FIELD}", f"Task document must contain exactly one metadata field: {SESSION_FIELD}"))
        return re.sub(
            rf"(?m)^(- {SESSION_FIELD}:.*)$",
            lambda match: f"{match.group(1)}\n- {WINDOW_FIELD}: {value}",
            text,
            count=1,
        )
    return re.sub(
        rf"(?m)^- {WINDOW_FIELD}:.*$",
        lambda _match: f"- {WINDOW_FIELD}: {value}",
        text,
        count=1,
    )


TMUX_SESSION_HINT = "tmux new -A -s onevoke"


def tmux_session_id(tmux: str) -> str:
    pane = os.environ.get("TMUX_PANE")
    if not os.environ.get("TMUX") or not pane:
        raise KanbanError(t(
            f"当前不在 tmux session. 先运行: {TMUX_SESSION_HINT}",
            f"Not currently in a tmux session. Run: {TMUX_SESSION_HINT}",
        ))
    result = subprocess.run(
        [tmux, "display-message", "-p", "-t", pane, "#{session_id}"],
        text=True,
        capture_output=True,
        check=False,
    )
    session = result.stdout.strip()
    if result.returncode != 0 or not re.fullmatch(r"\$\d+", session):
        detail = result.stderr.strip() or t("无法确定当前 session", "cannot determine the current session")
        raise KanbanError(t(f"读取 tmux session 失败: {detail}", f"Failed to read tmux session: {detail}"))
    return session


PROJECT_SESSION_OPTION = "@onevoke_project"
PROJECT_SESSION_CANDIDATES = 9


def tmux_capture(tmux: str, *arguments: str) -> subprocess.CompletedProcess:
    return subprocess.run([tmux, *arguments], text=True, capture_output=True, check=False)


def project_session_name(project: Path) -> str:
    """项目专属 session 名 kb-<目录名>-<路径摘要>; 摘要让同名目录的不同项目不会共用 session."""
    label = re.sub(r"[\s.:]+", "-", "".join(c for c in project.name if c.isprintable()).strip()).strip("-")
    digest = hashlib.sha256(str(project).encode("utf-8")).hexdigest()[:8]
    return f"kb-{label[:30]}-{digest}" if label else f"kb-{digest}"


def session_owner(tmux: str, session: str) -> Optional[str]:
    """session 记录的项目路径; session 不存在返回 None, 存在但没有标记返回空串."""
    # has-session 的 = 前缀强制精确匹配, 没有它 tmux 会前缀匹配到别的 session;
    # show-options 不接受该前缀, 但同名精确匹配优先于前缀匹配, 用原名即可.
    if tmux_capture(tmux, "has-session", "-t", f"={session}").returncode != 0:
        return None
    result = tmux_capture(tmux, "show-options", "-v", "-t", session, PROJECT_SESSION_OPTION)
    return result.stdout.strip() if result.returncode == 0 else ""


def resolve_project_session(tmux: str, project: Path) -> tuple[str, bool]:
    """选出该项目可用的 session 名并返回它是否已存在.

    没有项目标记的同名 session 视为可复用 (兼容标记写入失败或用户手工创建);
    只有明确属于其他项目时才退避到带序号的候选名.
    """
    base = project_session_name(project)
    for index in range(1, PROJECT_SESSION_CANDIDATES + 1):
        candidate = base if index == 1 else f"{base}-{index}"
        owner = session_owner(tmux, candidate)
        if owner is None:
            return candidate, False
        if owner in ("", str(project)):
            return candidate, True
    raise KanbanError(t(
        f"没有可用的项目 session 名: {base} 及其序号候选都属于其他项目",
        f"No project session name is available: {base} and its numbered candidates belong to other projects",
    ))


def tmux_launch(
    tmux: str, session: str, create: bool, cwd: str, name: str
) -> subprocess.CompletedProcess:
    """只创建任务 window; Agent 要等投递地址持久化后再进入 pane."""
    return tmux_capture(
        tmux,
        "new-session" if create else "new-window",
        "-d",
        "-P",
        "-F",
        "#{window_id}\t#{pane_id}",
        *(["-s", session] if create else ["-t", session + ":"]),
        "-c",
        cwd,
        "-n",
        name,
    )


def tmux_start_pane(tmux: str, pane: str, command: str) -> None:
    """用已持久化地址的 pane 替换占位 shell, 避免 Agent 先于卡片元数据运行."""
    result = tmux_capture(tmux, "respawn-pane", "-k", "-t", pane, command)
    if result.returncode != 0:
        detail = result.stderr.strip() or f"exit {result.returncode}"
        raise KanbanError(t(f"tmux 启动 Agent 失败: {detail}", f"tmux failed to start Agent: {detail}"))


def tmux_close_window(tmux: str, window: Optional[str]) -> Optional[str]:
    if not window:
        return None
    result = tmux_capture(tmux, "kill-window", "-t", window)
    if result.returncode == 0:
        return None
    detail = result.stderr.strip() or f"exit {result.returncode}"
    return t(f"关闭 tmux window 失败: {detail}", f"failed to close tmux window: {detail}")


def window_name(entry: Entry, text: str) -> str:
    title = title_from(text)
    label = re.sub(r"\s+", "-", "".join(c for c in title if c.isprintable()).strip()).strip("-")
    if not label or title == NO_TITLE:
        label = entry.task_id[9:].removesuffix("-task")
    return f"kb-{label}"[:50]


def herdr_capture(herdr: str, *arguments: str) -> subprocess.CompletedProcess:
    try:
        return subprocess.run([herdr, *arguments], text=True, capture_output=True, check=False)
    except ValueError as error:
        raise KanbanError(t(f"herdr 调用失败: {error}", f"herdr invocation failed: {error}")) from error


def herdr_failure_detail(result: subprocess.CompletedProcess) -> str:
    return result.stderr.strip() or f"exit {result.returncode}"


def herdr_json_result(result: subprocess.CompletedProcess, action: str) -> dict:
    if result.returncode != 0:
        raise KanbanError(t(f"herdr {action} 失败: {herdr_failure_detail(result)}", f"herdr {action} failed: {herdr_failure_detail(result)}"))
    try:
        payload = json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise KanbanError(t(f"herdr {action} 失败: 响应不是 JSON: {error}", f"herdr {action} failed: response is not JSON: {error}")) from error
    if not isinstance(payload, dict):
        raise KanbanError(t(f"herdr {action} 失败: 响应不是 JSON object", f"herdr {action} failed: response is not a JSON object"))
    data = payload.get("result")
    if not isinstance(data, dict):
        raise KanbanError(t(f"herdr {action} 失败: 响应缺少 result", f"herdr {action} failed: response is missing result"))
    return data


def herdr_public_id(value: object) -> Optional[str]:
    if not isinstance(value, str) or not value or "\x00" in value:
        return None
    return value


def herdr_close_tab(herdr: str, tab_id: str) -> Optional[str]:
    try:
        result = herdr_capture(herdr, "tab", "close", tab_id)
    except (OSError, UnicodeError, ValueError, KanbanError) as error:
        return t(
            f"关闭 tab {tab_id} 失败: {error}",
            f"failed to close tab {tab_id}: {error}",
        )
    if result.returncode == 0:
        return None
    return t(
        f"关闭 tab {tab_id} 失败: {herdr_failure_detail(result)}",
        f"failed to close tab {tab_id}: {herdr_failure_detail(result)}",
    )


def herdr_create_tab(herdr: str, workspace: str, cwd: str, label: str) -> tuple[str, str]:
    result = herdr_capture(
        herdr,
        "tab",
        "create",
        "--workspace",
        workspace,
        "--cwd",
        cwd,
        "--label",
        label,
        "--no-focus",
    )
    data = herdr_json_result(result, "tab create")
    tab = data.get("tab")
    pane = data.get("root_pane")
    tab_id = herdr_public_id(tab.get("tab_id") if isinstance(tab, dict) else None)
    pane_id = herdr_public_id(pane.get("pane_id") if isinstance(pane, dict) else None)
    if tab_id is None or pane_id is None:
        if tab_id is not None:
            close_error = herdr_close_tab(herdr, tab_id)
            if close_error:
                raise KanbanError(t(
                    f"herdr tab create 失败: 响应缺少 tab 或 pane id; {close_error}",
                    f"herdr tab create failed: response is missing tab or pane id; {close_error}",
                ))
        raise KanbanError(t(
            "herdr tab create 失败: 响应缺少 tab 或 pane id",
            "herdr tab create failed: response is missing tab or pane id",
        ))
    return tab_id, pane_id


HERDR_PANE_READY_TIMEOUT_MS = 15000


def herdr_wait_pane_ready(herdr: str, pane_id: str) -> None:
    """等新 tab 的 shell 渲染出提示符再送命令.

    tab create 返回时 pane 里的 shell 往往还没接管终端, 此时 pane run 送入的
    文本只会被回显后丢弃, Agent 不会启动. 首帧输出即提示符, 以它为就绪信号.
    """
    result = herdr_capture(
        herdr,
        "pane",
        "wait-output",
        pane_id,
        "--regex",
        r"\S",
        "--source",
        "visible",
        "--timeout",
        str(HERDR_PANE_READY_TIMEOUT_MS),
    )
    if result.returncode != 0:
        raise KanbanError(t(
            f"herdr pane 未就绪: {herdr_failure_detail(result)}",
            f"herdr pane is not ready: {herdr_failure_detail(result)}",
        ))


def herdr_pane_run(herdr: str, pane_id: str, command: str) -> None:
    # herdr pane run 把 pane id 之后的参数用空格拼接后发给 shell; 不能插入字面量 --.
    result = herdr_capture(herdr, "pane", "run", pane_id, command)
    if result.returncode != 0:
        raise KanbanError(t(
            f"herdr pane run 失败: {herdr_failure_detail(result)}",
            f"herdr pane run failed: {herdr_failure_detail(result)}",
        ))


def resolve_start_launcher(launcher: str) -> str:
    """auto 只在启动当时解析, 不把结果写回配置."""
    if launcher != "auto":
        return launcher
    if os.environ.get("HERDR_ENV") == "1":
        return "herdr"
    if os.environ.get("TMUX"):
        return "tmux"
    raise KanbanError(t(
        "auto 无法解析: 当前既不在 herdr 也不在 tmux. 请改用 --launcher tmux, tmux-session, herdr 或 foreground",
        "auto cannot be resolved: not currently in herdr or tmux. Use --launcher tmux, tmux-session, herdr, or foreground",
    ))


SESSION_FIELD = "会话"
WINDOW_FIELD = "窗口"
SESSION_REFERENCE_RE = re.compile(r"^[A-Za-z0-9._:-]{1,128}$")
HERDR_WINDOW_RE = re.compile(r"^herdr:([^:\s]+:[^:\s]+):([^:\s]+:[^:\s]+)$")
TMUX_WINDOW_RE = re.compile(r"^(tmux|tmux-session):([^:\s]+):([^:\s]+):([^:\s]+)$")
NOTIFY_DEFAULT_TIMEOUT = 120.0
NOTIFY_POLL_INTERVAL = 0.1


@dataclass(frozen=True)
class AgentSession:
    """执行 Agent 的会话标识, 写进任务卡供 `resume` 带上下文唤醒.

    claude 与 grok 在启动时预分配 UUID; cursor 先用 create-chat 预建 chat;
    codex 无法在启动时指定会话 id, reference 留空, resume 时按任务 ID 在
    CODEX_HOME 的 rollout 记录里检索.
    """

    agent: str
    reference: str

    def render(self) -> str:
        return f"{self.agent} {self.reference}".strip()


def cursor_create_chat(binary: str) -> str:
    try:
        result = subprocess.run([binary, "create-chat"], text=True, capture_output=True, check=False)
    except OSError as error:
        raise KanbanError(t(f"cursor-agent create-chat 失败: {error}", f"cursor-agent create-chat failed: {error}")) from error
    lines = [line.strip() for line in result.stdout.splitlines() if line.strip()]
    chat_id = lines[-1] if lines else ""
    if result.returncode != 0 or not SESSION_REFERENCE_RE.fullmatch(chat_id):
        detail = result.stderr.strip() or result.stdout.strip() or f"exit {result.returncode}"
        raise KanbanError(t(
            f"cursor-agent create-chat 未返回可用的 chat id: {detail}",
            f"cursor-agent create-chat did not return a usable chat id: {detail}",
        ))
    return chat_id


def new_agent_session(agent: str, binary: str) -> AgentSession:
    if agent in ("claude", "grok"):
        return AgentSession(agent, str(uuid.uuid4()))
    if agent == "cursor":
        return AgentSession(agent, cursor_create_chat(binary))
    return AgentSession(agent, "")


def session_from(text: str) -> AgentSession:
    value = metadata_from(text, SESSION_FIELD)
    if not value:
        raise KanbanError(t(
            f"任务卡没有 `{SESSION_FIELD}` 记录, 无法带上下文唤醒; 只有经 kanban start 启动的卡可以 resume",
            f"Task has no `{SESSION_FIELD}` metadata; only tasks launched by kanban start can be resumed",
        ))
    parts = value.split()
    agent = parts[0]
    reference = parts[1] if len(parts) > 1 else ""
    if agent not in AGENT_NAMES or len(parts) > 2 or (reference and not SESSION_REFERENCE_RE.fullmatch(reference)):
        raise KanbanError(t(f"任务卡的会话记录无效: {value}", f"Task session metadata is invalid: {value}"))
    return AgentSession(agent, reference)


def codex_sessions_root() -> Path:
    codex_home = os.environ.get("CODEX_HOME", "").strip()
    return (Path(codex_home) if codex_home else Path.home() / ".codex") / "sessions"


def codex_prompt_prefixes(task_id: str) -> tuple[str, ...]:
    """start/resume 交给执行 Agent 的 prompt 开头; 主控会话里只是提到任务 ID 的消息不算."""
    return (f"执行 Kanban 任务 {task_id}.", f"继续 Kanban 任务 {task_id}.")


def codex_rollout_mentions_task(path: Path, task_id: str) -> Optional[str]:
    """读 rollout 头部: 返回 session id, 仅当某条用户消息是该任务的 start/resume prompt."""
    session_id = None
    mentioned = False
    prefixes = codex_prompt_prefixes(task_id)
    try:
        with path.open("r", encoding="utf-8", errors="replace") as stream:
            for index, line in enumerate(stream):
                if index >= 64:
                    break
                try:
                    record = json.loads(line)
                except ValueError:
                    continue
                if not isinstance(record, dict):
                    continue
                payload = record.get("payload")
                if not isinstance(payload, dict):
                    continue
                if record.get("type") == "session_meta" and isinstance(payload.get("id"), str):
                    session_id = payload["id"]
                elif record.get("type") == "response_item" and payload.get("role") == "user":
                    for item in payload.get("content") or []:
                        text = item.get("text") if isinstance(item, dict) else None
                        if isinstance(text, str) and text.startswith(prefixes):
                            mentioned = True
                elif record.get("type") == "event_msg" and payload.get("type") == "user_message":
                    if isinstance(payload.get("message"), str) and payload["message"].startswith(prefixes):
                        mentioned = True
                if session_id and mentioned:
                    return session_id
    except OSError:
        return None
    return None


def find_codex_session(task_id: str) -> str:
    root = codex_sessions_root()
    if not root.is_dir():
        raise KanbanError(t(
            f"找不到 Codex 会话目录: {root}; 无法带上下文唤醒",
            f"Codex sessions directory not found: {root}; cannot resume with context",
        ))
    candidates = sorted(root.rglob("rollout-*.jsonl"), key=lambda item: item.stat().st_mtime, reverse=True)
    for path in candidates:
        session_id = codex_rollout_mentions_task(path, task_id)
        if session_id and SESSION_REFERENCE_RE.fullmatch(session_id):
            return session_id
    raise KanbanError(t(
        f"在 {root} 中找不到以 {task_id} 启动的 Codex 执行会话",
        f"No Codex execution session started for {task_id} was found under {root}",
    ))


def agent_command(
    agent: str,
    binary: str,
    model_entry: Dict[str, str],
    kind: str,
    session: AgentSession,
    *,
    resume: bool = False,
) -> list[str]:
    """按 Onevoke 配置的模型档位拼 Agent 的 YOLO 启动参数. model 为空时用 CLI 默认模型.

    resume 时改为恢复既有会话: codex 走 `resume <id>`, claude/grok 走 `--resume`,
    cursor 始终通过预建 chat 的 `--resume` 进入.
    """
    if agent == "cursor":
        model = model_entry["large_model" if kind == "large" else "small_model"]
        model_args = ["--model", model] if model else []
        return [binary, *model_args, "--trust", "--force", "--resume", session.reference]
    model = model_entry["model"]
    effort = model_entry["large_effort" if kind == "large" else "small_effort"]
    model_args = ["--model", model] if model else []
    if agent == "codex":
        options = [
            *model_args,
            "--config",
            f'model_reasoning_effort="{effort}"',
            "--dangerously-bypass-approvals-and-sandbox",
        ]
        if resume:
            return [binary, "resume", *options, session.reference]
        return [binary, *options]
    session_args = ["--resume" if resume else "--session-id", session.reference]
    if agent == "claude":
        return [binary, *model_args, "--effort", effort, "--dangerously-skip-permissions", *session_args]
    if agent == "grok":
        return [binary, *model_args, "--effort", effort, "--permission-mode", "bypassPermissions", *session_args]
    raise KanbanError(t(f"不支持的 Agent: {agent}", f"Unsupported Agent: {agent}"))


def resolve_agent_binary(agent_name: str) -> str:
    executable_name = agent_executable_name(agent_name)
    agent = shutil.which(executable_name)
    if not agent:
        raise KanbanError(t(
            f"Agent 不在 PATH: {executable_name}",
            f"Agent is not in PATH: {executable_name}",
        ))
    if os.name == "nt" and Path(agent).suffix.lower() != ".exe":
        raise KanbanError(t(
            f"Windows Agent 必须是原生 .exe, 不会执行可能重解析参数的入口: {agent}",
            f"Windows Agent must be a native .exe; refusing an entry point that can reparse arguments: {agent}",
        ))
    return agent


@dataclass(frozen=True)
class LaunchPlan:
    """领取前完成的 launcher 前置检查结果; 检查失败不领取."""

    launcher: str
    project: Path
    tmux: Optional[str] = None
    session: Optional[str] = None
    session_exists: bool = False
    herdr_bin: Optional[str] = None
    herdr_workspace: Optional[str] = None


@dataclass(frozen=True)
class LaunchOutcome:
    process: Optional[subprocess.Popen] = None
    window: str = ""
    tab: Optional[str] = None
    pane: Optional[str] = None


@dataclass(frozen=True)
class ResumeLaunch:
    plan: LaunchPlan
    outcome: LaunchOutcome


class LaunchFailure(KanbanError):
    """启动失败; herdr 路径附带关闭本次新建 tab 的结果."""

    def __init__(self, error: BaseException, close_error: Optional[str]) -> None:
        super().__init__(str(error))
        self.error = error
        self.close_error = close_error


def prepare_launch(launcher: str, project: Path, command: str) -> LaunchPlan:
    if os.name == "nt" and launcher in ("auto", "tmux", "tmux-session", "herdr"):
        raise KanbanError(t(
            f"Windows 不支持 {launcher} 启动方式; 请使用 console 或 foreground",
            f"Windows does not support the {launcher} launcher; use console or foreground",
        ))
    launcher = resolve_start_launcher(launcher)
    tmux = None
    session = None
    session_exists = False
    herdr_bin = None
    herdr_workspace = None
    if launcher in ("tmux", "tmux-session"):
        tmux = shutil.which("tmux")
        if not tmux:
            raise KanbanError(t("tmux 不在 PATH; 运行 onevoke welcome 选择前台启动模式", "tmux is not in PATH; run onevoke welcome to select foreground mode"))
        if launcher == "tmux":
            session = tmux_session_id(tmux)
        else:
            # 项目专属 session 自己建, 因此不要求 start 本身跑在 tmux 里.
            session, session_exists = resolve_project_session(tmux, project)
    elif launcher == "herdr":
        if os.environ.get("HERDR_ENV") != "1":
            raise KanbanError(t(
                "当前不在 herdr. herdr 启动方式要求 HERDR_ENV=1",
                "Not currently in herdr. The herdr launcher requires HERDR_ENV=1",
            ))
        herdr_bin = shutil.which("herdr")
        if not herdr_bin:
            raise KanbanError(t(
                "herdr 不在 PATH; 运行 onevoke welcome 选择其他启动方式",
                "herdr is not in PATH; run onevoke welcome to select another launcher",
            ))
        herdr_workspace = os.environ.get("HERDR_WORKSPACE_ID", "").strip()
        if not herdr_workspace:
            raise KanbanError(t(
                "缺少 HERDR_WORKSPACE_ID; 无法在当前 workspace 新建 tab",
                "HERDR_WORKSPACE_ID is missing; cannot create a tab in the current workspace",
            ))
    elif launcher == "console":
        if os.name != "nt":
            raise KanbanError(t(
                "console 启动方式只支持 Windows",
                "The console launcher is available only on Windows",
            ))
    elif not (sys.stdin.isatty() and sys.stdout.isatty() and sys.stderr.isatty()):
        fallback = "console" if os.name == "nt" else "tmux"
        raise KanbanError(t(
            f"前台启动模式需要交互终端 (stdin/stdout/stderr 均为 tty). 在 CI、管道或无 TTY 环境请改用: kanban {command} --launcher {fallback} <task-id>",
            f"Foreground mode requires an interactive terminal (stdin/stdout/stderr must be TTYs). In CI, pipelines, or environments without a TTY, use: kanban {command} --launcher {fallback} <task-id>",
        ))
    return LaunchPlan(launcher, project, tmux, session, session_exists, herdr_bin, herdr_workspace)


def launch_agent(
    plan: LaunchPlan,
    root: Path,
    name: str,
    agent_argv: list[str],
    location_callback: Optional[Callable[[LaunchOutcome], None]] = None,
) -> LaunchOutcome:
    """按 plan 启动 Agent; 六种 launcher 的 cwd 都是项目根. 失败抛 LaunchFailure."""
    created_tab = None
    created_window = None
    try:
        if plan.launcher == "foreground":
            try:
                process = subprocess.Popen(agent_argv, cwd=root.parent)
            except OSError as error:
                raise KanbanError(t(f"启动 Agent 失败: {error}", f"Failed to start Agent: {error}")) from error
            return LaunchOutcome(process=process)
        if plan.launcher == "console":
            try:
                process = subprocess.Popen(
                    agent_argv,
                    cwd=root.parent,
                    creationflags=(
                        subprocess.CREATE_NEW_CONSOLE
                        | subprocess.CREATE_NEW_PROCESS_GROUP
                    ),
                    close_fds=True,
                )
            except OSError as error:
                raise KanbanError(t(f"启动 Agent 失败: {error}", f"Failed to start Agent: {error}")) from error
            return LaunchOutcome(process=process)
        command = shlex.join(agent_argv)
        if plan.launcher == "herdr":
            created_tab, pane_id = herdr_create_tab(
                plan.herdr_bin, plan.herdr_workspace, str(root.parent), name
            )
            herdr_wait_pane_ready(plan.herdr_bin, pane_id)
            outcome = LaunchOutcome(tab=created_tab, pane=pane_id)
            if location_callback is not None:
                location_callback(outcome)
            herdr_pane_run(plan.herdr_bin, pane_id, command)
            return outcome
        create = plan.launcher == "tmux-session" and not plan.session_exists
        result = tmux_launch(plan.tmux, plan.session, create, str(root.parent), name)
        if create and result.returncode != 0 and session_owner(plan.tmux, plan.session) in ("", str(plan.project)):
            # 与另一次 start 抢建同一个 session 时改为在已建好的 session 里开 window.
            create = False
            result = tmux_launch(plan.tmux, plan.session, create, str(root.parent), name)
        if result.returncode != 0:
            subcommand = "new-session" if create else "new-window"
            detail = result.stderr.strip() or f"exit {result.returncode}"
            raise KanbanError(t(f"tmux {subcommand} 失败: {detail}", f"tmux {subcommand} failed: {detail}"))
        location = result.stdout.strip().split("\t")
        if len(location) != 2 or not all(location):
            raise KanbanError(t(
                "tmux 启动失败: 未返回 window/pane id",
                "tmux launch failed: window/pane id was not returned",
            ))
        window, pane = location
        created_window = window
        if create:
            # 标记项目归属供后续复用校验; 写失败不影响本次启动, 未标记的 session 仍会被复用.
            tmux_capture(plan.tmux, "set-option", "-t", plan.session, PROJECT_SESSION_OPTION, str(plan.project))
        outcome = LaunchOutcome(window=window, pane=pane)
        if location_callback is not None:
            location_callback(outcome)
        tmux_start_pane(plan.tmux, pane, command)
        return outcome
    except (KanbanError, OSError, UnicodeError, ValueError) as error:
        if created_tab is not None:
            close_error = herdr_close_tab(plan.herdr_bin, created_tab)
        else:
            close_error = tmux_close_window(plan.tmux, created_window) if plan.tmux else None
        raise LaunchFailure(error, close_error) from error


def rollback_launch(
    root: Path,
    moved: Entry,
    original_state: str,
    failure: LaunchFailure,
    original_text: Optional[str] = None,
) -> None:
    """启动失败后先恢复文档再迁回原状态; 文档没恢复就不迁回, 避免把带负责人的卡送回 todo."""
    rollback_errors: list[str] = []
    restored = True
    if original_text is not None:
        try:
            write_text_atomic(moved.document, original_text, entry=moved)
        except (OSError, UnicodeError, KanbanError) as content_error:
            restored = False
            rollback_errors.append(t(f"恢复文档失败: {content_error}", f"failed to restore document: {content_error}"))
    if restored and moved.state != original_state:
        try:
            rename_entry_nofollow(root, moved, original_state)
        except (OSError, UnicodeError, KanbanError) as move_error:
            rollback_errors.append(t(
                f"迁回 {original_state} 失败: {move_error}",
                f"failed to move back to {original_state}: {move_error}",
            ))
    extras = [item for item in (failure.close_error, *rollback_errors) if item]
    if rollback_errors:
        # 任一回滚步骤失败时卡片都还在迁移后的目录里: 文档没恢复就没迁, 迁移失败则原地不动.
        raise KanbanError(
            t(
                f"启动失败且回滚失败; 卡片保留在 {moved.state}: {failure.error}; ",
                f"Start and rollback both failed; task remains in {moved.state}: {failure.error}; ",
            )
            + "; ".join(extras)
        ) from failure.error
    if failure.close_error:
        raise KanbanError(f"{failure.error}; {failure.close_error}") from failure.error
    raise failure.error


def report_launch(
    verb: str,
    entry: Entry,
    agent_name: str,
    plan: LaunchPlan,
    outcome: LaunchOutcome,
) -> None:
    """输出实际启动方式与所选 Agent; foreground 还要等 Agent 退出."""
    scale = t({"large": "大任务", "small": "小任务"}[entry.kind], entry.kind)
    head = t(
        f"{verb}: {entry.task_id}\t规模={scale}\tAgent={agent_name}",
        f"{verb}: {entry.task_id}\tscale={scale}\tagent={agent_name}",
    )
    if plan.launcher == "foreground":
        print(t(f"{head}\t启动方式=foreground", f"{head}\tlauncher=foreground"), flush=True)
        returncode = outcome.process.wait()
        if returncode != 0:
            raise KanbanError(t(
                f"Agent 已启动但以非零状态退出: {returncode}; 卡片保留在 working",
                f"Agent started but exited with status {returncode}; task remains in working",
            ))
        return
    if plan.launcher == "console":
        print(t(
            f"{head}\t启动方式=console\tPID={outcome.process.pid}",
            f"{head}\tlauncher=console\tPID={outcome.process.pid}",
        ))
        return
    if plan.launcher == "herdr":
        print(t(
            f"{head}\t启动方式=herdr\ttab={outcome.tab}\tpane={outcome.pane}",
            f"{head}\tlauncher=herdr\ttab={outcome.tab}\tpane={outcome.pane}",
        ))
        return
    if plan.launcher == "tmux-session":
        print(t(
            f"{head}\t会话={plan.session}\t窗口={outcome.window}",
            f"{head}\tsession={plan.session}\twindow={outcome.window}",
        ))
        hint = f"tmux switch-client -t {plan.session}" if os.environ.get("TMUX") else f"tmux attach -t {plan.session}"
        print(t(f"查看: {hint}", f"view: {hint}"))
        return
    print(t(
        f"{head}\t启动方式=tmux\t窗口={outcome.window}",
        f"{head}\tlauncher=tmux\twindow={outcome.window}",
    ))


def command_start(args: argparse.Namespace, root: Path) -> None:
    entry = select_todo(load_board(root), args.task)
    config = effective_config(load_config())
    agent_name = args.agent or kanban_agent_for(config, entry.kind)
    plan = prepare_launch(args.launcher or config["launcher"], root.parent.resolve(), "start")
    agent = resolve_agent_binary(agent_name)
    session = new_agent_session(agent_name, agent)

    original = read_document(entry)
    updated = start_metadata(
        original,
        agent_name,
        session,
        "" if plan.launcher in ("herdr", "tmux", "tmux-session") else plan.launcher,
    )
    prompt = start_agent_prompt(entry.task_id, current_install_paths(), task_group_from(original))
    moved = move_entry(entry, root, "working")
    name = window_name(entry, original)
    model_entry = config["models"]["kanban"][agent_name]
    agent_argv = [*agent_command(agent_name, agent, model_entry, entry.kind, session), prompt]

    def record_terminal_location(outcome: LaunchOutcome) -> None:
        if plan.launcher == "herdr":
            location = f"herdr:{outcome.tab}:{outcome.pane}"
        else:
            location = f"{plan.launcher}:{plan.session}:{outcome.window}:{outcome.pane}"
        write_text_atomic(
            moved.document,
            window_metadata(updated, location),
            entry=moved,
        )
    try:
        write_text_atomic(moved.document, updated, entry=moved)
        outcome = launch_agent(
            plan,
            root,
            name,
            agent_argv,
            record_terminal_location if plan.launcher in ("herdr", "tmux", "tmux-session") else None,
        )
    except LaunchFailure as failure:
        rollback_launch(root, moved, entry.state, failure, original)
        raise
    except (KanbanError, OSError, UnicodeError, ValueError) as error:
        rollback_launch(root, moved, entry.state, LaunchFailure(error, None), original)
        raise
    report_launch(t("已启动", "started"), moved, agent_name, plan, outcome)


RESUME_STATES = ("review", "working")


def resume_agent_prompt(task_id: str, message: str, paths: InstallPaths) -> str:
    """生成 resume 交给原执行 Agent 的说明: 先重读卡片, 再处理主控派回的事项."""
    if paths.mode == "project":
        if paths.project_root is None:
            raise KanbanError(t("项目安装路径缺少主 worktree", "project install paths are missing the main worktree"))
        kanban_cmd = str(paths.bin_dir / "kanban")
        agents_md = str(paths.project_root / "AGENTS.md")
    else:
        kanban_cmd = "kanban"
        agents_md = t("目标项目 AGENTS.md", "the target project's AGENTS.md")
    return (
        f"继续 Kanban 任务 {task_id}. 卡片已迁回 working. 先运行 {kanban_cmd} rules, 再运行 "
        f"{kanban_cmd} show {task_id} 重新核对卡片, 然后处理以下事项:\n\n{message}\n\n"
        f"遵守 {agents_md} 和看板规则; 处理完成后更新任务卡, 提交并 push, 再按规则迁移卡片状态."
    )


def read_task_message(args: argparse.Namespace, command: str) -> str:
    if bool(args.message) == bool(args.message_file):
        raise KanbanError(t(
            f"{command} 必须且只能提供 --message 或 --message-file 之一",
            f"{command} requires exactly one of --message or --message-file",
        ))
    if args.message:
        message = args.message
    else:
        path = Path(args.message_file)
        if is_reparse_point(path):
            raise KanbanError(t(f"消息文件不得是符号链接/重解析点: {path}", f"Message file must not be a symlink/reparse point: {path}"))
        try:
            message = path.read_text(encoding="utf-8")
        except OSError as error:
            raise KanbanError(t(f"读取消息文件失败: {error}", f"Failed to read message file: {error}")) from error
    message = message.strip()
    if not message:
        raise KanbanError(t(f"{command} 消息不得为空", f"{command} message must not be empty"))
    return message


def command_resume(args: argparse.Namespace, root: Path) -> None:
    entry = locate(load_board(root), args.task)
    if entry.state not in RESUME_STATES:
        raise KanbanError(t(
            f"只能唤醒 {' 或 '.join(RESUME_STATES)} 中的任务; {entry.task_id} 在 {entry.state}",
            f"Only tasks in {' or '.join(RESUME_STATES)} can be resumed; {entry.task_id} is in {entry.state}",
        ))
    validate_liveness_timeout(args.timeout, "resume")
    message = read_task_message(args, "resume")
    text = read_document(entry)
    session = session_from(text)
    config = effective_config(load_config())
    plan = prepare_launch(args.launcher or config["launcher"], root.parent.resolve(), "resume")
    agent = resolve_agent_binary(session.agent)
    if session.agent == "codex":
        session = AgentSession("codex", find_codex_session(entry.task_id))
    elif not session.reference:
        raise KanbanError(t(
            f"任务卡的 {session.agent} 会话缺少 id, 无法唤醒",
            f"Task session for {session.agent} has no id; cannot resume",
        ))
    prompt = resume_agent_prompt(entry.task_id, message, current_install_paths())
    model_entry = config["models"]["kanban"][session.agent]
    agent_argv = [*agent_command(session.agent, agent, model_entry, entry.kind, session, resume=True), prompt]
    moved = move_entry(entry, root, "working") if entry.state != "working" else entry
    try:
        outcome = launch_agent(plan, root, window_name(entry, text), agent_argv)
    except LaunchFailure as failure:
        rollback_launch(root, moved, entry.state, failure, text)
        raise
    try:
        validate_resumed_agent(plan, outcome, session, args.timeout)
    except (KanbanError, OSError, UnicodeError, ValueError) as liveness_error:
        detail = resumed_agent_failure_output(plan, outcome)
        if detail:
            liveness_error = KanbanError(t(
                f"{liveness_error}; Agent 输出:\n{detail}",
                f"{liveness_error}; Agent output:\n{detail}",
            ))
        cleanup_error = None
        try:
            cleanup_failed_resume(plan, outcome)
        except (KanbanError, OSError) as error:
            cleanup_error = str(error)
        rollback_launch(
            root,
            moved,
            entry.state,
            LaunchFailure(liveness_error, cleanup_error),
            text,
        )
        raise
    report_launch(t("已唤醒", "resumed"), moved, session.agent, plan, outcome)


def resolved_task_session(entry: Entry, text: str) -> AgentSession:
    session = session_from(text)
    if session.agent == "codex" and not session.reference:
        return AgentSession("codex", find_codex_session(entry.task_id))
    if not session.reference:
        raise KanbanError(t(
            f"任务卡的 {session.agent} 会话缺少 id",
            f"Task session for {session.agent} has no id",
        ))
    return session


def herdr_pane_info(herdr: str, pane_id: str) -> dict:
    result = herdr_capture(herdr, "pane", "get", pane_id)
    if result.returncode != 0:
        raise KanbanError(t(
            f"pane 不存在: {pane_id}: {herdr_failure_detail(result)}",
            f"pane does not exist: {pane_id}: {herdr_failure_detail(result)}",
        ))
    data = herdr_json_result(result, "pane get")
    pane = data.get("pane")
    if not isinstance(pane, dict) or herdr_public_id(pane.get("pane_id")) != pane_id:
        raise KanbanError(t(f"pane 不存在: {pane_id}", f"pane does not exist: {pane_id}"))
    return pane


def herdr_notify_target(herdr: str, pane_id: str, session: AgentSession) -> None:
    pane = herdr_pane_info(herdr, pane_id)
    actual_agent = pane.get("agent")
    if actual_agent != session.agent:
        raise KanbanError(t(
            f"Agent 不匹配: 卡片={session.agent}, pane={actual_agent or 'N/A'}",
            f"Agent mismatch: task={session.agent}, pane={actual_agent or 'N/A'}",
        ))
    status = pane.get("agent_status")
    if status not in ("idle", "done"):
        raise KanbanError(t(
            f"pane 状态不可投递: {pane_id}: {status or 'N/A'}",
            f"pane status does not accept delivery: {pane_id}: {status or 'N/A'}",
        ))
    agent_session = pane.get("agent_session")
    actual_session = agent_session.get("value") if isinstance(agent_session, dict) else None
    if actual_session != session.reference:
        raise KanbanError(t(
            f"会话不匹配: 卡片={session.reference}, pane={actual_session or 'N/A'}",
            f"Session mismatch: task={session.reference}, pane={actual_session or 'N/A'}",
        ))


def herdr_reverse_lookup(herdr: str, session: AgentSession) -> tuple[str, str]:
    result = herdr_capture(herdr, "pane", "list")
    if result.returncode != 0:
        raise KanbanError(t(
            f"herdr pane list 失败: {herdr_failure_detail(result)}",
            f"herdr pane list failed: {herdr_failure_detail(result)}",
        ))
    data = herdr_json_result(result, "pane list")
    panes = data.get("panes")
    if not isinstance(panes, list):
        raise KanbanError(t("herdr pane list 响应缺少 panes", "herdr pane list response has no panes"))
    matches: list[tuple[str, str]] = []
    for pane in panes:
        if not isinstance(pane, dict):
            continue
        agent_session = pane.get("agent_session")
        reference = agent_session.get("value") if isinstance(agent_session, dict) else None
        if pane.get("agent") != session.agent or reference != session.reference:
            continue
        tab_id = herdr_public_id(pane.get("tab_id"))
        pane_id = herdr_public_id(pane.get("pane_id"))
        if tab_id and pane_id:
            matches.append((tab_id, pane_id))
    if not matches:
        raise KanbanError(t(
            f"herdr 会话反查无匹配: {session.reference}",
            f"herdr session lookup found no match: {session.reference}",
        ))
    if len(matches) != 1:
        raise KanbanError(t(
            f"herdr 会话反查匹配不唯一: {session.reference}: {len(matches)} 个 pane",
            f"herdr session lookup is ambiguous: {session.reference}: {len(matches)} panes",
        ))
    return matches[0]


def herdr_explicit_target(herdr: str, pane_id: str) -> tuple[str, str]:
    pane = herdr_pane_info(herdr, pane_id)
    tab_id = herdr_public_id(pane.get("tab_id"))
    if not tab_id:
        raise KanbanError(t(
            f"pane 缺少可用 tab id: {pane_id}",
            f"pane has no usable tab id: {pane_id}",
        ))
    return tab_id, pane_id


def tmux_notify_target(tmux: str, pane_id: str, session: AgentSession) -> None:
    result = tmux_capture(
        tmux,
        "display-message",
        "-p",
        "-t",
        pane_id,
        "#{pane_current_command}\t#{pane_in_mode}\t#{pane_dead}",
    )
    if result.returncode != 0:
        raise KanbanError(t(
            f"tmux pane 不存在: {pane_id}: {result.stderr.strip() or f'exit {result.returncode}'}",
            f"tmux pane does not exist: {pane_id}: {result.stderr.strip() or f'exit {result.returncode}'}",
        ))
    fields = result.stdout.strip().split("\t")
    if len(fields) != 3:
        raise KanbanError(t("tmux pane 探查响应无效", "tmux pane probe returned an invalid response"))
    command, in_mode, dead = fields
    if dead != "0":
        raise KanbanError(t(f"tmux pane 已退出: {pane_id}", f"tmux pane is dead: {pane_id}"))
    if in_mode != "0":
        raise KanbanError(t(f"tmux pane 处于 copy-mode: {pane_id}", f"tmux pane is in copy mode: {pane_id}"))
    expected = Path(agent_executable_name(session.agent)).name
    if command != expected:
        raise KanbanError(t(
            f"tmux 前台进程不匹配: 期望={expected}, 实际={command or 'N/A'}",
            f"tmux foreground process mismatch: expected={expected}, actual={command or 'N/A'}",
        ))


def notification_temp_root() -> Path:
    """返回词法临时根; Windows 不允许 tempfile 写探测或 resolve 跟随 reparse point."""
    if os.name != "nt":
        return Path(tempfile.gettempdir()).resolve()
    kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
    kernel32.GetTempPathW.argtypes = [wintypes.DWORD, wintypes.LPWSTR]
    kernel32.GetTempPathW.restype = wintypes.DWORD
    capacity = 32768
    buffer = ctypes.create_unicode_buffer(capacity)
    length = kernel32.GetTempPathW(capacity, buffer)
    if length == 0 or length >= capacity:
        code = ctypes.get_last_error()
        detail = ctypes.FormatError(code) if code else "invalid temporary path"
        raise KanbanError(t(
            f"无法取得 Windows 临时目录: {detail}",
            f"Could not determine the Windows temporary directory: {detail}",
        ))
    return Path(os.path.abspath(buffer.value))


def write_notify_message(message: str) -> Path:
    temporary_root = notification_temp_root()
    for _attempt in range(128):
        directory = temporary_root / f"onevoke-notify-{uuid.uuid4().hex}"
        try:
            create_private_directory_nofollow(temporary_root, directory)
        except FileExistsError:
            continue
        path = directory / "message.txt"
        try:
            write_text_atomic_nofollow(directory, path, message + "\n", replace=False)
            return path
        except BaseException:
            try:
                directory.rmdir()
            except OSError as cleanup_error:
                raise KanbanError(t(
                    f"创建通知消息失败且临时目录清理失败: {cleanup_error}",
                    f"Failed to create notification message and clean up its temporary directory: {cleanup_error}",
                )) from cleanup_error
            raise
    raise KanbanError(t("无法分配通知消息目录", "Unable to allocate a notification message directory"))


def remove_notify_message(path: Path) -> None:
    path.unlink(missing_ok=True)
    path.parent.rmdir()


def notify_instruction(entry: Entry, message_path: Path, marker: str) -> str:
    return t(
        f"# onevoke-notify: 请读取 {message_path}, 先原样输出 {marker}, 再按看板规则处理任务 {entry.task_id}.",
        f"# onevoke-notify: read {message_path}, first output {marker} exactly, then handle task {entry.task_id} under the kanban rules.",
    )


def herdr_direct_notify(
    herdr: str, pane_id: str, instruction: str, marker: str, timeout: float
) -> tuple[bool, str]:
    # send-keys 只接受 Enter/C-c 等按键名; pane run 才会送字面文本并提交 Enter.
    herdr_pane_run(herdr, pane_id, instruction)
    print(t("已投递, 等待回执: 通道=herdr-direct", "delivered; waiting for acknowledgement: channel=herdr-direct"), flush=True)
    result = herdr_capture(
        herdr,
        "pane",
        "wait-output",
        pane_id,
        "--match",
        marker,
        "--source",
        "recent",
        "--timeout",
        str(max(1, int(timeout * 1000))),
    )
    if result.returncode != 0:
        return False, herdr_failure_detail(result)
    return True, ""


def tmux_direct_notify(
    tmux: str, pane_id: str, instruction: str, marker: str, timeout: float
) -> tuple[bool, str]:
    for arguments in (
        ("send-keys", "-t", pane_id, "-l", instruction),
        ("send-keys", "-t", pane_id, "Enter"),
    ):
        result = tmux_capture(tmux, *arguments)
        if result.returncode != 0:
            raise KanbanError(t(
                f"tmux 直投失败: {result.stderr.strip() or f'exit {result.returncode}'}",
                f"tmux direct notification failed: {result.stderr.strip() or f'exit {result.returncode}'}",
            ))
    print(t("已投递, 等待回执: 通道=tmux-direct", "delivered; waiting for acknowledgement: channel=tmux-direct"), flush=True)
    deadline = time.monotonic() + timeout
    while True:
        result = tmux_capture(tmux, "capture-pane", "-p", "-t", pane_id)
        if result.returncode != 0:
            return False, result.stderr.strip() or f"exit {result.returncode}"
        if marker in result.stdout:
            return True, ""
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return False, t(f"回执超时: {marker}", f"acknowledgement timed out: {marker}")
        time.sleep(min(NOTIFY_POLL_INTERVAL, remaining))


def notify_resume_prompt(task_id: str, message: str, paths: InstallPaths) -> str:
    prompt = resume_agent_prompt(task_id, message, paths)
    return prompt.replace(
        "卡片已迁回 working.",
        "notify 将在确认本会话存活后把卡片迁回 working.",
        1,
    )


def validate_liveness_timeout(timeout: float, command: str) -> None:
    if not math.isfinite(timeout) or timeout <= 60:
        raise KanbanError(t(
            f"{command} 超时必须是大于 60 的有限秒数",
            f"{command} timeout must be a finite number greater than 60",
        ))


def validate_resumed_agent(plan: LaunchPlan, outcome: LaunchOutcome, session: AgentSession, timeout: float) -> None:
    deadline = time.monotonic() + timeout
    while True:
        if plan.launcher in ("foreground", "console"):
            if outcome.process.poll() is not None:
                raise KanbanError(t(
                    f"恢复 Agent 在存活观察期内退出: exit {outcome.process.returncode}",
                    f"Resumed Agent exited during the liveness observation period: exit {outcome.process.returncode}",
                ))
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                return
            time.sleep(min(NOTIFY_POLL_INTERVAL, remaining))
            continue
        try:
            if plan.launcher == "herdr":
                pane = herdr_pane_info(plan.herdr_bin, outcome.pane)
                agent_session = pane.get("agent_session")
                reference = agent_session.get("value") if isinstance(agent_session, dict) else None
                if (
                    pane.get("agent") == session.agent
                    and reference == session.reference
                    and pane.get("agent_status") in ("idle", "working", "blocked")
                ):
                    return
            else:
                tmux_notify_target(plan.tmux, outcome.pane, session)
                return
        except (KanbanError, OSError, UnicodeError):
            pass
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise KanbanError(t("恢复 Agent 存活校验超时", "Resumed Agent liveness check timed out"))
        time.sleep(min(NOTIFY_POLL_INTERVAL, remaining))


RESUME_FAILURE_OUTPUT_LIMIT = 8192


def resumed_agent_failure_output(plan: LaunchPlan, outcome: LaunchOutcome) -> str:
    """存活校验失败时保留可寻址终端里的原始退出文本."""
    try:
        if plan.launcher == "herdr" and outcome.pane:
            result = herdr_capture(plan.herdr_bin, "pane", "read", outcome.pane)
        elif plan.launcher in ("tmux", "tmux-session") and outcome.pane:
            result = tmux_capture(plan.tmux, "capture-pane", "-p", "-t", outcome.pane)
        else:
            return ""
    except (KanbanError, OSError, UnicodeError, ValueError):
        return ""
    if result.returncode != 0:
        return ""
    output = result.stdout.rstrip()
    if len(output) > RESUME_FAILURE_OUTPUT_LIMIT:
        output = output[-RESUME_FAILURE_OUTPUT_LIMIT:]
    return output


def cleanup_failed_resume(plan: LaunchPlan, outcome: LaunchOutcome) -> None:
    cleanup_error = None
    if plan.launcher == "herdr" and outcome.tab:
        cleanup_error = herdr_close_tab(plan.herdr_bin, outcome.tab)
    elif plan.launcher in ("tmux", "tmux-session") and outcome.window:
        cleanup_error = tmux_close_window(plan.tmux, outcome.window)
    elif outcome.process is not None and outcome.process.poll() is None:
        try:
            outcome.process.terminate()
            outcome.process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            try:
                outcome.process.kill()
                outcome.process.wait(timeout=5)
            except (OSError, subprocess.TimeoutExpired) as error:
                cleanup_error = str(error)
        except OSError as error:
            cleanup_error = str(error)
    if cleanup_error:
        raise KanbanError(t(
            f"恢复失败后的清理失败, 新 Agent 可能仍存活: {cleanup_error}",
            f"Cleanup after failed resume failed; the new Agent may still be alive: {cleanup_error}",
        ))


def notify_via_resume(entry: Entry, text: str, message: str, root: Path, timeout: float) -> ResumeLaunch:
    session = resolved_task_session(entry, text)
    config = effective_config(load_config())
    plan = prepare_launch(config["launcher"], root.parent.resolve(), "notify")
    agent = resolve_agent_binary(session.agent)
    model_entry = config["models"]["kanban"][session.agent]
    prompt = notify_resume_prompt(entry.task_id, message, current_install_paths())
    agent_argv = [*agent_command(session.agent, agent, model_entry, entry.kind, session, resume=True), prompt]
    outcome = launch_agent(plan, root, window_name(entry, text), agent_argv)
    try:
        validate_resumed_agent(plan, outcome, session, timeout)
    except (KanbanError, OSError, UnicodeError, ValueError) as liveness_error:
        try:
            cleanup_failed_resume(plan, outcome)
        except (KanbanError, OSError) as cleanup_error:
            raise KanbanError(t(
                f"{liveness_error}; 清理={cleanup_error}",
                f"{liveness_error}; cleanup={cleanup_error}",
            )) from cleanup_error
        raise
    return ResumeLaunch(plan, outcome)


def command_notify(args: argparse.Namespace, root: Path) -> None:
    entry = locate(load_board(root), args.task)
    if entry.state not in RESUME_STATES:
        raise KanbanError(t(
            f"只能直投 {' 或 '.join(RESUME_STATES)} 中的任务; {entry.task_id} 在 {entry.state}",
            f"Only tasks in {' or '.join(RESUME_STATES)} can be notified; {entry.task_id} is in {entry.state}",
        ))
    validate_liveness_timeout(args.timeout, "notify")
    message = read_task_message(args, "notify")
    text = read_document(entry)
    window = metadata_from(text, WINDOW_FIELD)
    direct_error = t("任务卡没有 `窗口` 记录", "Task has no `窗口` metadata")
    direct_channel = ""
    acknowledgement = "N/A"
    acknowledgement_detail = ""
    message_path = None
    window_written = False
    resume_launch = None
    try:
        session = resolved_task_session(entry, text)
        herdr_match = HERDR_WINDOW_RE.fullmatch(window)
        tmux_match = TMUX_WINDOW_RE.fullmatch(window)
        target_window = ""
        direct_kind = ""
        pane_id = ""
        if args.pane:
            herdr = shutil.which("herdr")
            if not herdr:
                raise KanbanError(t("herdr 不在 PATH", "herdr is not in PATH"))
            tab_id, pane_id = herdr_explicit_target(herdr, args.pane)
            herdr_notify_target(herdr, pane_id, session)
            target_window = f"herdr:{tab_id}:{pane_id}"
            direct_kind = "herdr"
        elif herdr_match:
            _tab_id, pane_id = herdr_match.groups()
            herdr = shutil.which("herdr")
            if not herdr:
                raise KanbanError(t("herdr 不在 PATH", "herdr is not in PATH"))
            herdr_notify_target(herdr, pane_id, session)
            direct_kind = "herdr"
        elif tmux_match:
            _launcher, _tmux_session, _window_id, pane_id = tmux_match.groups()
            tmux = shutil.which("tmux")
            if not tmux:
                raise KanbanError(t("tmux 不在 PATH", "tmux is not in PATH"))
            tmux_notify_target(tmux, pane_id, session)
            direct_kind = "tmux"
        elif not window:
            herdr = shutil.which("herdr")
            if not herdr:
                raise KanbanError(t("herdr 不在 PATH, 无法反查 pane", "herdr is not in PATH; cannot look up a pane"))
            tab_id, pane_id = herdr_reverse_lookup(herdr, session)
            herdr_notify_target(herdr, pane_id, session)
            target_window = f"herdr:{tab_id}:{pane_id}"
            direct_kind = "herdr"
        else:
            raise KanbanError(t(f"无可用直投地址: {window or 'N/A'}", f"No direct notification address: {window or 'N/A'}"))
        if os.name == "nt":
            raise KanbanError(t("Windows 当前没有终端直投通道", "Windows currently has no terminal direct-delivery channel"))
        if target_window and target_window != window:
            write_text_atomic(entry.document, window_metadata(text, target_window), entry=entry)
            window_written = True
        marker = f"ONEVOKE-NOTIFY-ACK:{uuid.uuid4()}"
        message_path = write_notify_message(message)
        instruction = notify_instruction(entry, message_path, marker)
        if direct_kind == "herdr":
            confirmed, acknowledgement_detail = herdr_direct_notify(
                herdr, pane_id, instruction, marker, args.timeout
            )
            direct_channel = "herdr-direct"
        else:
            confirmed, acknowledgement_detail = tmux_direct_notify(
                tmux, pane_id, instruction, marker, args.timeout
            )
            direct_channel = "tmux-direct"
        acknowledgement = t("已确认", "confirmed") if confirmed else t("未确认", "unconfirmed")
    except (KanbanError, OSError, UnicodeError, ValueError) as error:
        direct_error = str(error)
        if window_written:
            try:
                write_text_atomic(entry.document, text, entry=entry)
            except (KanbanError, OSError, UnicodeError) as rollback_error:
                raise KanbanError(t(
                    f"notify 直投失败且窗口回滚失败: 直投={direct_error}; 回滚={rollback_error}",
                    f"notify direct delivery and window rollback failed: direct={direct_error}; rollback={rollback_error}",
                )) from rollback_error
        if message_path is not None:
            try:
                remove_notify_message(message_path)
            except OSError as cleanup_error:
                raise KanbanError(t(
                    f"notify 直投失败且消息清理失败: 直投={direct_error}; 清理={cleanup_error}",
                    f"notify direct delivery failed and message cleanup failed: direct={direct_error}; cleanup={cleanup_error}",
                )) from cleanup_error
        try:
            resume_launch = notify_via_resume(entry, text, message, root, args.timeout)
        except (KanbanError, OSError, UnicodeError, ValueError, LaunchFailure) as resume_error:
            raise KanbanError(t(
                f"notify 失败: 直投={direct_error}; 恢复={resume_error}",
                f"notify failed: direct={direct_error}; resume={resume_error}",
            )) from resume_error
        channel = "resume"
    else:
        channel = direct_channel
        if acknowledgement_detail:
            print(t(
                f"警告: 已投递, 未在超时内确认: {acknowledgement_detail}",
                f"warning: delivered but not confirmed within the timeout: {acknowledgement_detail}",
            ), file=sys.stderr)
    moved = move_entry(entry, root, "working") if entry.state != "working" else entry
    if channel == "resume":
        output_path = "N/A"
        channel_detail = t(f"\t直投原因={direct_error}", f"\tdirect-reason={direct_error}")
    else:
        output_path = str(message_path)
        channel_detail = ""
    print(t(
        f"已通知: {moved.task_id}\t通道={channel}\t回执={acknowledgement}\t消息文件={output_path}{channel_detail}",
        f"notified: {moved.task_id}\tchannel={channel}\tacknowledgement={acknowledgement}\tmessage-file={output_path}{channel_detail}",
    ), flush=True)
    if (
        channel == "resume"
        and isinstance(resume_launch, ResumeLaunch)
        and resume_launch.plan.launcher == "foreground"
    ):
        returncode = resume_launch.outcome.process.wait()
        if returncode != 0:
            raise KanbanError(t(
                f"恢复 Agent 已通过存活校验, 随后以非零状态退出: {returncode}; 卡片保留在 working",
                f"Resumed Agent passed liveness validation, then exited with status {returncode}; task remains in working",
            ))


WEB_STATUS_LABELS = {
    "cn": {
        "backlog": "待办池",
        "todo": "待处理",
        "working": "进行中",
        "review": "待审核",
        "done": "已完成",
        "archived": "已存档",
        "trash": "回收站",
    },
    "en": {
        "backlog": "Backlog",
        "todo": "Todo",
        "working": "Working",
        "review": "Review",
        "done": "Done",
        "archived": "Archived",
        "trash": "Trash",
    },
}
WEB_SIZE_LABELS = {
    "cn": {"small": "小任务", "large": "大任务"},
    "en": {"small": "small", "large": "large"},
}


def task_display_time(entry: Entry, text: str) -> str:
    if entry.state in ("working", "review"):
        return metadata_from(text, "开始时间") or "-"
    if entry.state == "done":
        timestamp = metadata_from(text, "完成时间")
        if timestamp:
            return timestamp
        return datetime.fromtimestamp(entry.document.stat().st_mtime).strftime("%Y-%m-%d %H:%M")
    return metadata_from(text, "创建时间") or "-"


def web_task_summary(entry: Entry, text: Optional[str] = None) -> dict:
    document = text if text is not None else read_document(entry)
    return {
        "task_id": entry.task_id,
        "title": title_from(document),
        "state": entry.state,
        "kind": entry.kind,
        "type": metadata_from(document, "类型") or "-",
        "task_group": task_group_from(document),
        "assignee": metadata_from(document, "负责人"),
        "created_at": metadata_from(document, "创建时间"),
        "started_at": metadata_from(document, "开始时间"),
        "completed_at": metadata_from(document, "完成时间"),
        "time": task_display_time(entry, document),
        "result": result_from(document),
    }


def web_board_payload(root: Path) -> dict:
    board = load_board(root)
    tasks = []
    for entry in board.entries.values():
        tasks.append(web_task_summary(entry))
    tasks.sort(key=lambda row: (row["time"], row["task_id"]), reverse=True)
    tasks.sort(key=lambda row: STATES.index(row["state"]) if row["state"] in STATES else len(STATES))
    return {
        "generated_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        "root": str(root),
        "tasks": tasks,
    }


def web_task_payload(root: Path, task_id: str) -> dict:
    entry = locate(load_board(root), task_id)
    text = read_document(entry)
    payload = web_task_summary(entry, text)
    payload["document"] = text
    return payload


def web_page_context() -> dict:
    lang = "cn" if t("任务看板", "Task Board") == "任务看板" else "en"
    return {
        "lang": lang,
        "title": t("任务看板", "Task Board"),
        "description": t(
            "只读查看本机文件看板; 任务变化通过 SSE 推送.",
            "Read-only view of the local file kanban; task changes are pushed over SSE.",
        ),
        "keyword_placeholder": t(
            "搜索标题, 任务 ID 或任务组",
            "Search title, task ID, or task group",
        ),
        "show_archived": t("显示已存档", "Show archived"),
        "show_active": t("显示活跃", "Show active"),
        "load_failed_title": t("加载任务失败", "Failed to load tasks"),
        "load_failed_description": t("看板数据加载失败.", "Board data failed to load."),
        "retry": t("重试", "Retry"),
        "close": t("关闭", "Close"),
        "show_archived_json": json.dumps(t("显示已存档", "Show archived"), ensure_ascii=False),
        "show_active_json": json.dumps(t("显示活跃", "Show active"), ensure_ascii=False),
        "empty_json": json.dumps(t("暂无任务", "No tasks"), ensure_ascii=False),
        "card_count_json": json.dumps(t("{count} 个任务", "{count} tasks"), ensure_ascii=False),
        "unassigned_json": json.dumps(t("未指派", "Unassigned"), ensure_ascii=False),
        "status_labels_json": json.dumps(WEB_STATUS_LABELS[lang], ensure_ascii=False),
        "size_labels_json": json.dumps(WEB_SIZE_LABELS[lang], ensure_ascii=False),
        "updated_json": json.dumps(t("更新于", "Updated"), ensure_ascii=False),
        "error_json": json.dumps(t("加载失败", "Load failed"), ensure_ascii=False),
        "not_found": t("未找到", "not found"),
    }


def command_web(args: argparse.Namespace, root: Path) -> None:
    scan_interval = args.refresh
    if scan_interval < 1:
        raise KanbanError(t("扫描间隔必须 >= 1 秒", "scan interval must be >= 1 second"))
    share = Path(args.assets).expanduser() if args.assets else None
    try:
        share_dir = kanban_web.resolve_share_dir(share)
    except kanban_web.KanbanWebError as error:
        raise KanbanError(str(error)) from error

    def get_board() -> dict:
        try:
            return web_board_payload(root)
        except (KanbanError, OSError, UnicodeError) as error:
            raise kanban_web.KanbanWebError(str(error)) from error

    def get_task(task_id: str) -> dict:
        try:
            return web_task_payload(root, task_id)
        except (KanbanError, OSError, UnicodeError) as error:
            raise kanban_web.KanbanWebError(str(error)) from error

    print(
        t(
            f"看板目录: {root}",
            f"board directory: {root}",
        ),
        flush=True,
    )
    try:
        kanban_web.serve(
            host=args.host,
            port=args.port,
            share_dir=share_dir,
            page_context=web_page_context(),
            get_board=get_board,
            get_task=get_task,
            scan_interval=scan_interval,
            open_browser=args.open,
        )
    except kanban_web.KanbanWebError as error:
        raise KanbanError(str(error)) from error


