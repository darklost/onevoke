#!/usr/bin/env python3

import argparse
import os
import re
import shlex
import shutil
import stat
import subprocess
import sys
import tempfile
from dataclasses import dataclass
from datetime import datetime
from pathlib import Path
from typing import Dict, Iterable, Optional

from onevoke_config import ConfigError, effective_config, load_config


STATES = ("backlog", "todo", "working", "done", "archived", "trash")
TRANSITIONS = {
    "backlog": {"todo", "archived", "trash"},
    "todo": {"working", "archived", "trash"},
    "working": {"done", "archived", "trash"},
    "done": {"archived", "trash"},
    "archived": {"trash"},
    "trash": set(),
}
TASK_ID_RE = re.compile(r"^\d{8}-[a-z0-9]+(?:-[a-z0-9]+)*-task$")
SLUG_RE = re.compile(r"^[a-z0-9]+(?:-[a-z0-9]+)*$")
TYPE_NAMES = {
    "feature": "Feature",
    "bug": "Bug",
    "chore": "Chore",
    "research": "Research",
}
READY_SECTIONS = ("任务目标", "预期成果", "验收条件", "不在本轮范围")
ARCHIVE_RESULTS = {"completed", "cancelled", "duplicate", "wontfix"}
AGENT_NAMES = ("codex", "claude", "grok")
NO_TITLE = "(无标题)"


class KanbanError(Exception):
    pass


@dataclass(frozen=True)
class Entry:
    task_id: str
    state: str
    path: Path
    document: Path
    kind: str


@dataclass(frozen=True)
class Board:
    """一次扫描的结果.

    无效入口不再让整个看板不可读: 它们进入 problems 由 `check` 汇报, 而与某个
    任务 ID 绑定的违规 (重复 ID, 大任务缺 spec.md) 另外记入 blocked, 只让操作
    该任务的命令失败. 未受影响的任务照常可读可迁移.
    """

    entries: Dict[str, Entry]
    blocked: Dict[str, str]
    problems: list["Problem"]


@dataclass(frozen=True)
class Problem:
    path: Path
    message: str


def git_main_worktree(directory: Path) -> Optional[Path]:
    try:
        git = subprocess.run(
            ["git", "-C", str(directory), "worktree", "list", "--porcelain"],
            text=True,
            capture_output=True,
            check=False,
        )
    except OSError:
        return None
    if git.returncode != 0:
        return None
    for line in git.stdout.splitlines():
        if line.startswith("worktree "):
            return Path(line.removeprefix("worktree ")).resolve()
    return None


def board_root() -> Path:
    configured = os.environ.get("KANBAN_DIR")
    if configured:
        return Path(configured).expanduser().resolve()
    main_worktree = git_main_worktree(Path.cwd())
    if main_worktree:
        candidate = main_worktree / "kanban"
        if candidate.is_dir():
            return candidate.resolve()
    current = Path.cwd().resolve()
    for parent in (current, *current.parents):
        candidate = parent / "kanban"
        if candidate.is_dir():
            return candidate.resolve()
    raise KanbanError("找不到看板目录; 请在项目内运行或设置 KANBAN_DIR")


def global_rules_path() -> Path:
    return Path.home() / ".agents" / "KANBAN-RULES.md"


def command_rules() -> None:
    rules = global_rules_path()
    if not rules.is_file():
        raise KanbanError(f"全局规则不存在: {rules}")
    sys.stdout.write(rules.read_text(encoding="utf-8"))


def add_git_exclude(root: Path) -> Optional[Path]:
    try:
        git_root_result = subprocess.run(
            ["git", "-C", str(root.parent), "rev-parse", "--show-toplevel"],
            text=True,
            capture_output=True,
            check=False,
        )
    except OSError:
        return None
    if git_root_result.returncode != 0:
        return None
    git_root = Path(git_root_result.stdout.strip()).resolve()
    try:
        relative = root.resolve().relative_to(git_root)
    except ValueError:
        return None
    exclude_result = subprocess.run(
        ["git", "-C", str(git_root), "rev-parse", "--git-path", "info/exclude"],
        text=True,
        capture_output=True,
        check=False,
    )
    if exclude_result.returncode != 0:
        raise KanbanError("无法定位 Git info/exclude")
    exclude = Path(exclude_result.stdout.strip())
    if not exclude.is_absolute():
        exclude = git_root / exclude
    pattern = f"/{relative.as_posix().strip('/')}/"
    existing = exclude.read_text(encoding="utf-8") if exclude.exists() else ""
    if pattern not in existing.splitlines():
        exclude.parent.mkdir(parents=True, exist_ok=True)
        with exclude.open("a", encoding="utf-8", newline="\n") as file:
            if existing and not existing.endswith("\n"):
                file.write("\n")
            file.write(pattern + "\n")
    return exclude.resolve()


def command_init(args: argparse.Namespace) -> None:
    configured = os.environ.get("KANBAN_DIR")
    if args.project and configured:
        raise KanbanError("不能同时指定 project-path 和 KANBAN_DIR")
    if args.project:
        project = Path(args.project).expanduser().resolve()
        if not project.is_dir():
            raise KanbanError(f"项目目录不存在: {project}")
        root = project / "kanban"
    elif configured:
        root = Path(configured).expanduser().resolve()
    else:
        project = git_main_worktree(Path.cwd()) or Path.cwd().resolve()
        root = project / "kanban"
    if root.exists() and not root.is_dir():
        raise KanbanError(f"看板路径不是目录: {root}")
    root.mkdir(parents=True, exist_ok=True)
    for state in STATES:
        path = root / state
        if path.exists() and not path.is_dir():
            raise KanbanError(f"状态路径不是目录: {path}")
        path.mkdir(exist_ok=True)
    exclude = add_git_exclude(root)
    print(f"initialized: {root}")
    if exclude:
        print(f"git exclude: {exclude}")
    print(f"rules: {global_rules_path()}")


def ensure_layout(root: Path) -> None:
    if not root.is_dir():
        raise KanbanError(f"看板目录不存在: {root}")
    for state in STATES:
        path = root / state
        if not path.is_dir():
            raise KanbanError(f"状态目录不存在: {path}")


def scan(root: Path) -> Board:
    ensure_layout(root)
    entries: Dict[str, Entry] = {}
    blocked: Dict[str, str] = {}
    problems: list[Problem] = []

    def reject(path: Path, message: str, task_id: Optional[str] = None) -> None:
        problems.append(Problem(path, message))
        if task_id:
            blocked[task_id] = message
            entries.pop(task_id, None)

    for state in STATES:
        for path in sorted((root / state).iterdir(), key=lambda item: item.name):
            if path.name.startswith("."):
                continue
            if path.is_symlink():
                reject(path, f"任务入口不得是符号链接: {path}")
                continue
            if path.is_file() and path.name.endswith("-task.md"):
                task_id, document, kind = path.name[:-3], path, "small"
            elif path.is_dir() and path.name.endswith("-task"):
                task_id, document, kind = path.name, path / "spec.md", "large"
            else:
                reject(path, f"无效任务入口: {path}")
                continue
            if not TASK_ID_RE.fullmatch(task_id):
                reject(path, f"无效任务 ID: {task_id}")
                continue
            if kind == "large":
                if document.is_symlink():
                    reject(
                        path,
                        f"大任务 spec.md 不得是符号链接: {document}",
                        task_id,
                    )
                    continue
                if not document.is_file():
                    reject(path, f"大任务缺少 spec.md: {path}", task_id)
                    continue
            if task_id in blocked:
                problems.append(Problem(path, f"任务 ID 存在冲突: {task_id}"))
                continue
            if task_id in entries:
                reject(path, f"重复任务 ID: {entries[task_id].path} 与 {path}", task_id)
                continue
            entries[task_id] = Entry(task_id, state, path, document, kind)
    return Board(entries, blocked, problems)


def load_board(root: Path) -> Board:
    board = scan(root)
    if board.problems:
        print(
            f"kanban: 警告: {len(board.problems)} 个无效入口已忽略, 运行 kanban check 查看",
            file=sys.stderr,
        )
    return board


def normalize_task_id(value: str) -> str:
    if "/" in value or "\\" in value:
        raise KanbanError("任务参数只能使用任务 ID 或入口名")
    task_id = value[:-3] if value.endswith(".md") else value
    if not TASK_ID_RE.fullmatch(task_id):
        raise KanbanError(f"无效任务 ID: {value}")
    return task_id


def locate(board: Board, value: str) -> Entry:
    task_id = normalize_task_id(value)
    if task_id in board.blocked:
        raise KanbanError(board.blocked[task_id])
    try:
        return board.entries[task_id]
    except KeyError as error:
        raise KanbanError(f"任务不存在: {task_id}") from error


def board_root_from_entry(entry: Entry) -> Path:
    # 入口恒为 <board>/<state>/<name>, 文档在入口内或即入口本身.
    return entry.path.parent.parent


def ensure_no_symlinks_under_board(root: Path, path: Path) -> None:
    """从看板根走到 path 的每一级分量都不得是软链, 防止中间目录被掉包."""
    root = root.resolve(strict=False)
    candidate = path if path.is_absolute() else root / path
    try:
        common = os.path.commonpath([str(root), str(candidate)])
    except ValueError as error:
        raise KanbanError(f"任务路径越出看板: {path}") from error
    if common != str(root):
        raise KanbanError(f"任务路径越出看板: {path}")
    relative = os.path.relpath(str(candidate), str(root))
    current = root
    if current.is_symlink():
        raise KanbanError(f"路径分量不得是符号链接: {current}")
    if relative in ("", "."):
        return
    for part in Path(relative).parts:
        current = current / part
        if current.is_symlink():
            raise KanbanError(f"路径分量不得是符号链接: {current}")


def open_task_document(entry: Entry, *, write: bool = False) -> int:
    """打开任务文档且不跟随软链, 防止 scan 后被替换为看板外目标."""
    root = board_root_from_entry(entry)
    ensure_no_symlinks_under_board(root, entry.path)
    ensure_no_symlinks_under_board(root, entry.document)
    path = entry.document
    flags = os.O_RDWR if write else os.O_RDONLY
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        fd = os.open(path, flags)
    except OSError as error:
        # Linux 对软链返回 ELOOP
        if getattr(error, "errno", None) in {getattr(os, "ELOOP", 40), 40}:
            raise KanbanError(f"任务文档不得是符号链接: {path}") from error
        raise KanbanError(f"无法打开任务文档: {path}: {error}") from error
    info = os.fstat(fd)
    if not stat.S_ISREG(info.st_mode):
        os.close(fd)
        raise KanbanError(f"任务文档必须是普通文件: {path}")
    return fd


def read_document(entry: Entry) -> str:
    try:
        fd = open_task_document(entry, write=False)
        try:
            chunks: list[bytes] = []
            while True:
                piece = os.read(fd, 1 << 20)
                if not piece:
                    break
                chunks.append(piece)
            return b"".join(chunks).decode("utf-8")
        finally:
            os.close(fd)
    except UnicodeError as error:
        raise KanbanError(f"任务文档不是有效 UTF-8: {entry.document}") from error


def title_from(text: str) -> str:
    for line in text.splitlines():
        if line.startswith("# "):
            return line[2:].strip()
    return NO_TITLE


def section_body(text: str, heading: str) -> Optional[str]:
    match = re.search(rf"(?m)^## {re.escape(heading)}\s*$", text)
    if not match:
        return None
    next_heading = re.search(r"(?m)^## ", text[match.end() :])
    end = match.end() + next_heading.start() if next_heading else len(text)
    return text[match.end() : end].strip()


def result_from(text: str) -> str:
    match = re.search(r"(?m)^- 结果:\s*(.*?)\s*$", text)
    return match.group(1) if match else ""


def metadata_from(text: str, name: str) -> str:
    match = re.search(rf"(?m)^- {re.escape(name)}:[ \t]*(.*?)[ \t]*$", text)
    return match.group(1) if match else ""


def completion_metadata(text: str) -> str:
    value = datetime.now().strftime("%Y-%m-%d %H:%M")
    matches = list(re.finditer(r"(?m)^- 完成时间:.*$", text))
    if len(matches) == 1:
        return re.sub(r"(?m)^- 完成时间:.*$", f"- 完成时间: {value}", text, count=1)
    if matches:
        raise KanbanError("任务文档缺少唯一元数据字段: 完成时间")
    started = list(re.finditer(r"(?m)^- 开始时间:.*$", text))
    if len(started) != 1:
        raise KanbanError("任务文档缺少唯一元数据字段: 开始时间")
    return re.sub(
        r"(?m)^(- 开始时间:.*)$", rf"\1\n- 完成时间: {value}", text, count=1
    )


def write_text_atomic(path: Path, text: str, *, entry: Optional[Entry] = None) -> None:
    if entry is not None:
        ensure_no_symlinks_under_board(board_root_from_entry(entry), entry.path)
        ensure_no_symlinks_under_board(board_root_from_entry(entry), path)
    elif path.is_symlink():
        raise KanbanError(f"任务文档不得是符号链接: {path}")
    if path.exists() and path.is_symlink():
        raise KanbanError(f"任务文档不得是符号链接: {path}")
    handle, temp_name = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    temp_path = Path(temp_name)
    try:
        with os.fdopen(handle, "w", encoding="utf-8", newline="\n") as file:
            file.write(text)
        if path.exists() and not path.is_symlink():
            os.chmod(temp_path, path.stat().st_mode)
        if path.parent.is_symlink():
            raise KanbanError(f"路径分量不得是符号链接: {path.parent}")
        os.replace(temp_path, path)
        if path.is_symlink():
            raise KanbanError(f"写入后任务文档变成符号链接: {path}")
    except BaseException:
        temp_path.unlink(missing_ok=True)
        raise


def validate_ready(entry: Entry, text: str) -> None:
    missing = []
    for heading in READY_SECTIONS:
        body = section_body(text, heading)
        if not body or "<填写>" in body:
            missing.append(heading)
    if missing:
        raise KanbanError("任务未满足 todo 条件: " + ", ".join(missing))


def validate_target(entry: Entry, target_state: str, text: str) -> None:
    if target_state == "todo":
        validate_ready(entry, text)
    elif target_state == "done":
        if result_from(text) != "completed":
            raise KanbanError("移入 done 前必须填写: 结果: completed")
        if entry.kind == "small":
            summary = section_body(text, "完成总结")
            if not summary or "<填写>" in summary:
                raise KanbanError("小任务移入 done 前必须填写完成总结")
        else:
            report = entry.path / "report.md"
            if not report.is_file() or not report.read_text(encoding="utf-8").strip():
                raise KanbanError("大任务移入 done 前必须完成 report.md")
    elif target_state == "archived":
        result = result_from(text)
        if result not in ARCHIVE_RESULTS:
            allowed = ", ".join(sorted(ARCHIVE_RESULTS))
            raise KanbanError(f"移入 archived 前必须填写有效结果: {allowed}")
    elif target_state == "trash" and result_from(text) != "trashed":
        raise KanbanError("移入 trash 前必须填写: 结果: trashed")


def render_contract(title: str, task_type: str) -> str:
    created = datetime.now().strftime("%Y-%m-%d %H:%M")
    return f"""# {title}

- 类型: {TYPE_NAMES[task_type]}
- 创建时间: {created}
- 负责人:
- 开始时间:
- 完成时间:
- 任务分支:
- 结果:

## 任务目标

<填写>

## 用户决策

N/A

## 预期成果

<填写>

## 验收条件

- [ ] <填写>

## 威胁模型

N/A

## 不在本轮范围

- <填写>

## 讨论与决策

"""


def command_new(args: argparse.Namespace, root: Path) -> None:
    if not SLUG_RE.fullmatch(args.slug):
        raise KanbanError("slug 只能包含小写 ASCII 字母, 数字和连字符")
    title = " ".join(args.title).strip()
    if not title or "\n" in title or "\r" in title:
        raise KanbanError("标题不能为空或包含换行")
    board = load_board(root)
    task_id = f"{datetime.now().strftime('%Y%m%d')}-{args.slug}-task"
    if task_id in board.entries or task_id in board.blocked:
        raise KanbanError(f"任务已存在: {task_id}")
    contract = render_contract(title, args.type)
    if args.large:
        target = root / "backlog" / task_id
        target.mkdir()
        try:
            (target / "spec.md").write_text(contract, encoding="utf-8")
        except Exception:
            (target / "spec.md").unlink(missing_ok=True)
            target.rmdir()
            raise
    else:
        target = root / "backlog" / f"{task_id}.md"
        content = contract + """## 实施与验证

<填写>

## 完成总结

<填写>
"""
        with target.open("x", encoding="utf-8", newline="\n") as file:
            file.write(content)
    print(target)


def selected_entries(entries: Dict[str, Entry], state: Optional[str]) -> Iterable[Entry]:
    state_order = {name: index for index, name in enumerate(STATES)}
    return sorted(
        (entry for entry in entries.values() if state is None or entry.state == state),
        key=lambda entry: (state_order[entry.state], entry.task_id),
    )


def select_from_state(board: Board, state: str) -> Entry:
    candidates = list(selected_entries(board.entries, state))
    if not candidates:
        raise KanbanError(f"{state} 中没有任务")
    for index, entry in enumerate(candidates, 1):
        print(f"{index}. {entry.task_id}\t{title_from(read_document(entry))}")
    while True:
        try:
            choice = input("选择任务编号: ").strip()
        except EOFError as error:
            raise KanbanError("未选择任务; 请指定 task-id") from error
        if choice.isdecimal() and 1 <= int(choice) <= len(candidates):
            return candidates[int(choice) - 1]
        print(f"请输入 1-{len(candidates)}")


def select_todo(board: Board, task: Optional[str]) -> Entry:
    if task:
        entry = locate(board, task)
        if entry.state != "todo":
            raise KanbanError(f"只能启动 todo 任务: {entry.task_id} 当前位于 {entry.state}")
        return entry
    return select_from_state(board, "todo")


def command_list(args: argparse.Namespace, root: Path) -> None:
    board = load_board(root)
    rows = []
    for entry in selected_entries(board.entries, args.state):
        text = read_document(entry)
        name = "开始时间" if entry.state == "working" else "完成时间"
        timestamp = metadata_from(text, name) if entry.state in {"working", "done"} else ""
        if entry.state == "done" and not timestamp:
            timestamp = datetime.fromtimestamp(entry.document.stat().st_mtime).strftime(
                "%Y-%m-%d %H:%M"
            )
        rows.append(
            (entry.state, entry.kind, timestamp or "-", entry.task_id, title_from(text))
        )
    rows.sort(key=lambda row: (row[2], row[3]), reverse=True)
    rows.sort(key=lambda row: STATES.index(row[0]))
    headers = ("STATE", "SIZE", "TIME")
    widths = [
        max([len(header), *(len(row[index]) for row in rows)])
        for index, header in enumerate(headers)
    ]
    use_color = "NO_COLOR" not in os.environ and (
        sys.stdout.isatty() or os.environ.get("CLICOLOR_FORCE") == "1"
    )

    def color(text: str, code: str) -> str:
        return f"\033[{code}m{text}\033[0m" if use_color else text

    light_background = os.environ.get("COLORFGBG", "").rsplit(";", 1)[-1] in {"7", "15"}
    palette = (
        {
            "backlog": "30", "todo": "33", "working": "34", "done": "32",
            "archived": "35", "trash": "31", "small": "30", "large": "1;35",
            "task": "34", "title": "35",
        }
        if light_background
        else {
            "backlog": "90", "todo": "93", "working": "96", "done": "92",
            "archived": "94", "trash": "91", "small": "90", "large": "1;95",
            "task": "96", "title": "95",
        }
    )
    if args.mobile:
        for index, row in enumerate(rows):
            if index:
                print()
            print(
                f"{color(row[0], palette[row[0]])}  "
                f"{color(row[1], palette[row[1]])}  {row[2]}"
            )
            print(color(row[3], palette["task"]))
            print(color(row[4], palette["title"]))
        return

    heading = "  ".join(f"{header:<{width}}" for header, width in zip(headers, widths))
    print(color(heading + "  TASK ID / TITLE", "1"))
    print("  ".join("-" * width for width in widths) + "  ---------------")
    for row in rows:
        state = color(f"{row[0]:<{widths[0]}}", palette[row[0]])
        size = color(f"{row[1]:<{widths[1]}}", palette[row[1]])
        timestamp = f"{row[2]:<{widths[2]}}"
        print(
            f"{state}  {size}  {timestamp}  "
            f"{color(row[3], palette['task'])}  {color(row[4], palette['title'])}"
        )


def command_show(args: argparse.Namespace, root: Path) -> None:
    entry = locate(load_board(root), args.task)
    sys.stdout.write(read_document(entry))


def move_entry(entry: Entry, root: Path, target_state: str) -> Entry:
    if target_state not in TRANSITIONS[entry.state]:
        raise KanbanError(f"不允许迁移: {entry.state} -> {target_state}")
    text = read_document(entry)
    validate_target(entry, target_state, text)
    updated = completion_metadata(text) if target_state == "done" else text
    target = root / target_state / entry.path.name
    if target.exists() or target.is_symlink():
        raise KanbanError(f"目标已存在: {target}")
    try:
        entry.path.rename(target)
    except OSError as error:
        raise KanbanError(f"迁移失败: {error}") from error
    if entry.path.exists() or not target.exists():
        raise KanbanError("迁移后状态校验失败, 请保留现场")
    document = target if entry.kind == "small" else target / "spec.md"
    moved = Entry(entry.task_id, target_state, target, document, entry.kind)
    if updated != text:
        try:
            write_text_atomic(document, updated, entry=moved)
        except (OSError, UnicodeError, KanbanError) as error:
            try:
                target.rename(entry.path)
            except (OSError, UnicodeError) as rollback_error:
                raise KanbanError(
                    f"记录完成时间失败且回滚失败; 卡片保留在 done: {error}; {rollback_error}"
                ) from error
            raise KanbanError(f"记录完成时间失败: {error}") from error
    return moved


def command_move(args: argparse.Namespace, root: Path) -> None:
    entry = locate(load_board(root), args.task)
    print(move_entry(entry, root, args.state).path)


def command_pick(args: argparse.Namespace, root: Path) -> None:
    board = load_board(root)
    entry = locate(board, args.task) if args.task else select_from_state(board, "backlog")
    print(move_entry(entry, root, "todo").path)


def start_metadata(text: str, agent: str) -> str:
    for name, value in (
        ("负责人", agent),
        ("开始时间", datetime.now().strftime("%Y-%m-%d %H:%M")),
    ):
        pattern = rf"(?m)^- {name}:\s*$"
        if len(re.findall(pattern, text)) != 1:
            raise KanbanError(f"任务文档缺少唯一元数据字段: {name}")
        text = re.sub(pattern, f"- {name}: {value}", text, count=1)
    return text


TMUX_SESSION_HINT = "tmux new -A -s onevoke"


def tmux_session_id(tmux: str) -> str:
    pane = os.environ.get("TMUX_PANE")
    if not os.environ.get("TMUX") or not pane:
        raise KanbanError(
            f"当前不在 tmux session. 先运行: {TMUX_SESSION_HINT}"
        )
    result = subprocess.run(
        [tmux, "display-message", "-p", "-t", pane, "#{session_id}"],
        text=True,
        capture_output=True,
        check=False,
    )
    session = result.stdout.strip()
    if result.returncode != 0 or not re.fullmatch(r"\$\d+", session):
        detail = result.stderr.strip() or "无法确定当前 session"
        raise KanbanError(f"读取 tmux session 失败: {detail}")
    return session


def window_name(entry: Entry, text: str) -> str:
    title = title_from(text)
    label = re.sub(r"\s+", "-", "".join(c for c in title if c.isprintable()).strip()).strip("-")
    if not label or title == NO_TITLE:
        label = entry.task_id[9:].removesuffix("-task")
    return f"kb-{label}"[:50]


def agent_command(agent: str, binary: str, effort: str) -> list[str]:
    """拼 Agent 的 YOLO 启动参数. Grok 不锁模型也不吃推理强度, 跟随其 CLI 默认."""
    if agent == "codex":
        return [
            binary,
            "--model",
            "gpt-5.6-sol",
            "--config",
            f'model_reasoning_effort="{effort}"',
            "--dangerously-bypass-approvals-and-sandbox",
        ]
    if agent == "claude":
        return [binary, "--model", "opus", "--effort", effort, "--dangerously-skip-permissions"]
    if agent == "grok":
        return [binary, "--permission-mode", "bypassPermissions"]
    raise KanbanError(f"不支持的 Agent: {agent}")


def command_start(args: argparse.Namespace, root: Path) -> None:
    entry = select_todo(load_board(root), args.task)
    config = effective_config(load_config())
    agent_name = args.agent or config["kanban_agent"]
    launcher = args.launcher or config["launcher"]
    agent = shutil.which(agent_name)
    if not agent:
        raise KanbanError(f"Agent 不在 PATH: {agent_name}")
    tmux = None
    session = None
    if launcher == "tmux":
        tmux = shutil.which("tmux")
        if not tmux:
            raise KanbanError("tmux 不在 PATH; 运行 onevoke welcome 选择前台启动模式")
        session = tmux_session_id(tmux)
    elif not (sys.stdin.isatty() and sys.stdout.isatty() and sys.stderr.isatty()):
        raise KanbanError(
            "前台启动模式需要交互终端 (stdin/stdout/stderr 均为 tty). "
            "在 CI、管道或无 TTY 环境请改用: kanban start --launcher tmux <task-id>"
        )

    original = read_document(entry)
    updated = start_metadata(original, agent_name)
    moved = move_entry(entry, root, "working")
    prompt = (
        f"执行 Kanban 任务 {entry.task_id}. 先运行 kanban rules, 再运行 "
        f"kanban show {entry.task_id}. 卡片已进入 working. 遵守目标项目 AGENTS.md, "
        "补充任务分支, 并按项目规则完成任务、验证、审核、集成和看板收尾."
    )
    name = window_name(entry, original)
    effort = "high" if entry.kind == "large" else "medium"
    agent_argv = [*agent_command(agent_name, agent, effort), prompt]
    try:
        write_text_atomic(moved.document, updated, entry=moved)
        if launcher == "tmux":
            command = shlex.join(agent_argv)
            result = subprocess.run(
                [
                    tmux,
                    "new-window",
                    "-P",
                    "-F",
                    "#{window_id}",
                    "-t",
                    session + ":",
                    "-c",
                    str(root.parent),
                    "-n",
                    name,
                    command,
                ],
                text=True,
                capture_output=True,
                check=False,
            )
            if result.returncode != 0:
                detail = result.stderr.strip() or f"exit {result.returncode}"
                raise KanbanError(f"tmux new-window 失败: {detail}")
            window = result.stdout.strip() or "unknown"
        else:
            try:
                process = subprocess.Popen(agent_argv, cwd=root.parent)
            except OSError as error:
                raise KanbanError(f"启动 Agent 失败: {error}") from error
    except (KanbanError, OSError, UnicodeError) as error:
        try:
            write_text_atomic(moved.document, original, entry=moved)
            moved.path.rename(entry.path)
        except (OSError, UnicodeError) as rollback_error:
            raise KanbanError(
                f"启动失败且回滚失败; 卡片保留在 working: {error}; {rollback_error}"
            ) from error
        raise
    if launcher == "foreground":
        print(
            f"started: {entry.task_id}\tagent={agent_name}\tlauncher=foreground",
            flush=True,
        )
        returncode = process.wait()
        if returncode != 0:
            raise KanbanError(
                f"Agent 已启动但以非零状态退出: {returncode}; "
                "卡片保留在 working"
            )
        return
    print(f"started: {entry.task_id}\tagent={agent_name}\twindow={window}")


def command_check(root: Path) -> int:
    board = scan(root)
    for problem in board.problems:
        print(f"invalid: {problem.message}", file=sys.stderr)
    if board.problems:
        print(
            f"checked: {len(board.entries)} valid, {len(board.problems)} invalid"
        )
        return 1
    print(f"ok: {len(board.entries)} tasks")
    return 0


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(prog="kanban", description="本地文件看板")
    commands = result.add_subparsers(dest="command", required=True)

    init_parser = commands.add_parser("init", help="创建看板目录框架")
    init_parser.add_argument("project", nargs="?", help="项目根目录, 默认当前项目")

    commands.add_parser("rules", help="输出全局看板规则")

    list_parser = commands.add_parser("list", aliases=["ls"], help="列出任务")
    list_parser.add_argument("state", nargs="?", choices=STATES)
    list_parser.add_argument("--mobile", action="store_true", help="使用竖屏手机布局")

    show_parser = commands.add_parser("show", help="输出入口任务文档")
    show_parser.add_argument("task")

    new_parser = commands.add_parser("new", help="在 backlog 创建任务")
    new_parser.add_argument("--large", action="store_true", help="创建大任务目录")
    new_parser.add_argument("type", choices=tuple(TYPE_NAMES))
    new_parser.add_argument("slug")
    new_parser.add_argument("title", nargs="+")

    move_parser = commands.add_parser("move", help="迁移任务状态")
    move_parser.add_argument("task")
    move_parser.add_argument("state", choices=STATES)

    pick_parser = commands.add_parser("pick", help="将 backlog 任务移入 todo")
    pick_parser.add_argument("task", nargs="?")

    start_parser = commands.add_parser("start", help="领取任务并按 Onevoke 配置启动 Agent")
    start_parser.add_argument("task", nargs="?")
    start_parser.add_argument("--agent", choices=AGENT_NAMES, help="覆盖配置中的默认 Agent")
    start_parser.add_argument(
        "--launcher", choices=("tmux", "foreground"), help="覆盖配置中的启动方式"
    )

    commands.add_parser("check", help="检查看板不变量")
    return result


def main() -> int:
    args = parser().parse_args()
    try:
        if args.command == "init":
            command_init(args)
            return 0
        if args.command == "rules":
            command_rules()
            return 0
        root = board_root()
        if args.command in ("list", "ls"):
            command_list(args, root)
        elif args.command == "show":
            command_show(args, root)
        elif args.command == "new":
            command_new(args, root)
        elif args.command == "move":
            command_move(args, root)
        elif args.command == "pick":
            command_pick(args, root)
        elif args.command == "start":
            command_start(args, root)
        elif args.command == "check":
            return command_check(root)
        return 0
    except (KanbanError, ConfigError, OSError, UnicodeError) as error:
        print(f"kanban: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
