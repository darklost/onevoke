def command_tui(args: argparse.Namespace, root: Path) -> None:
    if args.refresh < 1:
        raise KanbanError(t("刷新间隔必须 >= 1 秒", "refresh interval must be >= 1 second"))
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        raise KanbanError(t(
            "TUI 需要交互终端 (stdin/stdout 均为 tty)",
            "TUI requires an interactive terminal (stdin/stdout must both be TTYs)",
        ))
    try:
        import kanban_tui
    except ImportError as error:
        raise KanbanError(t(
            f"当前 Python 无法加载 curses: {error}",
            f"This Python cannot load curses: {error}",
        )) from error

    try:
        kanban_tui.run(
            single=args.single,
            refresh_interval=args.refresh,
            context=tui_page_context(),
            get_board=lambda: web_board_payload(root),
            get_task=lambda task_id: web_task_payload(root, task_id),
            theme=args.theme,
            column_width=kanban_tui.load_column_width(),
            persist_column_width=kanban_tui.save_column_width,
        )
    except kanban_tui.KanbanTuiError as error:
        raise KanbanError(str(error)) from error


def command_check(args: argparse.Namespace, root: Path) -> int:
    board = scan_targets(root, args.tasks) if args.tasks else scan(root)
    all_problems = list(board.problems)
    dependency_board = scan(root) if args.tasks else board
    selected = set(board.entries) if args.tasks else None
    all_problems.extend(dependency_problems(dependency_board, selected))
    for problem in all_problems:
        print(t(f"无效: {problem.message}", f"invalid: {problem.message}"), file=sys.stderr)
    if all_problems:
        print(
            t(
                f"已检查: {len(board.entries)} 个有效, {len(all_problems)} 个无效",
                f"checked: {len(board.entries)} valid, {len(all_problems)} invalid",
            )
        )
        return 1
    print(t(f"通过: {len(board.entries)} 个任务", f"ok: {len(board.entries)} tasks"))
    return 0


def group_state_snapshot(root: Path, task_ids: list[str]) -> tuple[Board, dict[str, str]]:
    board = scan_targets(root, task_ids)
    if board.problems:
        raise KanbanError(board.problems[0].message)
    return board, {task_id: board.entries[task_id].state for task_id in task_ids}


def emit_group_event(payload: dict) -> None:
    print(
        json.dumps(payload, ensure_ascii=False, sort_keys=True, separators=(",", ":")),
        flush=True,
    )


def watched_task_ids(root: Path, values: list[str], member_ids: list[str]) -> list[str]:
    """把外部任务或任务组引用解析为不重复的当前任务 ID."""
    if not values:
        return []
    direct_ids = [
        normalize_task_id(value)
        for value in values
        if not TASK_GROUP_RE.fullmatch(value)
    ]
    direct_board = scan_targets(root, dict.fromkeys(direct_ids))
    if direct_board.problems:
        raise KanbanError(direct_board.problems[0].message)
    group_values = [value for value in values if TASK_GROUP_RE.fullmatch(value)]
    group_members: Dict[str, tuple[str, ...]] = {}
    if group_values:
        board = scan(root)
        documents: Dict[str, str] = {}
        for task_id, entry in board.entries.items():
            try:
                documents[task_id] = read_document(entry)
            except KanbanError:
                continue
        group_members = task_group_members(documents)
    member_set = set(member_ids)
    watched: list[str] = []
    watched_set: set[str] = set()
    for value in values:
        if TASK_GROUP_RE.fullmatch(value):
            expanded = group_members.get(value)
            if not expanded:
                raise KanbanError(t(
                    f"外部监控任务组没有成员: {value}",
                    f"Watched task group has no members: {value}",
                ))
        else:
            expanded = (normalize_task_id(value),)
        for task_id in expanded:
            if task_id in member_set:
                raise KanbanError(t(
                    f"外部监控目标与成员任务重复: {task_id}",
                    f"Watched target duplicates a member task: {task_id}",
                ))
            if task_id in watched_set:
                raise KanbanError(t(
                    f"外部监控任务 ID 不得重复: {task_id}",
                    f"Watched task IDs must not be repeated: {task_id}",
                ))
            watched.append(task_id)
            watched_set.add(task_id)
    return watched


def subscription_event(
    event: str,
    group_id: str,
    tasks: dict[str, str],
    watched: list[str],
    changed: Optional[list[dict[str, str]]] = None,
) -> dict:
    payload = {"event": event, "group_id": group_id, "tasks": tasks}
    if changed is not None:
        payload["changed"] = changed
    if watched:
        payload["watched"] = watched
    return payload


def command_subscribe(args: argparse.Namespace, root: Path) -> None:
    if not TASK_GROUP_RE.fullmatch(args.group):
        raise KanbanError(t(
            f"无效任务组 ID: {args.group}",
            f"Invalid task group ID: {args.group}",
        ))
    if not math.isfinite(args.refresh) or args.refresh <= 0:
        raise KanbanError(t("扫描间隔必须大于 0", "Refresh interval must be greater than 0"))
    if not math.isfinite(args.heartbeat) or args.heartbeat <= 0:
        raise KanbanError(t("心跳间隔必须大于 0", "Heartbeat interval must be greater than 0"))

    task_ids = [normalize_task_id(value) for value in args.tasks]
    if len(task_ids) != len(set(task_ids)):
        raise KanbanError(t("成员任务 ID 不得重复", "Member task IDs must not be repeated"))
    watched = watched_task_ids(root, args.watch, task_ids)
    monitored_ids = task_ids + watched
    board, snapshot = group_state_snapshot(root, monitored_ids)
    for task_id in task_ids:
        actual_group = task_group_from(read_document(board.entries[task_id]))
        if actual_group != args.group:
            raise KanbanError(t(
                f"任务不属于指定任务组: {task_id} (实际: {actual_group or 'N/A'})",
                f"Task does not belong to the specified group: {task_id} (actual: {actual_group or 'N/A'})",
            ))

    emit_group_event(subscription_event("snapshot", args.group, snapshot, watched))
    last_event = time.monotonic()
    try:
        while True:
            heartbeat_remaining = args.heartbeat - (time.monotonic() - last_event)
            time.sleep(min(args.refresh, max(0.0, heartbeat_remaining)))
            _, current = group_state_snapshot(root, monitored_ids)
            changed = [
                {"from": snapshot[task_id], "task_id": task_id, "to": current[task_id]}
                for task_id in monitored_ids
                if current[task_id] != snapshot[task_id]
            ]
            if changed:
                emit_group_event(subscription_event(
                    "state-change", args.group, current, watched, changed
                ))
                snapshot = current
                last_event = time.monotonic()
            elif time.monotonic() - last_event >= args.heartbeat:
                emit_group_event(subscription_event(
                    "heartbeat", args.group, current, watched
                ))
                last_event = time.monotonic()
    except KeyboardInterrupt:
        return


def parser() -> argparse.ArgumentParser:
    result = LocalizedArgumentParser(prog="kanban", description=t("本地文件看板", "Local file kanban board"))
    result.add_argument("--lang", choices=LANGUAGES, help=t("覆盖输出语言", "override the output language"))
    commands = result.add_subparsers(dest="command", required=True)

    init_parser = commands.add_parser("init", help=t("创建看板目录框架", "create the board directory structure"))
    init_parser.add_argument(
        "project",
        nargs="?",
        metavar=t("项目路径", "project"),
        help=t("项目根目录, 默认当前项目", "project root; defaults to the current project"),
    )

    commands.add_parser("rules", help=t("输出当前作用域看板规则", "print current-scope kanban rules"))

    list_parser = commands.add_parser("list", aliases=["ls"], help=t("列出任务", "list tasks"))
    list_parser.add_argument("state", nargs="?", choices=STATES)
    list_parser.add_argument("--mobile", action="store_true", help=t("使用竖屏手机布局", "use a vertical mobile layout"))

    show_parser = commands.add_parser("show", help=t("输出入口任务文档", "print a task document"))
    show_parser.add_argument("task", metavar=t("任务", "task"))

    new_parser = commands.add_parser("new", help=t("在 backlog 创建任务", "create a task in backlog"))
    new_parser.add_argument("--large", action="store_true", help=t("创建大任务目录", "create a large-task directory"))
    new_parser.add_argument("type", choices=tuple(TYPE_NAMES))
    new_parser.add_argument("slug")
    new_parser.add_argument("title", nargs="+", metavar=t("标题", "title"))

    move_parser = commands.add_parser("move", help=t("迁移任务状态", "move a task between states"))
    move_parser.add_argument("task", metavar=t("任务", "task"))
    move_parser.add_argument("state", choices=STATES)

    pick_parser = commands.add_parser("pick", help=t("将 backlog 任务移入 todo", "move a backlog task to todo"))
    pick_parser.add_argument("task", nargs="?", metavar=t("任务", "task"))

    start_parser = commands.add_parser("start", help=t("领取任务并按 Onevoke 配置启动 Agent", "claim a task and launch an Agent using Onevoke configuration"))
    start_parser.add_argument("task", nargs="?", metavar=t("任务", "task"))
    start_parser.add_argument("--agent", choices=AGENT_NAMES, help=t("覆盖配置中的默认 Agent", "override the configured default Agent"))
    start_parser.add_argument(
        "--launcher", choices=LAUNCHERS, help=t("覆盖配置中的启动方式", "override the configured launcher")
    )

    resume_parser = commands.add_parser(
        "resume",
        help=t("用原会话唤醒 review 或 working 中任务的执行 Agent", "resume the execution Agent of a review or working task with its original session"),
    )
    resume_parser.add_argument("task", metavar=t("任务", "task"))
    resume_parser.add_argument("--message", help=t("交给执行 Agent 处理的事项", "the items for the execution Agent to handle"))
    resume_parser.add_argument("--message-file", help=t("从 UTF-8 文件读取事项", "read the items from a UTF-8 file"))
    resume_parser.add_argument(
        "--launcher",
        choices=LAUNCHERS,
        help=t("覆盖本次启动方式, 不修改配置", "override the launcher for this run without changing the configuration"),
    )
    resume_parser.add_argument(
        "--timeout",
        type=float,
        default=NOTIFY_DEFAULT_TIMEOUT,
        metavar=t("秒", "seconds"),
        help=t("等待恢复存活的超时秒数, 默认 120", "seconds to wait for resumed-agent liveness; default 120"),
    )

    notify_parser = commands.add_parser(
        "notify",
        help=t("向原执行 Agent 投递事项并自动选择直投或恢复", "notify the original execution Agent using direct delivery or automatic resume"),
    )
    notify_parser.add_argument("task", metavar=t("任务", "task"))
    notify_parser.add_argument("--message", help=t("交给执行 Agent 处理的事项", "the items for the execution Agent to handle"))
    notify_parser.add_argument("--message-file", help=t("从 UTF-8 文件读取事项", "read the items from a UTF-8 file"))
    notify_parser.add_argument(
        "--pane",
        help=t("覆盖自动解析的 herdr pane id, 仍执行完整身份校验", "override the resolved herdr pane id; full identity validation still applies"),
    )
    notify_parser.add_argument(
        "--timeout",
        type=float,
        default=NOTIFY_DEFAULT_TIMEOUT,
        metavar=t("秒", "seconds"),
        help=t("等待直投回执与恢复存活的超时秒数, 默认 120", "seconds to wait for direct acknowledgement and resumed-agent liveness; default 120"),
    )

    check_parser = commands.add_parser("check", help=t("检查看板不变量", "check board invariants"))
    check_parser.add_argument(
        "tasks",
        nargs="*",
        metavar=t("任务", "task"),
        help=t("只检查指定任务 ID", "check only the specified task IDs"),
    )

    subscribe_parser = commands.add_parser(
        "subscribe",
        help=t("订阅任务组成员的状态事件", "subscribe to task-group member state events"),
    )
    subscribe_parser.add_argument("group", metavar=t("任务组", "task-group"))
    subscribe_parser.add_argument("tasks", nargs="+", metavar=t("任务", "task"))
    subscribe_parser.add_argument(
        "--watch",
        action="extend",
        nargs="+",
        default=[],
        metavar=t("外部任务或任务组", "external-task-or-group"),
        help=t(
            "同时监控组外任务或任务组, 可重复指定",
            "also watch external tasks or task groups; may be repeated",
        ),
    )
    subscribe_parser.add_argument(
        "--refresh",
        type=float,
        default=1.0,
        metavar=t("秒", "seconds"),
        help=t("状态扫描间隔秒数, 默认 1", "state scan interval in seconds; default 1"),
    )
    subscribe_parser.add_argument(
        "--heartbeat",
        type=float,
        default=900.0,
        metavar=t("秒", "seconds"),
        help=t("无变化心跳间隔秒数, 默认 900", "idle heartbeat interval in seconds; default 900"),
    )

    web_parser = commands.add_parser(
        "web",
        help=t("启动只读看板 Web UI", "start the read-only kanban web UI"),
    )
    web_parser.add_argument(
        "--host",
        default="127.0.0.1",
        help=t("监听地址, 默认 127.0.0.1", "bind address; default 127.0.0.1"),
    )
    web_parser.add_argument(
        "--port",
        type=int,
        default=8080,
        help=t("监听端口, 默认 8080", "bind port; default 8080"),
    )
    web_parser.add_argument(
        "--refresh",
        type=int,
        default=60,
        metavar=t("秒", "seconds"),
        help=t("服务端任务扫描间隔秒数, 默认 60", "server task scan interval in seconds; default 60"),
    )
    web_parser.add_argument(
        "--assets",
        metavar=t("目录", "directory"),
        help=t("覆盖 Web 资源目录", "override the web assets directory"),
    )
    web_parser.add_argument(
        "--open",
        action="store_true",
        help=t("启动后尝试打开浏览器", "try to open a browser after start"),
    )

    tui_parser = commands.add_parser(
        "tui",
        help=t("启动只读看板 TUI", "start the read-only kanban TUI"),
    )
    tui_parser.add_argument(
        "--single",
        action="store_true",
        help=t(
            "始终只显示一个栏目, 即使终端足够宽",
            "always show one column, even when the terminal is wide enough",
        ),
    )
    tui_parser.add_argument(
        "--refresh",
        type=int,
        default=30,
        metavar=t("秒", "seconds"),
        help=t("任务自动刷新间隔秒数, 默认 30", "task refresh interval in seconds; default 30"),
    )
    tui_parser.add_argument(
        "--theme",
        choices=("auto", "light", "dark"),
        default="auto",
        help=t("配色主题, 默认 auto 跟随终端", "color theme; default auto follows the terminal"),
    )
    return result


def main() -> int:
    args = parser().parse_args()
    try:
        if args.command == "init":
            command_init(args)
            return 0
        if args.command == "rules":
            command_rules()
            return 0
        root = board_root()
        if args.command in ("list", "ls"):
            command_list(args, root)
        elif args.command == "show":
            command_show(args, root)
        elif args.command == "new":
            command_new(args, root)
        elif args.command == "move":
            command_move(args, root)
        elif args.command == "pick":
            command_pick(args, root)
        elif args.command == "start":
            command_start(args, root)
        elif args.command == "resume":
            command_resume(args, root)
        elif args.command == "notify":
            command_notify(args, root)
        elif args.command == "check":
            return command_check(args, root)
        elif args.command == "subscribe":
            command_subscribe(args, root)
        elif args.command == "web":
            command_web(args, root)
        elif args.command == "tui":
            command_tui(args, root)
        return 0
    except (KanbanError, ConfigError, OSError, UnicodeError) as error:
        print(f"kanban: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
