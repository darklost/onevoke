#!/usr/bin/env python3

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Any, NoReturn

from onevoke_config import (
    ARGPARSE_ZH,
    EXECUTION_AGENTS,
    LANGUAGES,
    REVIEW_AGENTS,
    REVIEW_ROLES,
    REVIEW_STAGE_MODES,
    ConfigError,
    InstallPaths,
    LocalizedArgumentParser,
    apply_language_argument,
    bind_config_language,
    bind_effective_language,
    config_path,
    configured_language,
    default_config,
    effective_config,
    install_paths,
    language_text,
    load_config,
    resolve_language,
    save_config,
)

apply_language_argument(sys.argv[1:])
bind_effective_language()
t = language_text
argparse._ = lambda message: t(ARGPARSE_ZH.get(message, message), message)


REVIEW_ENTRYPOINT = "onevoke-review.cmd" if os.name == "nt" else "onevoke-review.sh"
REVIEW_IMPLEMENTATION = Path(__file__).resolve().with_name("onevoke_review.py")
MERGE_ENTRYPOINT = "merge-worktree-memory.cmd" if os.name == "nt" else "merge-worktree-memory.py"
COMMANDS = (
    "onevoke",
    "kanban",
    REVIEW_ENTRYPOINT,
    MERGE_ENTRYPOINT,
)
AGENT_LABELS = {"codex": "Codex", "claude": "Claude", "grok": "Grok"}
MEMSEARCH_REPOSITORY = "https://github.com/zilliztech/memsearch.git"
REVIEW_STAGE_LABELS = {
    "auto": ("按档案自动", "follow audit profile"),
    "skip": ("默认跳过", "skip by default"),
    "required": ("默认必跑", "required when review runs"),
}
LANGUAGE_LABELS = {"cn": ("中文", "Chinese"), "en": ("英文", "English")}


class OnevokeError(Exception):
    pass


def current_paths() -> InstallPaths:
    """按当前 onevoke 入口解析安装作用域, 不跟随符号链接."""
    return install_paths(entry=Path(__file__))


def review_gate() -> str | None:
    """当前入口应调用的审核门禁.

    项目模式只使用本安装命令根中的入口, 缺失时不回落 PATH 或全局安装.
    全局 POSIX 仍查 PATH, 以保持源码树测试和 ``~/.local/bin`` 行为.
    Windows 程序化分发只进入同目录 ``onevoke_review.py``.
    """
    paths = current_paths()
    if os.name == "nt":
        if REVIEW_IMPLEMENTATION.is_file():
            return str(REVIEW_IMPLEMENTATION)
        return None
    if paths.mode == "project":
        command = paths.bin_dir / REVIEW_ENTRYPOINT
        return str(command) if command.is_file() else None
    return shutil.which(REVIEW_ENTRYPOINT)


def review_gate_missing_message() -> str:
    paths = current_paths()
    if os.name == "nt":
        return t(
            f"审核实现不存在: {REVIEW_IMPLEMENTATION}",
            f"Review implementation is missing: {REVIEW_IMPLEMENTATION}",
        )
    if paths.mode == "project":
        expected = paths.bin_dir / REVIEW_ENTRYPOINT
        return t(f"审核入口不存在: {expected}", f"review entrypoint is missing: {expected}")
    return t(
        f"{REVIEW_ENTRYPOINT} 不在 PATH",
        f"{REVIEW_ENTRYPOINT} is not in PATH",
    )


def command_missing_message(name: str) -> str:
    paths = current_paths()
    if paths.mode == "project":
        expected = paths.bin_dir / name
        return t(
            f"{name} 不在项目命令根: {expected}",
            f"{name} is not in the project command root: {expected}",
        )
    return t(
        f"{name} 不在 PATH. 请把 ~/.local/bin 加入 PATH 后重新打开 shell.",
        f"{name} is not in PATH. Add ~/.local/bin to PATH and reopen your shell.",
    )


def rules_entry() -> Path:
    return current_paths().rules_dir / "ONEVOKE-AGENTS.md"


def color(code: str, text: str) -> str:
    if os.environ.get("NO_COLOR") or not sys.stderr.isatty():
        return text
    return f"\033[{code}m{text}\033[0m"


def warning(text: str) -> None:
    print(color("1;31", f"[!] {text}"), file=sys.stderr)


def success(text: str) -> None:
    print(color("1;32", f"[OK] {text}"), file=sys.stderr)


def find_commands() -> dict[str, str | None]:
    paths = current_paths()
    if paths.mode == "project":
        found: dict[str, str | None] = {}
        for name in COMMANDS:
            command = paths.bin_dir / name
            found[name] = str(command) if command.is_file() else None
        return found
    return {name: shutil.which(name) for name in COMMANDS}


VERSION_FAILED = t("版本检查失败", "version check failed")
TMUX_SESSION_HINT = "tmux new -A -s onevoke"


def agent_version(command: str) -> str:
    try:
        result = subprocess.run(
            [command, "--version"],
            text=True,
            capture_output=True,
            check=False,
            timeout=5,
        )
    except (OSError, subprocess.TimeoutExpired):
        return VERSION_FAILED
    output = (result.stdout or result.stderr).strip().splitlines()
    return output[0] if result.returncode == 0 and output else VERSION_FAILED


def agent_usable(state: dict[str, str | bool | None]) -> bool:
    """PATH 上有二进制且 --version 成功才算可用."""
    return bool(state.get("path")) and state.get("version") not in (None, VERSION_FAILED)


def windows_native_executable(command: str) -> bool:
    """Programmatic Windows Agent calls require a native argv boundary."""
    return os.name != "nt" or Path(command).suffix.lower() == ".exe"


def find_agents() -> dict[str, dict[str, str | bool | None]]:
    agents: dict[str, dict[str, str | bool | None]] = {}
    for name in EXECUTION_AGENTS:
        command = shutil.which(name)
        native = bool(command and windows_native_executable(command))
        agents[name] = {
            "path": command,
            "version": agent_version(command) if command and native else None,
            "unsafe_batch": bool(command and not native),
            "execution": True,
            "review": name in REVIEW_AGENTS,
            "memsearch": name in ("codex", "claude"),
        }
    return agents


def _strip_comments_and_fences(text: str) -> str:
    """去掉 HTML 注释和 fenced code, 避免注释/示例里的标记造成假接入.

    未闭合的 `<!--` 一直删到文件末尾, 防止注释残片被当正文.
    """
    without_comments = re.sub(r"<!--.*?-->", "", text, flags=re.DOTALL)
    without_comments = re.sub(r"<!--.*\Z", "", without_comments, flags=re.DOTALL)
    lines: list[str] = []
    fence: str | None = None
    fence_len = 0
    for raw in without_comments.splitlines():
        stripped = raw.lstrip()
        if fence is None:
            for marker in ("```", "~~~"):
                if stripped.startswith(marker):
                    fence = marker[0]
                    fence_len = len(stripped) - len(stripped.lstrip(marker[0]))
                    break
            else:
                lines.append(raw)
            continue
        if stripped.startswith(fence * 3):
            closing = len(stripped) - len(stripped.lstrip(fence))
            if closing >= fence_len:
                fence = None
                fence_len = 0
    return "\n".join(lines)


_NEGATION_RE = re.compile(
    r"(禁用|废弃|停用|不要遵守|勿遵守|不遵守|不要使用|不使用|请勿使用|"
    r"未导入|尚未导入|不再生效|已失效|请忽略|"
    r"do not follow|do not use|disabled|deprecated|\bignore\b)",
    flags=re.IGNORECASE,
)


def _candidate_context(
    text: str, start: int, end: int, *, include_match: bool = True
) -> str:
    """取候选语境: 同段 + 前序/后序各最多 40 行, 捕捉前后否定说明.

    include_match=False 时不把候选正文本身计入语境, 避免合并式入口
    (如 ONEVOKE-AGENTS.md 内的「不使用其他长期分支模型」) 被自身否定词误伤.
    """
    before = text.rfind("\n\n", 0, start)
    after = text.find("\n\n", end)
    left = 0 if before < 0 else before + 2
    right = len(text) if after < 0 else after
    heading_before = text.rfind("\n#", left, start)
    if heading_before >= left:
        left = heading_before + 1
    heading_after = text.find("\n#", end, right)
    if heading_after >= 0:
        right = heading_after
    if include_match:
        section = text[left:right]
    else:
        section = text[left:start] + text[end:right]
    prior_lines = text[:start].splitlines()[-40:]
    following_lines = text[end:].splitlines()[:40]
    return "\n".join([section, *prior_lines, *following_lines])


def _rule_entry_candidates(entry: Path) -> set[str]:
    """当前作用域规则入口的可接受引用, 含 HOME 与 /tmp 解析别名."""
    candidates: set[str] = {str(entry)}
    try:
        expanded = entry.expanduser()
        resolved = expanded.resolve()
        candidates.add(str(expanded))
        candidates.add(str(resolved))
        homes = {str(Path.home()), str(Path.home().resolve())}
        for path in (str(expanded), str(resolved)):
            for home in homes:
                if path == home or path.startswith(home + os.sep):
                    candidates.add("~" + path[len(home):])
    except OSError:
        pass
    return candidates


def _claude_rules_import_present(text: str, entry: Path) -> bool:
    """Claude 只认独立行的 @ 导入, 且所在段落不得是否定/废弃语境."""
    candidates = _rule_entry_candidates(entry)
    body = _strip_comments_and_fences(text)
    offset = 0
    for raw in body.splitlines(keepends=True):
        line = raw.strip()
        line_start = offset
        offset += len(raw)
        if not line or line.startswith("#"):
            continue
        match = re.fullmatch(r"@([^\s]+)", line)
        if not match:
            continue
        ref = match.group(1).strip()
        accepted = ref in candidates
        if not accepted:
            try:
                accepted = (
                    Path(ref).expanduser().resolve() == entry.expanduser().resolve()
                )
            except OSError:
                accepted = False
        if not accepted:
            continue
        context = _candidate_context(body, line_start, offset)
        if _NEGATION_RE.search(context):
            continue
        return True
    return False


def _merged_rules_present(text: str, entry: Path) -> bool:
    """Codex/Grok 合并文件必须包含当前安装入口全文, 且外层语境不得是否定/废弃.

    入口正文自身可能含「不使用」等词 (见 ONEVOKE-AGENTS 分支模型条款),
    否定检查只看正文前后语境, 不扫描 expected 本身.
    """
    try:
        expected = entry.read_text(encoding="utf-8").strip()
    except (OSError, UnicodeError):
        return False
    if not expected:
        return False
    body = _strip_comments_and_fences(text)
    index = body.find(expected)
    if index < 0:
        return False
    context = _candidate_context(
        body, index, index + len(expected), include_match=False
    )
    if _NEGATION_RE.search(context):
        return False
    return True


def rules_integration(agent: str) -> tuple[bool, str]:
    entry = rules_entry()
    if agent == "codex":
        target = Path.home() / ".codex" / "AGENTS.md"
    elif agent == "claude":
        target = Path.home() / ".claude" / "CLAUDE.md"
    else:
        target = Path.home() / ".grok" / "AGENTS.md"
    if not target.exists() and not target.is_symlink():
        return False, t(f"未发现 {target}", f"not found: {target}")
    try:
        if target.is_symlink():
            linked = target.resolve()
            expected = entry.expanduser().resolve()
            if linked == expected:
                return True, str(target)
            # Codex/Grok 用软链接入入口. 项目与全局共用同一套规则正文,
            # 跟随指向全局入口的软链再做全文包含会误判. Claude 是 @ 导入,
            # CLAUDE.md 本身常软链到 dotfiles, 不得套用这条短路.
            if current_paths().mode == "project" and agent != "claude":
                return False, t(
                    f"{target} 未指向项目规则入口 {entry}",
                    f"{target} does not point to the project rules entry {entry}",
                )
        text = target.read_text(encoding="utf-8")
    except (OSError, UnicodeError):
        return False, t(f"无法读取 {target}", f"cannot read: {target}")
    if agent == "claude":
        integrated = _claude_rules_import_present(text, entry)
    else:
        integrated = _merged_rules_present(text, entry)
    if integrated:
        return True, str(target)
    return False, t(
        f"{target} 未导入或合并 ONEVOKE-AGENTS.md",
        f"{target} does not import or include ONEVOKE-AGENTS.md",
    )


def print_doctor() -> bool:
    healthy = True
    print(t("Onevoke 环境检查", "Onevoke environment check"), file=sys.stderr)
    paths = current_paths()
    if paths.mode == "project":
        success(t(f"安装模式: 项目 ({paths.install_root})", f"install mode: project ({paths.install_root})"))
        success(t(f"规则入口: {rules_entry()}", f"rules entry: {rules_entry()}"))
    else:
        success(t("安装模式: 全局", "install mode: global"))
    for name, path in find_commands().items():
        if path:
            success(f"{name}: {path}")
        else:
            healthy = False
            warning(command_missing_message(name))
    try:
        # 只用来决定要不要提示进入 session; 配置本身的错误留给下面的统一校验报告.
        configured_launcher = effective_config(load_config())["launcher"]
    except ConfigError:
        configured_launcher = None
    if os.name == "nt":
        success(t("Windows 独立控制台启动器: 可用", "Windows console launcher: available"))
    else:
        tmux = shutil.which("tmux")
        if tmux:
            success(f"tmux: {tmux}")
            if not os.environ.get("TMUX") and configured_launcher not in (
                "tmux-session",
                "auto",
                "herdr",
            ):
                print(
                    t(
                        f"[-] tmux: 已安装但当前不在 session. 启动: {TMUX_SESSION_HINT}",
                        f"[-] tmux: installed, but not in a session. Start one with: {TMUX_SESSION_HINT}",
                    ),
                    file=sys.stderr,
                )
        else:
            print(t(
                "[-] tmux: 未安装; 可在 welcome 中选择前台启动模式",
                "[-] tmux: not installed; welcome can select foreground mode",
            ), file=sys.stderr)
        herdr = shutil.which("herdr")
        if herdr:
            success(f"herdr: {herdr}")
            if os.environ.get("HERDR_ENV") != "1" and configured_launcher == "herdr":
                print(
                    t(
                        "[-] herdr: 已安装但当前不在 herdr. herdr 启动方式要求 HERDR_ENV=1",
                        "[-] herdr: installed, but not currently in herdr. The herdr launcher requires HERDR_ENV=1",
                    ),
                    file=sys.stderr,
                )
        elif configured_launcher == "herdr":
            print(t(
                "[-] herdr: 未安装; 可在 welcome 中选择其他启动方式",
                "[-] herdr: not installed; welcome can select another launcher",
            ), file=sys.stderr)

    agents = find_agents()
    print(t("\nAgent 能力:", "\nAgent capabilities:"), file=sys.stderr)
    for name, state in agents.items():
        if agent_usable(state):
            capabilities = [t("执行", "execution")]
            if state["review"]:
                capabilities.append(t("审核", "review"))
            if state["memsearch"]:
                capabilities.append("MemSearch")
            success(
                f"{AGENT_LABELS[name]}: {state['version']} "
                f"({', '.join(capabilities)}; {t('认证未验证', 'authentication not verified')})"
            )
        elif state.get("unsafe_batch"):
            healthy = False
            warning(
                t(
                    f"{AGENT_LABELS[name]}: {state['path']} 不是原生 .exe; Windows 不会执行会重解析参数的 .cmd/.bat Agent.",
                    f"{AGENT_LABELS[name]}: {state['path']} is not a native .exe; Windows will not execute a .cmd/.bat Agent that reparses arguments.",
                )
            )
        elif state["path"]:
            healthy = False
            warning(
                t(
                    f"{AGENT_LABELS[name]}: 位于 {state['path']}, 但 --version 失败; 不视为可用, 也不能在 welcome 中选择.",
                    f"{AGENT_LABELS[name]}: found at {state['path']}, but --version failed; it is unavailable and cannot be selected in welcome.",
                )
            )
        else:
            print(t(f"[-] {AGENT_LABELS[name]}: 未安装", f"[-] {AGENT_LABELS[name]}: not installed"), file=sys.stderr)
    if not any(agent_usable(state) for state in agents.values()):
        healthy = False
        warning(t("没有发现可执行 Agent; kanban 无法启动任务.", "No executable Agent found; kanban cannot start tasks."))
    if not any(agent_usable(agents[name]) for name in REVIEW_AGENTS):
        healthy = False
        warning(t("没有发现 Reviewer; 审核流程无法运行.", "No Reviewer found; reviews cannot run."))

    try:
        config = load_config()
    except ConfigError as error:
        warning(str(error))
        healthy = False
    else:
        if config["welcome_complete"]:
            success(t(f"配置: {config_path()}", f"config: {config_path()}"))
        else:
            print(t(f"[-] 配置: 尚未完成 ({config_path()})", f"[-] config: incomplete ({config_path()})"), file=sys.stderr)
        # 无论 welcome 是否完成, 都校验 effective_config 指向的实际资源.
        healthy = validate_configured_resources(config, agents) and healthy
    return healthy


def validate_configured_resources(
    config: dict[str, Any],
    agents: dict[str, dict[str, str | bool | None]],
) -> bool:
    """对生效配置逐项核对执行 Agent、Reviewer、审核入口和 launcher."""
    healthy = True
    effective = effective_config(config)
    selected_agent = effective["kanban_agent"]
    selected_state = agents.get(selected_agent, {})
    if not agent_usable(selected_state):
        healthy = False
        warning(
            t(
                f"配置的执行 Agent 不可用: {selected_agent}; 请安装后重新运行 onevoke welcome --reset.",
                f"Configured execution Agent is unavailable: {selected_agent}; install it, then run onevoke welcome --reset.",
            )
        )

    review_command = review_gate()
    if not review_command and os.name == "nt" and current_paths().mode != "project":
        review_command = shutil.which(REVIEW_ENTRYPOINT)
    if not review_command:
        healthy = False
        if current_paths().mode == "project":
            warning(review_gate_missing_message())
        elif os.name == "nt":
            warning(
                t(
                    f"审核实现不存在: {REVIEW_IMPLEMENTATION}; 请重新安装 Onevoke.",
                    f"Review implementation is missing: {REVIEW_IMPLEMENTATION}; reinstall Onevoke.",
                )
            )
        else:
            warning(
                t(
                    "onevoke-review.sh 不在 PATH; 请把 ~/.local/bin 加入 PATH 或重新安装 Onevoke.",
                    "onevoke-review.sh is not in PATH; add ~/.local/bin to PATH or reinstall Onevoke.",
                )
            )

    for role in REVIEW_ROLES:
        reviewer = effective["reviewers"][role]
        reviewer_state = agents.get(reviewer, {})
        if not agent_usable(reviewer_state):
            healthy = False
            warning(
                t(
                    f"配置的 {role} Reviewer 不可用: {reviewer}; 请安装后重新运行 onevoke welcome --reset.",
                    f"Configured {role} Reviewer is unavailable: {reviewer}; install it, then run onevoke welcome --reset.",
                )
            )

    launcher = effective["launcher"]
    if launcher in ("tmux", "tmux-session"):
        if os.name == "nt":
            healthy = False
            warning(t(
                f"配置的 launcher 是 {launcher}, 原生 Windows 不支持 tmux; 请运行 onevoke welcome --reset 改选 console 或 foreground.",
                f"The configured launcher is {launcher}, but native Windows does not support tmux; run onevoke welcome --reset and select console or foreground.",
            ))
        elif not shutil.which("tmux"):
            healthy = False
            warning(
                t(
                    f"配置的 launcher 是 {launcher}, 但 tmux 不在 PATH; 请安装 tmux 或运行 onevoke welcome --reset 改选 foreground.",
                    f"The configured launcher is {launcher}, but tmux is not in PATH; install tmux or run onevoke welcome --reset and select foreground.",
                )
            )
        elif not config.get("welcome_complete"):
            pass
        elif launcher == "tmux-session":
            print(
                t(
                    "[-] launcher=tmux-session 会按项目自动新建或复用专属 session, 不要求当前处于 tmux",
                    "[-] launcher=tmux-session creates or reuses a per-project session automatically; being in tmux is not required",
                ),
                file=sys.stderr,
            )
        elif not os.environ.get("TMUX"):
            # 通用 tmux 段已给出唯一启动命令; 这里只在已完成配置时补充契约提示.
            print(
                t(
                    "[-] launcher=tmux 需要先进入上述 tmux session",
                    "[-] launcher=tmux requires entering the tmux session shown above",
                ),
                file=sys.stderr,
            )
    elif launcher == "console":
        if os.name != "nt":
            healthy = False
            warning(t(
                "配置的 launcher 是 console, 但该启动方式只支持 Windows; 请运行 onevoke welcome --reset.",
                "The configured launcher is console, but it is available only on Windows; run onevoke welcome --reset.",
            ))
        elif config.get("welcome_complete"):
            print(t(
                "[-] launcher=console 会在独立 Windows 控制台启动 Agent 并返回 PID",
                "[-] launcher=console starts the Agent in a separate Windows console and returns its PID",
            ), file=sys.stderr)
    elif launcher == "herdr":
        if os.name == "nt":
            healthy = False
            warning(t(
                "配置的 launcher 是 herdr, 原生 Windows 不支持 herdr; 请运行 onevoke welcome --reset 改选 console 或 foreground.",
                "The configured launcher is herdr, but native Windows does not support herdr; run onevoke welcome --reset and select console or foreground.",
            ))
        elif not shutil.which("herdr"):
            healthy = False
            warning(
                t(
                    "配置的 launcher 是 herdr, 但 herdr 不在 PATH; 请安装 herdr 或运行 onevoke welcome --reset 改选其他启动方式.",
                    "The configured launcher is herdr, but herdr is not in PATH; install herdr or run onevoke welcome --reset and select another launcher.",
                )
            )
        elif not config.get("welcome_complete"):
            pass
        elif os.environ.get("HERDR_ENV") != "1":
            print(
                t(
                    "[-] launcher=herdr 需要当前处于 herdr (HERDR_ENV=1)",
                    "[-] launcher=herdr requires running inside herdr (HERDR_ENV=1)",
                ),
                file=sys.stderr,
            )
        elif not os.environ.get("HERDR_WORKSPACE_ID", "").strip():
            healthy = False
            warning(
                t(
                    "配置的 launcher 是 herdr, 但缺少 HERDR_WORKSPACE_ID; 无法在当前 workspace 新建 tab.",
                    "The configured launcher is herdr, but HERDR_WORKSPACE_ID is missing; cannot create a tab in the current workspace.",
                )
            )
        else:
            print(
                t(
                    "[-] launcher=herdr 会在当前 workspace 新建 tab 并启动 Agent",
                    "[-] launcher=herdr creates a tab in the current workspace and starts the Agent",
                ),
                file=sys.stderr,
            )
    elif launcher == "auto":
        if os.name == "nt":
            healthy = False
            warning(t(
                "配置的 launcher 是 auto, 原生 Windows 不支持 auto; 请运行 onevoke welcome --reset 改选 console 或 foreground.",
                "The configured launcher is auto, but native Windows does not support auto; run onevoke welcome --reset and select console or foreground.",
            ))
        elif not shutil.which("tmux") and not shutil.which("herdr"):
            healthy = False
            warning(
                t(
                    "配置的 launcher 是 auto, 但 herdr 和 tmux 都不在 PATH; 请安装其一或运行 onevoke welcome --reset 改选其他启动方式.",
                    "The configured launcher is auto, but neither herdr nor tmux is in PATH; install one of them or run onevoke welcome --reset and select another launcher.",
                )
            )
        elif config.get("welcome_complete"):
            print(
                t(
                    "[-] launcher=auto 在启动时按当前环境选择: 处于 herdr 则新建 tab, 否则处于 tmux 则新建 window",
                    "[-] launcher=auto chooses at start: a herdr tab if inside herdr, otherwise a tmux window if inside tmux",
                ),
                file=sys.stderr,
            )
    elif launcher == "foreground":
        # 仅在配置已完成时提示, 避免与通用 doctor 输出叠床架屋.
        if config.get("welcome_complete"):
            launcher_hint = t("console", "console") if os.name == "nt" else "tmux"
            print(
                t(
                    f"[-] launcher=foreground 需要交互终端 (stdin/stdout/stderr 均为 tty); 无 TTY 时改用 {launcher_hint} 或在真实终端运行.",
                    f"[-] launcher=foreground requires an interactive terminal (stdin/stdout/stderr must be TTYs); use {launcher_hint} without a TTY or run in a real terminal.",
                ),
                file=sys.stderr,
            )

    return healthy


def ask_choice(prompt: str, choices: list[tuple[str, str]], default: str | None = None) -> str:
    if not choices:
        raise OnevokeError(t(f"没有可选项: {prompt}", f"No choices available: {prompt}"))
    if default not in {value for value, _ in choices}:
        default = choices[0][0]
    while True:
        print(f"\n{color('1;36', prompt)}", file=sys.stderr)
        for index, (_, label) in enumerate(choices, 1):
            suffix = t(" (当前)", " (current)") if choices[index - 1][0] == default else ""
            print(f"  {index}. {label}{suffix}", file=sys.stderr)
        print(
            t(
                f"请选择 [1-{len(choices)}], 直接回车保留当前值: ",
                f"Choose [1-{len(choices)}], or press Enter to keep the current value: ",
            ),
            end="",
            file=sys.stderr,
            flush=True,
        )
        answer = sys.stdin.readline()
        if not answer:
            raise OnevokeError(t("输入已结束, 配置未更改", "Input ended; configuration was not changed"))
        answer = answer.strip()
        if not answer:
            return default
        if answer.isdigit() and 1 <= int(answer) <= len(choices):
            return choices[int(answer) - 1][0]
        print(t("输入无效, 请重新选择.", "Invalid input; choose again."), file=sys.stderr)


def ask_yes_no(prompt: str, default: bool = False) -> bool:
    marker = "Y/n" if default else "y/N"
    while True:
        print(
            f"\n{color('1;36', prompt)} [{marker}]: ",
            end="",
            file=sys.stderr,
            flush=True,
        )
        answer = sys.stdin.readline()
        if not answer:
            raise OnevokeError(t("输入已结束, 配置未更改", "Input ended; configuration was not changed"))
        normalized = answer.strip().lower()
        if not normalized:
            return default
        if normalized in ("y", "yes"):
            return True
        if normalized in ("n", "no"):
            return False
        print(t("输入无效, 请输入 yes 或 no.", "Invalid input; enter yes or no."), file=sys.stderr)


def choices_with_current(choices: list[tuple[str, str]], current: str) -> list[tuple[str, str]]:
    if any(value == current for value, _ in choices):
        return choices
    unavailable = t("当前不可用", "currently unavailable")
    return [(current, f"{AGENT_LABELS[current]} ({unavailable})"), *choices]


def review_stage_choices() -> list[tuple[str, str]]:
    return [
        (mode, t(REVIEW_STAGE_LABELS[mode][0], REVIEW_STAGE_LABELS[mode][1]))
        for mode in REVIEW_STAGE_MODES
    ]


def format_review_stages_summary(stages: dict[str, str]) -> str:
    return " ".join(f"{role}={stages[role]}" for role in REVIEW_ROLES)


def language_choices() -> list[tuple[str, str]]:
    return [
        (code, t(LANGUAGE_LABELS[code][0], LANGUAGE_LABELS[code][1]))
        for code in LANGUAGES
    ]


def format_language_summary(language: str) -> str:
    labels = LANGUAGE_LABELS.get(language, (language, language))
    return t(labels[0], labels[1])


def edit_language(config: dict[str, Any]) -> None:
    config["language"] = ask_choice(
        t("默认输出语言?", "Default output language?"),
        language_choices(),
        config["language"],
    )
    bind_config_language(config)


def edit_review_stages(config: dict[str, Any]) -> None:
    role = ask_choice(
        t("要配置哪个审核角色的环节策略?", "Which review role should be configured?"),
        [
            (name, f"{name} ({config['review_stages'][name]})")
            for name in REVIEW_ROLES
        ],
        REVIEW_ROLES[0],
    )
    config["review_stages"][role] = ask_choice(
        t(f"{role} 的默认环节策略?", f"Default stage policy for {role}?"),
        review_stage_choices(),
        config["review_stages"][role],
    )


def ask_text(prompt: str, default: str) -> str:
    shown = default if default else t("(空, 用 CLI 默认)", "(empty; CLI default)")
    print(f"\n{color('1;36', prompt)} [{shown}]: ", end="", file=sys.stderr, flush=True)
    answer = sys.stdin.readline()
    if not answer:
        raise OnevokeError(t("输入已结束, 配置未更改", "Input ended; configuration was not changed"))
    answer = answer.strip()
    return answer if answer else default


def edit_models(config: dict[str, Any]) -> None:
    """只列出当前配置实际用到的 Agent, 并允许精确修改一个字段."""
    kanban_agent = config["kanban_agent"]
    kanban_entry = config["models"]["kanban"][kanban_agent]
    fields: list[tuple[str, dict[str, str], str, str]] = [
        (
            t(f"kanban {AGENT_LABELS[kanban_agent]} 模型", f"kanban {AGENT_LABELS[kanban_agent]} model"),
            kanban_entry,
            "model",
            t("任务模型?", "Task model?"),
        ),
        (
            t("kanban 大任务推理档位", "kanban large-task reasoning effort"),
            kanban_entry,
            "large_effort",
            t("大任务推理档位?", "Reasoning effort for large tasks?"),
        ),
        (
            t("kanban 小任务推理档位", "kanban small-task reasoning effort"),
            kanban_entry,
            "small_effort",
            t("小任务推理档位?", "Reasoning effort for small tasks?"),
        ),
    ]
    for reviewer in dict.fromkeys(config["reviewers"].values()):
        entry = config["models"]["review"][reviewer]
        label = AGENT_LABELS[reviewer]
        fields.extend(
            (
                (
                    t(f"审核 {label} 模型", f"Review {label} model"),
                    entry,
                    "model",
                    t(f"审核 {label} 用什么模型?", f"Which model should {label} use for reviews?"),
                ),
                (
                    t(f"审核 {label} 推理档位", f"Review {label} reasoning effort"),
                    entry,
                    "effort",
                    t(f"审核 {label} 的推理档位?", f"Reasoning effort for {label} reviews?"),
                ),
            )
        )

    while True:
        print(f"\n{color('1;36', t('模型与推理档位', 'Models and reasoning efforts'))}", file=sys.stderr)
        for index, (label, entry, field, _) in enumerate(fields, 1):
            value = entry[field] or t("(CLI 默认)", "(CLI default)")
            print(f"  {index}. {label}: {value}", file=sys.stderr)
        print(
            t(
                f"请选择要修改的项目 [1-{len(fields)}], 直接回车返回: ",
                f"Choose an item to change [1-{len(fields)}], or press Enter to return: ",
            ),
            end="",
            file=sys.stderr,
            flush=True,
        )
        answer = sys.stdin.readline()
        if not answer:
            raise OnevokeError(t("输入已结束, 配置未更改", "Input ended; configuration was not changed"))
        answer = answer.strip()
        if not answer:
            return
        if answer.isdigit() and 1 <= int(answer) <= len(fields):
            _, entry, field, prompt = fields[int(answer) - 1]
            entry[field] = ask_text(prompt, entry[field])
            return
        print(t("输入无效, 请重新选择.", "Invalid input; choose again."), file=sys.stderr)


def install_memsearch_for(agent: str) -> None:
    if agent == "claude":
        print(
            t(
                "请在 Claude Code 内安装 MemSearch:",
                "Install MemSearch in Claude Code:",
            ),
            file=sys.stderr,
        )
        print("  /plugin marketplace add zilliztech/memsearch", file=sys.stderr)
        print("  /plugin install memsearch", file=sys.stderr)
        return

    source = Path(
        os.environ.get(
            "ONEVOKE_MEMSEARCH_SOURCE",
            str(current_paths().share_dir / "memsearch"),
        )
    ).expanduser()
    installer = source / "plugins" / "codex" / "scripts" / "install.sh"
    try:
        source.parent.mkdir(parents=True, exist_ok=True)
        subprocess.run(
            ["git", "clone", MEMSEARCH_REPOSITORY, str(source)],
            check=True,
        )
        subprocess.run(["bash", str(installer)], check=True)
        success(t("MemSearch 安装命令已执行.", "The MemSearch installation commands completed."))
    except (OSError, subprocess.CalledProcessError) as error:
        warning(t(f"MemSearch 安装命令无法执行: {error}", f"Could not run the MemSearch installation commands: {error}"))


def install_tmux() -> bool:
    managers = (
        ("brew", ["brew", "install", "tmux"]),
        ("apt-get", ["apt-get", "install", "-y", "tmux"]),
        ("dnf", ["dnf", "install", "-y", "tmux"]),
        ("pacman", ["pacman", "-S", "--needed", "--noconfirm", "tmux"]),
        ("apk", ["apk", "add", "tmux"]),
    )
    selected = next((command for name, command in managers if shutil.which(name)), None)
    if selected is None:
        warning(t("没有找到受支持的包管理器, 请手动安装 tmux.", "No supported package manager was found; install tmux manually."))
        return False
    if selected[0] != "brew" and hasattr(os, "geteuid") and os.geteuid() != 0:
        sudo = shutil.which("sudo")
        if not sudo:
            warning(t(f"安装 tmux 需要管理员权限: {' '.join(selected)}", f"Installing tmux requires administrator privileges: {' '.join(selected)}"))
            return False
        selected = [sudo, *selected]
    print(t(f"即将运行: {' '.join(selected)}", f"About to run: {' '.join(selected)}"), file=sys.stderr)
    result = subprocess.run(selected, check=False)
    if result.returncode != 0 or not shutil.which("tmux"):
        warning(t("tmux 安装失败或安装后仍不在 PATH.", "tmux installation failed or tmux is still not in PATH."))
        return False
    success(t("tmux 已安装.", "tmux is installed."))
    return True


def auto_launcher_choice() -> tuple[str, str]:
    return (
        "auto",
        t("按当前环境自动选择 herdr 或 tmux", "choose herdr or tmux from the current environment"),
    )


def tmux_launcher_choices() -> list[tuple[str, str]]:
    return [
        ("tmux", t("tmux 当前 session 新窗口", "new window in the current tmux session")),
        ("tmux-session", t("tmux 项目专属 session 新窗口", "new window in a per-project tmux session")),
    ]


def herdr_launcher_choices(config: dict[str, Any]) -> list[tuple[str, str]]:
    installed = shutil.which("herdr") is not None
    if not installed and config["launcher"] != "herdr":
        return []
    label = t("herdr 当前 workspace 新标签", "new tab in the current herdr workspace")
    if not installed:
        label += t(" (当前未安装)", " (not currently installed)")
    return [("herdr", label)]


def edit_launcher(config: dict[str, Any]) -> None:
    prompt = t("kanban start 使用哪种启动方式?", "How should kanban start launch tasks?")
    foreground = ("foreground", t("当前终端前台运行", "foreground in this terminal"))
    if os.name == "nt":
        console = (
            "console",
            t("Windows 独立控制台窗口", "separate Windows console"),
        )
        config["launcher"] = ask_choice(
            prompt,
            [console, foreground],
            config["launcher"],
        )
        return
    if shutil.which("tmux"):
        config["launcher"] = ask_choice(
            prompt,
            [auto_launcher_choice(), *tmux_launcher_choices(), *herdr_launcher_choices(config), foreground],
            config["launcher"],
        )
        return

    choices = [auto_launcher_choice()]
    unavailable = t(" (当前未安装)", " (not currently installed)")
    for value, label in tmux_launcher_choices():
        if config["launcher"] == value:
            choices.append((value, label + unavailable))
    choices.extend(herdr_launcher_choices(config))
    choices.extend(
        (
            foreground,
            ("install-tmux", t("安装 tmux 并使用新窗口", "install tmux and use a new window")),
        )
    )
    selected = ask_choice(
        prompt,
        choices,
        config["launcher"],
    )
    if selected == "install-tmux":
        if install_tmux():
            config["launcher"] = ask_choice(
                t("tmux 已就绪, 用哪种 tmux 启动方式?", "tmux is ready; which tmux mode should be used?"),
                tmux_launcher_choices(),
                config["launcher"],
            )
    else:
        config["launcher"] = selected


def print_welcome_menu(config: dict[str, Any]) -> None:
    print(f"\n{color('1;36', t('当前配置', 'Current configuration'))}", file=sys.stderr)
    print(f"  1. {t('执行 Agent', 'Execution Agent')}: {config['kanban_agent']}", file=sys.stderr)
    for index, role in enumerate(REVIEW_ROLES, 2):
        print(f"  {index}. {role} Reviewer: {config['reviewers'][role]}", file=sys.stderr)
    print(f"  6. {t('启动方式', 'Launcher')}: {config['launcher']}", file=sys.stderr)
    print(f"  7. {t('模型与推理档位', 'Models and reasoning efforts')}", file=sys.stderr)
    kanban_agent = config["kanban_agent"]
    kanban_entry = config["models"]["kanban"][kanban_agent]
    kanban_model = kanban_entry["model"] or t("(CLI 默认)", "(CLI default)")
    print(
        f"     kanban {kanban_agent}: {kanban_model}"
        f" ({t('大', 'large')} {kanban_entry['large_effort']} / {t('小', 'small')} {kanban_entry['small_effort']})",
        file=sys.stderr,
    )
    for reviewer in dict.fromkeys(config["reviewers"].values()):
        entry = config["models"]["review"][reviewer]
        model = entry["model"] or t("(CLI 默认)", "(CLI default)")
        print(f"     review {reviewer}: {model} ({entry['effort']})", file=sys.stderr)
    memory = t("启用", "enabled") if config["memsearch"]["enabled"] else t("未启用", "disabled")
    print(f"  8. MemSearch: {memory}", file=sys.stderr)
    print(
        f"  9. {t('审核环节', 'Review stages')}: {format_review_stages_summary(config['review_stages'])}",
        file=sys.stderr,
    )
    print(
        f"  10. {t('默认语言', 'Default language')}: {format_language_summary(config['language'])}",
        file=sys.stderr,
    )
    print(t("  直接回车保存当前配置; 输入 q 退出且不保存.", "  Press Enter to save; enter q to quit without saving."), file=sys.stderr)


def ask_welcome_action(config: dict[str, Any]) -> str:
    while True:
        print_welcome_menu(config)
        print(
            t(
                "请选择要修改的项目 [1-10], 直接回车保存, q 取消: ",
                "Choose an item to change [1-10], press Enter to save, or q to cancel: ",
            ),
            end="",
            file=sys.stderr,
            flush=True,
        )
        answer = sys.stdin.readline()
        if not answer:
            raise OnevokeError(t("输入已结束, 配置未更改", "Input ended; configuration was not changed"))
        answer = answer.strip().lower()
        if not answer:
            return "save"
        if answer == "q":
            return "cancel"
        if answer.isdigit() and 1 <= int(answer) <= 10:
            return answer
        print(t("输入无效, 请重新选择.", "Invalid input; choose again."), file=sys.stderr)


def configure_welcome(existing: dict[str, Any], *, config_valid: bool) -> dict[str, Any]:
    agents = find_agents()
    for name, state in agents.items():
        if state["path"] and not agent_usable(state):
            warning(
                t(
                    f"{AGENT_LABELS[name]} 的 --version 失败, 不可作为新选择: {state['path']}",
                    f"{AGENT_LABELS[name]} --version failed; unavailable as a new choice: {state['path']}",
                )
            )
    execution_choices = [
        (name, f"{AGENT_LABELS[name]} ({state['version']})")
        for name, state in agents.items()
        if agent_usable(state)
    ]
    if not execution_choices and not existing["welcome_complete"]:
        raise OnevokeError(
            t(
                "没有发现可用的 Agent (--version 须成功). 请先安装 Codex、Claude 或 Grok.",
                "No usable Agent found (--version must succeed). Install Codex, Claude, or Grok first.",
            )
        )
    review_choices = [
        (name, f"{AGENT_LABELS[name]} ({agents[name]['version']})")
        for name in REVIEW_AGENTS
        if agent_usable(agents[name])
    ]
    if not review_choices and not existing["welcome_complete"]:
        raise OnevokeError(t("没有发现可用 Reviewer. 请安装 Codex、Claude 或 Grok.", "No usable Reviewer found. Install Codex, Claude, or Grok."))

    config = default_config()
    config["models"] = {
        section: {agent: dict(entry) for agent, entry in entries.items()}
        for section, entries in existing["models"].items()
    }
    config["kanban_agent"] = existing["kanban_agent"]
    if not existing["welcome_complete"] and not agent_usable(agents.get(config["kanban_agent"], {})):
        config["kanban_agent"] = execution_choices[0][0]
    for role in REVIEW_ROLES:
        previous = existing["reviewers"][role]
        config["reviewers"][role] = previous
        if not existing["welcome_complete"] and not agent_usable(agents.get(previous, {})):
            config["reviewers"][role] = review_choices[0][0]
    config["launcher"] = existing["launcher"]
    if os.name == "nt" and config["launcher"] not in ("console", "foreground") and not existing["welcome_complete"]:
        config["launcher"] = "console"
        warning(t(
            "原生 Windows 不支持 auto, tmux 和 herdr, 当前使用 console.",
            "Native Windows does not support auto, tmux, or herdr; using console.",
        ))
    elif config["launcher"].startswith("tmux") and not shutil.which("tmux") and not existing["welcome_complete"]:
        config["launcher"] = "foreground"
        warning(
            t(
                "未安装 tmux, 当前使用 foreground; 可从启动方式菜单选择安装.",
                "tmux is not installed; using foreground. The launcher menu can install it.",
            )
        )
    elif config["launcher"] == "herdr" and not shutil.which("herdr") and not existing["welcome_complete"]:
        config["launcher"] = "tmux" if shutil.which("tmux") else "foreground"
        warning(
            t(
                f"未安装 herdr, 当前使用 {config['launcher']}.",
                f"herdr is not installed; using {config['launcher']}.",
            )
        )
    config["memsearch"]["enabled"] = existing["memsearch"]["enabled"]
    config["review_stages"] = dict(existing["review_stages"])
    if config_valid:
        stored_language = configured_language()
        config["language"] = stored_language if stored_language else resolve_language()
    else:
        config["language"] = resolve_language()
    bind_config_language(config)

    while True:
        action = ask_welcome_action(config)
        if action == "save":
            break
        if action == "cancel":
            raise OnevokeError(t("用户取消, 配置未更改", "Cancelled; configuration was not changed"))
        if action == "1":
            config["kanban_agent"] = ask_choice(
                t("kanban 默认用哪个 Agent 执行任务?", "Which Agent should kanban use by default?"),
                choices_with_current(execution_choices, config["kanban_agent"]),
                config["kanban_agent"],
            )
        elif action in ("2", "3", "4", "5"):
            role = REVIEW_ROLES[int(action) - 2]
            config["reviewers"][role] = ask_choice(
                t(f"{role} 使用哪个 Reviewer?", f"Which Reviewer should {role} use?"),
                choices_with_current(review_choices, config["reviewers"][role]),
                config["reviewers"][role],
            )
        elif action == "6":
            edit_launcher(config)
        elif action == "7":
            edit_models(config)
        elif action == "8":
            memory_agent = config["kanban_agent"] if config["kanban_agent"] in ("codex", "claude") else None
            enabled = ask_yes_no(t("使用 MemSearch?", "Use MemSearch?"), config["memsearch"]["enabled"])
            if os.name == "nt" and enabled:
                warning(t(
                    "MemSearch 上游安装器当前需要 Bash, 原生 Windows 暂不启用该集成.",
                    "The upstream MemSearch installer currently requires Bash; this integration is not enabled on native Windows yet.",
                ))
                continue
            if enabled and not config["memsearch"]["enabled"]:
                if memory_agent is None:
                    warning(t("当前执行 Agent 不支持 MemSearch 集成.", "The current execution Agent does not support MemSearch integration."))
                    continue
                install_memsearch_for(memory_agent)
            config["memsearch"]["enabled"] = enabled
        elif action == "9":
            edit_review_stages(config)
        elif action == "10":
            edit_language(config)

    selected_agent = config["kanban_agent"]
    entry = rules_entry()
    integrated, detail = rules_integration(selected_agent)
    if integrated:
        success(t(f"{AGENT_LABELS[selected_agent]} 已接入 Onevoke 规则: {detail}", f"{AGENT_LABELS[selected_agent]} is connected to Onevoke rules: {detail}"))
    else:
        warning(t(f"{AGENT_LABELS[selected_agent]} 尚未接入 Onevoke 规则: {detail}", f"{AGENT_LABELS[selected_agent]} is not connected to Onevoke rules: {detail}"))
        print(t(
            f"请按 README 的接入章节把规则入口接到 {entry}, welcome 不会覆盖 Agent 规则文件.",
            f"Follow the README integration section and point the rules entry to {entry}; welcome will not overwrite Agent rules files.",
        ), file=sys.stderr)
    print(
        color("1;33", t(
            "注意: kanban start 会使用 Agent 的免确认模式执行已确认任务.",
            "Note: kanban start uses the Agent's no-confirmation mode for confirmed tasks.",
        )),
        file=sys.stderr,
    )
    config["welcome_complete"] = True
    return config


def command_welcome(reset: bool) -> int:
    print_doctor()
    config_valid = False
    try:
        existing = load_config()
        config_valid = config_path().is_file()
    except ConfigError as error:
        warning(str(error))
        if not reset:
            print(t("使用 onevoke welcome --reset 重新创建配置.", "Run onevoke welcome --reset to recreate the configuration."), file=sys.stderr)
            return 1
        existing = default_config()

    if existing["welcome_complete"] and not reset:
        success(t(f"welcome 已完成: {config_path()}", f"welcome is complete: {config_path()}"))
        print(t("如需重新选择, 运行 onevoke welcome --reset.", "Run onevoke welcome --reset to choose again."), file=sys.stderr)
        return 0
    if not (sys.stdin.isatty() and sys.stderr.isatty()):
        warning(t("当前没有交互终端, welcome 未完成.", "No interactive terminal is available; welcome is incomplete."))
        print(t("请在终端运行 onevoke welcome.", "Run onevoke welcome in a terminal."), file=sys.stderr)
        return 0
    try:
        configured = configure_welcome(existing, config_valid=config_valid)
        path = save_config(configured)
    except (OnevokeError, ConfigError, OSError, UnicodeError) as error:
        warning(str(error))
        return 1
    success(t(f"配置已保存: {path}", f"Configuration saved: {path}"))
    return 0


def command_review(arguments: list[str]) -> NoReturn:
    if len(arguments) < 5 or len(arguments) > 6:
        raise OnevokeError(
            t(
                "用法: onevoke review <worktree> <base> <commit> <role> <task> [context]",
                "usage: onevoke review <worktree> <base> <commit> <role> <task> [context]",
            )
        )
    role = arguments[3]
    aliases = {name.lower(): name for name in REVIEW_ROLES}
    aliases["codesecurityanalyst"] = "CSA"
    normalized = aliases.get(role.lower())
    if not normalized:
        raise OnevokeError(t(f"不支持的 Reviewer 角色: {role}", f"Unsupported Reviewer role: {role}"))
    config = effective_config(load_config())
    reviewer = config["reviewers"][normalized]
    arguments[3] = normalized
    gate = review_gate()
    if not gate:
        raise OnevokeError(review_gate_missing_message())
    if os.name == "nt":
        # Batch files do not expose an argv boundary: cmd.exe reparses `%*`, so
        # metacharacters such as &, |, %, ! and quotes can be altered or executed.
        # Programmatic dispatch therefore enters the canonical Python gate directly.
        raise SystemExit(
            subprocess.call(
                [sys.executable, "-B", "-X", "utf8", gate, reviewer, *arguments]
            )
        )
    os.execv(gate, [gate, reviewer, *arguments])


def print_config(config: dict[str, Any]) -> None:
    effective = effective_config(config)
    status = t("已完成", "complete") if config["welcome_complete"] else t("未完成", "incomplete")
    print(f"{t('引导', 'welcome')}: {status}")
    print(f"{t('看板 Agent', 'kanban agent')}: {effective['kanban_agent']}")
    print(f"{t('启动方式', 'launcher')}: {effective['launcher']}")
    kanban_entry = effective["models"]["kanban"][effective["kanban_agent"]]
    kanban_model = kanban_entry["model"] or t("(CLI 默认)", "(CLI default)")
    print(
        f"{t('看板模型', 'kanban model')}: {kanban_model}"
        f" ({t('大', 'large')} {kanban_entry['large_effort']} / {t('小', 'small')} {kanban_entry['small_effort']})"
    )
    for role in REVIEW_ROLES:
        reviewer = effective["reviewers"][role]
        review_entry = effective["models"]["review"][reviewer]
        model = review_entry["model"] or t("(CLI 默认)", "(CLI default)")
        print(f"{role}: {reviewer} {model} ({review_entry['effort']})")
    stages = " ".join(f"{role}={effective['review_stages'][role]}" for role in REVIEW_ROLES)
    print(f"{t('审核环节', 'review stages')}: {stages}")
    stored_language = configured_language()
    language = stored_language if stored_language else resolve_language()
    print(f"{t('默认语言', 'language')}: {format_language_summary(language)}")
    print(f"MemSearch: {t('启用', 'enabled') if effective['memsearch']['enabled'] else t('未启用', 'disabled')}")


def parser() -> argparse.ArgumentParser:
    result = LocalizedArgumentParser(prog="onevoke", description=t("Onevoke 配置与诊断", "Onevoke configuration and diagnostics"))
    result.add_argument("--lang", choices=LANGUAGES, help=t("覆盖输出语言", "override the output language"))
    commands = result.add_subparsers(dest="command", required=True)
    welcome = commands.add_parser("welcome", help=t("检查环境并完成首次配置", "check the environment and complete initial setup"))
    welcome.add_argument("--reset", action="store_true", help=t("重新打开配置菜单", "open the configuration menu again"))
    commands.add_parser("doctor", help=t("检查 Onevoke 环境", "check the Onevoke environment"))
    config = commands.add_parser("config", help=t("输出当前配置", "print the current configuration"))
    config.add_argument("--json", action="store_true", help=t("以 JSON 输出", "output JSON"))
    review = commands.add_parser("review", help=t("按配置选择 Reviewer", "select a Reviewer from configuration"))
    review.add_argument("arguments", nargs=argparse.REMAINDER, metavar=t("参数", "arguments"))
    return result


def main() -> int:
    args = parser().parse_args()
    try:
        if args.command == "welcome":
            return command_welcome(args.reset)
        if args.command == "doctor":
            return 0 if print_doctor() else 1
        if args.command == "config":
            config = load_config()
            if args.json:
                print(json.dumps(config, ensure_ascii=False, indent=2))
            else:
                print_config(config)
            return 0
        if args.command == "review":
            command_review(args.arguments)
        return 0
    except KeyboardInterrupt:
        print(t("\nonevoke: 用户取消, 配置未更改", "\nonevoke: cancelled; configuration was not changed"), file=sys.stderr)
        return 130
    except (OnevokeError, ConfigError, OSError, UnicodeError) as error:
        print(f"onevoke: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
