#!/usr/bin/env python3

from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Any, NoReturn

from onevoke_config import (
    ARGPARSE_ZH,
    EXECUTION_AGENTS,
    LANGUAGES,
    REVIEW_AGENTS,
    REVIEW_ROLES,
    ConfigError,
    LocalizedArgumentParser,
    apply_language_argument,
    config_path,
    default_config,
    effective_config,
    language_text,
    load_config,
    save_config,
)

apply_language_argument(sys.argv[1:])
t = language_text
argparse._ = lambda message: t(ARGPARSE_ZH.get(message, message), message)


COMMANDS = (
    "onevoke",
    "kanban",
    "codex-review.sh",
    "grok-review.sh",
    "merge-worktree-memory.py",
)
AGENT_LABELS = {"codex": "Codex", "claude": "Claude", "grok": "Grok"}
MEMSEARCH_PACKAGE = "memsearch[onnx]"
MEMSEARCH_REPOSITORY = "https://github.com/zilliztech/memsearch.git"
MEMSEARCH_VERSION_RE = re.compile(r"[0-9]+\.[0-9]+\.[0-9]+")
MEMSEARCH_VERSION_OUTPUT = re.compile(
    rf"\A\s*memsearch,\s+version\s+({MEMSEARCH_VERSION_RE.pattern})\s*\Z",
    flags=re.IGNORECASE,
)
MEMSEARCH_HOOKS = {
    "SessionStart": "session-start.sh",
    "UserPromptSubmit": "user-prompt-submit.sh",
    "Stop": "stop.sh",
}
MEMSEARCH_CODEX_FILES = (
    Path(".codex/hooks.json"),
    Path(".codex/hooks.json.bak"),
    Path(".codex/config.toml"),
)
MEMSEARCH_SKILLS = ("memory-recall", "memory-config", "memory-to-skill")


class OnevokeError(Exception):
    pass


class PathReplacement:
    def __init__(self, target: Path, backup: Path, had_target: bool) -> None:
        self.target = target
        self.backup = backup
        self.had_target = had_target


def color(code: str, text: str) -> str:
    if os.environ.get("NO_COLOR") or not sys.stderr.isatty():
        return text
    return f"\033[{code}m{text}\033[0m"


def warning(text: str) -> None:
    print(color("1;31", f"[!] {text}"), file=sys.stderr)


def success(text: str) -> None:
    print(color("1;32", f"[OK] {text}"), file=sys.stderr)


def find_commands() -> dict[str, str | None]:
    return {name: shutil.which(name) for name in COMMANDS}


VERSION_FAILED = t("版本检查失败", "version check failed")
TMUX_SESSION_HINT = "tmux new -A -s onevoke"


def agent_version(command: str) -> str:
    try:
        result = subprocess.run(
            [command, "--version"],
            text=True,
            capture_output=True,
            check=False,
            timeout=5,
        )
    except (OSError, subprocess.TimeoutExpired):
        return VERSION_FAILED
    output = (result.stdout or result.stderr).strip().splitlines()
    return output[0] if result.returncode == 0 and output else VERSION_FAILED


def agent_usable(state: dict[str, str | bool | None]) -> bool:
    """PATH 上有二进制且 --version 成功才算可用."""
    return bool(state.get("path")) and state.get("version") not in (None, VERSION_FAILED)


def find_agents() -> dict[str, dict[str, str | bool | None]]:
    agents: dict[str, dict[str, str | bool | None]] = {}
    for name in EXECUTION_AGENTS:
        command = shutil.which(name)
        agents[name] = {
            "path": command,
            "version": agent_version(command) if command else None,
            "execution": True,
            "review": name in REVIEW_AGENTS,
            "memsearch": name in ("codex", "claude"),
        }
    return agents


def _strip_comments_and_fences(text: str) -> str:
    """去掉 HTML 注释和 fenced code, 避免注释/示例里的标记造成假接入.

    未闭合的 `<!--` 一直删到文件末尾, 防止注释残片被当正文.
    """
    without_comments = re.sub(r"<!--.*?-->", "", text, flags=re.DOTALL)
    without_comments = re.sub(r"<!--.*\Z", "", without_comments, flags=re.DOTALL)
    lines: list[str] = []
    fence: str | None = None
    fence_len = 0
    for raw in without_comments.splitlines():
        stripped = raw.lstrip()
        if fence is None:
            for marker in ("```", "~~~"):
                if stripped.startswith(marker):
                    fence = marker[0]
                    fence_len = len(stripped) - len(stripped.lstrip(marker[0]))
                    break
            else:
                lines.append(raw)
            continue
        if stripped.startswith(fence * 3):
            closing = len(stripped) - len(stripped.lstrip(fence))
            if closing >= fence_len:
                fence = None
                fence_len = 0
    return "\n".join(lines)


_NEGATION_RE = re.compile(
    r"(禁用|废弃|停用|不要遵守|勿遵守|不遵守|不要使用|不使用|请勿使用|"
    r"未导入|尚未导入|不再生效|已失效|请忽略|"
    r"do not follow|do not use|disabled|deprecated|\bignore\b)",
    flags=re.IGNORECASE,
)


def _candidate_context(
    text: str, start: int, end: int, *, include_match: bool = True
) -> str:
    """取候选语境: 同段 + 前序/后序各最多 40 行, 捕捉前后否定说明.

    include_match=False 时不把候选正文本身计入语境, 避免合并式入口
    (如 ONEVOKE-AGENTS.md 内的「不使用其他长期分支模型」) 被自身否定词误伤.
    """
    before = text.rfind("\n\n", 0, start)
    after = text.find("\n\n", end)
    left = 0 if before < 0 else before + 2
    right = len(text) if after < 0 else after
    heading_before = text.rfind("\n#", left, start)
    if heading_before >= left:
        left = heading_before + 1
    heading_after = text.find("\n#", end, right)
    if heading_after >= 0:
        right = heading_after
    if include_match:
        section = text[left:right]
    else:
        section = text[left:start] + text[end:right]
    prior_lines = text[:start].splitlines()[-40:]
    following_lines = text[end:].splitlines()[:40]
    return "\n".join([section, *prior_lines, *following_lines])


def _claude_rules_import_present(text: str, entry: Path) -> bool:
    """Claude 只认独立行的 @ 导入, 且所在段落不得是否定/废弃语境."""
    candidates: set[str] = {"~/.agents/ONEVOKE-AGENTS.md"}
    try:
        resolved = entry.expanduser().resolve()
        candidates.add(str(entry))
        candidates.add(str(resolved))
        candidates.add(str(resolved).replace(str(Path.home()), "~", 1))
    except OSError:
        candidates.add(str(entry))
    body = _strip_comments_and_fences(text)
    offset = 0
    for raw in body.splitlines(keepends=True):
        line = raw.strip()
        line_start = offset
        offset += len(raw)
        if not line or line.startswith("#"):
            continue
        match = re.fullmatch(r"@([^\s]+)", line)
        if not match:
            continue
        ref = match.group(1).strip()
        accepted = ref in candidates
        if not accepted:
            try:
                accepted = (
                    Path(ref).expanduser().resolve() == entry.expanduser().resolve()
                )
            except OSError:
                accepted = False
        if not accepted:
            continue
        context = _candidate_context(body, line_start, offset)
        if _NEGATION_RE.search(context):
            continue
        return True
    return False


def _merged_rules_present(text: str, entry: Path) -> bool:
    """Codex/Grok 合并文件必须包含当前安装入口全文, 且外层语境不得是否定/废弃.

    入口正文自身可能含「不使用」等词 (见 ONEVOKE-AGENTS 分支模型条款),
    否定检查只看正文前后语境, 不扫描 expected 本身.
    """
    try:
        expected = entry.read_text(encoding="utf-8").strip()
    except (OSError, UnicodeError):
        return False
    if not expected:
        return False
    body = _strip_comments_and_fences(text)
    index = body.find(expected)
    if index < 0:
        return False
    context = _candidate_context(
        body, index, index + len(expected), include_match=False
    )
    if _NEGATION_RE.search(context):
        return False
    return True


def rules_integration(agent: str) -> tuple[bool, str]:
    entry = Path.home() / ".agents" / "ONEVOKE-AGENTS.md"
    if agent == "codex":
        target = Path.home() / ".codex" / "AGENTS.md"
    elif agent == "claude":
        target = Path.home() / ".claude" / "CLAUDE.md"
    else:
        target = Path.home() / ".grok" / "AGENTS.md"
    if not target.exists() and not target.is_symlink():
        return False, t(f"未发现 {target}", f"not found: {target}")
    try:
        if target.is_symlink() and target.resolve() == entry.resolve():
            return True, str(target)
        text = target.read_text(encoding="utf-8")
    except (OSError, UnicodeError):
        return False, t(f"无法读取 {target}", f"cannot read: {target}")
    if agent == "claude":
        integrated = _claude_rules_import_present(text, entry)
    else:
        integrated = _merged_rules_present(text, entry)
    if integrated:
        return True, str(target)
    return False, t(
        f"{target} 未导入或合并 ONEVOKE-AGENTS.md",
        f"{target} does not import or include ONEVOKE-AGENTS.md",
    )


def read_json_file(path: Path) -> object | None:
    if not path.is_file():
        return None
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError):
        return None


def memsearch_cli_state() -> tuple[str | None, str | None, bool]:
    command = shutil.which("memsearch")
    if not command:
        return None, None, False
    try:
        result = subprocess.run(
            [command, "--version"],
            text=True,
            capture_output=True,
            check=False,
            timeout=5,
        )
    except (OSError, subprocess.TimeoutExpired):
        return command, None, False
    output = "\n".join(part for part in (result.stdout, result.stderr) if part)
    match = MEMSEARCH_VERSION_OUTPUT.fullmatch(output)
    version = match.group(1) if result.returncode == 0 and match else None
    return command, version, version is not None


def resolve_hook_script(command: object, expected: str, root: Path | None) -> Path | None:
    if not isinstance(command, str):
        return None
    try:
        tokens = shlex.split(command)
    except ValueError:
        return None
    if len(tokens) != 2 or tokens[0] != "bash":
        return None
    token = tokens[1]
    if root is not None:
        token = token.replace("${CLAUDE_PLUGIN_ROOT}", str(root))
    if "$" in token:
        return None
    candidate = Path(token).expanduser()
    if (
        candidate.is_absolute()
        and candidate.name == expected
        and candidate.is_file()
        and os.access(candidate, os.X_OK)
    ):
        return candidate.resolve()
    return None


def hooks_directory(raw: object, root: Path | None = None) -> Path | None:
    if not isinstance(raw, dict) or not isinstance(raw.get("hooks"), dict):
        return None
    resolved: list[Path] = []
    hook_events = raw["hooks"]
    for event, expected in MEMSEARCH_HOOKS.items():
        registrations = hook_events.get(event)
        if not isinstance(registrations, list):
            return None
        script = None
        for registration in registrations:
            if not isinstance(registration, dict):
                continue
            commands = registration.get("hooks")
            if not isinstance(commands, list):
                continue
            for hook in commands:
                if not isinstance(hook, dict) or hook.get("type") != "command":
                    continue
                script = resolve_hook_script(hook.get("command"), expected, root)
                if script:
                    break
            if script:
                break
        if not script:
            return None
        resolved.append(script)
    directories = {script.parent for script in resolved}
    return resolved[0].parent if len(directories) == 1 else None


def claude_plugin_identified(root: Path) -> bool:
    if root.is_symlink() or not root.is_dir():
        return False
    required_files = (
        root / ".claude-plugin" / "plugin.json",
        root / "hooks" / "hooks.json",
        root / "hooks" / "common.sh",
    )
    if any(path.is_symlink() or not path.is_file() for path in required_files):
        return False
    try:
        for entry in root.rglob("*"):
            if entry.is_symlink() or not (entry.is_dir() or entry.is_file()):
                return False
    except OSError:
        return False
    return True


def plugin_matches_git_tree(repository: Path, revision: str, installed: Path) -> bool:
    prefix = Path("plugins/claude-code")
    git_environment = os.environ.copy()
    git_environment["GIT_NO_REPLACE_OBJECTS"] = "1"
    try:
        tree = subprocess.run(
            [
                "git",
                "-C",
                str(repository),
                "ls-tree",
                "-rz",
                "--full-tree",
                revision,
                "--",
                str(prefix),
            ],
            capture_output=True,
            check=False,
            env=git_environment,
        )
    except (OSError, subprocess.SubprocessError):
        return False
    if tree.returncode != 0:
        return False

    expected: dict[Path, tuple[bytes, bool]] = {}
    try:
        for raw_entry in tree.stdout.split(b"\0"):
            if not raw_entry:
                continue
            metadata, raw_path = raw_entry.split(b"\t", 1)
            mode, object_type, object_id = metadata.split(b" ", 2)
            if object_type != b"blob" or mode not in (b"100644", b"100755"):
                return False
            path = Path(raw_path.decode("utf-8"))
            relative = path.relative_to(prefix)
            blob = subprocess.run(
                [
                    "git",
                    "-C",
                    str(repository),
                    "cat-file",
                    "blob",
                    object_id.decode("ascii"),
                ],
                capture_output=True,
                check=False,
                env=git_environment,
            )
            if blob.returncode != 0:
                return False
            expected[relative] = (blob.stdout, mode == b"100755")
    except (OSError, UnicodeError, ValueError, subprocess.SubprocessError):
        return False

    actual: dict[Path, tuple[bytes, bool]] = {}
    if installed.is_symlink() or not installed.is_dir():
        return False
    try:
        for entry in installed.rglob("*"):
            relative = entry.relative_to(installed)
            if relative.parts[0] == ".in_use":
                continue
            if entry.is_symlink():
                return False
            if entry.is_file():
                actual[relative] = (
                    entry.read_bytes(),
                    bool(entry.stat().st_mode & 0o111),
                )
            elif not entry.is_dir():
                return False
    except OSError:
        return False
    return actual == expected


def path_components_are_real(base: Path, target: Path) -> bool:
    try:
        relative = target.relative_to(base)
        current = base
        if current.is_symlink():
            return False
        for part in relative.parts:
            current /= part
            if current.is_symlink():
                return False
    except (OSError, ValueError):
        return False
    return True


def git_revision(source: Path) -> str | None:
    try:
        result = subprocess.run(
            ["git", "-C", str(source), "rev-parse", "HEAD"],
            text=True,
            capture_output=True,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    revision = result.stdout.strip()
    if result.returncode != 0 or not re.fullmatch(r"[0-9a-f]{40}", revision):
        return None
    return revision


def codex_memsearch_ready() -> bool:
    hooks_file = Path.home() / ".codex" / "hooks.json"
    hooks_dir = hooks_directory(read_json_file(hooks_file))
    if (
        hooks_dir is None
        or hooks_dir.name != "hooks"
        or hooks_dir.parent.name != "codex"
        or hooks_dir.parent.parent.name != "plugins"
    ):
        return False
    source = hooks_dir.parent.parent.parent
    return verify_memsearch_source(source, quiet=True)


def claude_memsearch_ready() -> bool:
    claude = Path.home() / ".claude"
    plugins_root = claude / "plugins"
    marketplaces = read_json_file(claude / "plugins" / "known_marketplaces.json")
    if not isinstance(marketplaces, dict):
        return False
    marketplace = marketplaces.get("memsearch-plugins")
    if not isinstance(marketplace, dict) or not isinstance(
        marketplace.get("source"), dict
    ):
        return False
    marketplace_source = marketplace["source"]
    if (
        marketplace_source.get("source") != "github"
        or marketplace_source.get("repo") != "zilliztech/memsearch"
    ):
        return False
    expected_marketplace = claude / "plugins" / "marketplaces" / "memsearch-plugins"
    install_location = marketplace.get("installLocation")
    if (
        not isinstance(install_location, str)
        or Path(install_location).expanduser().absolute() != expected_marketplace
        or not path_components_are_real(plugins_root, expected_marketplace)
        or not verify_memsearch_source(expected_marketplace, quiet=True)
    ):
        return False
    marketplace_revision = git_revision(expected_marketplace)
    if marketplace_revision is None:
        return False

    settings = read_json_file(claude / "settings.json")
    if not isinstance(settings, dict):
        return False
    enabled = settings.get("enabledPlugins")
    if not isinstance(enabled, dict) or enabled.get("memsearch@memsearch-plugins") is not True:
        return False

    installed = read_json_file(claude / "plugins" / "installed_plugins.json")
    if not isinstance(installed, dict) or not isinstance(installed.get("plugins"), dict):
        return False
    records = installed["plugins"].get("memsearch@memsearch-plugins")
    if not isinstance(records, list):
        return False
    for record in records:
        if not isinstance(record, dict) or not isinstance(record.get("installPath"), str):
            continue
        record_version = record.get("version")
        if (
            not isinstance(record_version, str)
            or not MEMSEARCH_VERSION_RE.fullmatch(record_version)
            or record.get("gitCommitSha") != marketplace_revision
        ):
            continue
        expected_root = (
            claude
            / "plugins"
            / "cache"
            / "memsearch-plugins"
            / "memsearch"
            / record_version
        )
        root = Path(record["installPath"]).expanduser().absolute()
        if root != expected_root or not path_components_are_real(plugins_root, root):
            continue
        manifest = read_json_file(root / ".claude-plugin" / "plugin.json")
        if (
            not isinstance(manifest, dict)
            or manifest.get("name") != "memsearch"
            or manifest.get("version") != record_version
        ):
            continue
        hooks_dir = hooks_directory(read_json_file(root / "hooks" / "hooks.json"), root)
        if (
            hooks_dir == (root / "hooks").resolve()
            and claude_plugin_identified(root)
            and plugin_matches_git_tree(expected_marketplace, marketplace_revision, root)
        ):
            return True
    return False


def memsearch_state() -> dict[str, str | bool | None]:
    cli_path, cli_version, cli_ready = memsearch_cli_state()
    return {
        "cli": cli_path is not None,
        "cli_path": cli_path,
        "cli_version": cli_version,
        "cli_ready": cli_ready,
        "codex_plugin": codex_memsearch_ready(),
        "claude_plugin": claude_memsearch_ready(),
    }


def print_doctor() -> bool:
    healthy = True
    print(t("Onevoke 环境检查", "Onevoke environment check"), file=sys.stderr)
    for name, path in find_commands().items():
        if path:
            success(f"{name}: {path}")
        else:
            healthy = False
            warning(t(
                f"{name} 不在 PATH. 请把 ~/.local/bin 加入 PATH 后重新打开 shell.",
                f"{name} is not in PATH. Add ~/.local/bin to PATH and reopen your shell.",
            ))
    tmux = shutil.which("tmux")
    if tmux:
        success(f"tmux: {tmux}")
        if not os.environ.get("TMUX"):
            print(
                t(
                    f"[-] tmux: 已安装但当前不在 session. 启动: {TMUX_SESSION_HINT}",
                    f"[-] tmux: installed, but not in a session. Start one with: {TMUX_SESSION_HINT}",
                ),
                file=sys.stderr,
            )
    else:
        print(t(
            "[-] tmux: 未安装; 可在 welcome 中选择前台启动模式",
            "[-] tmux: not installed; welcome can select foreground mode",
        ), file=sys.stderr)

    agents = find_agents()
    print(t("\nAgent 能力:", "\nAgent capabilities:"), file=sys.stderr)
    for name, state in agents.items():
        if agent_usable(state):
            capabilities = [t("执行", "execution")]
            if state["review"]:
                capabilities.append(t("审核", "review"))
            if state["memsearch"]:
                capabilities.append("MemSearch")
            success(
                f"{AGENT_LABELS[name]}: {state['version']} "
                f"({', '.join(capabilities)}; {t('认证未验证', 'authentication not verified')})"
            )
        elif state["path"]:
            healthy = False
            warning(
                t(
                    f"{AGENT_LABELS[name]}: 位于 {state['path']}, 但 --version 失败; 不视为可用, 也不能在 welcome 中选择.",
                    f"{AGENT_LABELS[name]}: found at {state['path']}, but --version failed; it is unavailable and cannot be selected in welcome.",
                )
            )
        else:
            print(t(f"[-] {AGENT_LABELS[name]}: 未安装", f"[-] {AGENT_LABELS[name]}: not installed"), file=sys.stderr)
    if not any(agent_usable(state) for state in agents.values()):
        healthy = False
        warning(t("没有发现可执行 Agent; kanban 无法启动任务.", "No executable Agent found; kanban cannot start tasks."))
    if not any(agent_usable(agents[name]) for name in REVIEW_AGENTS):
        healthy = False
        warning(t("没有发现 Reviewer; 审核流程无法运行.", "No Reviewer found; reviews cannot run."))

    memory = memsearch_state()
    print("\nMemSearch:", file=sys.stderr)
    if memory["cli_ready"]:
        print(f"  CLI: {memory['cli_version']} ({t('可用', 'available')})", file=sys.stderr)
    elif memory["cli"]:
        healthy = False
        warning(
            t(
                f"MemSearch CLI 无法正常报告版本: {memory['cli_version'] or '无法识别'}",
                f"MemSearch CLI could not report a valid version: {memory['cli_version'] or 'unknown'}",
            )
        )
    else:
        print(t("  CLI: 未安装", "  CLI: not installed"), file=sys.stderr)
    print(
        f"  {t('Codex 插件', 'Codex plugin')}: {t('已接入', 'connected') if memory['codex_plugin'] else t('未接入', 'not connected')}",
        file=sys.stderr,
    )
    print(
        f"  {t('Claude 插件', 'Claude plugin')}: {t('已接入', 'connected') if memory['claude_plugin'] else t('未接入', 'not connected')}",
        file=sys.stderr,
    )
    try:
        config = load_config()
    except ConfigError as error:
        warning(str(error))
        healthy = False
    else:
        if config["welcome_complete"]:
            success(t(f"配置: {config_path()}", f"config: {config_path()}"))
        else:
            print(t(f"[-] 配置: 尚未完成 ({config_path()})", f"[-] config: incomplete ({config_path()})"), file=sys.stderr)
        # 无论 welcome 是否完成, 都校验 effective_config 指向的实际资源.
        healthy = validate_configured_resources(config, agents, memory) and healthy
    return healthy


def validate_configured_resources(
    config: dict[str, Any],
    agents: dict[str, dict[str, str | bool | None]],
    memory: dict[str, str | bool | None],
) -> bool:
    """对生效配置逐项核对执行 Agent、Reviewer、wrapper 和 launcher."""
    healthy = True
    effective = effective_config(config)
    selected_agent = effective["kanban_agent"]
    selected_state = agents.get(selected_agent, {})
    if not agent_usable(selected_state):
        healthy = False
        warning(
            t(
                f"配置的执行 Agent 不可用: {selected_agent}; 请安装后重新运行 onevoke welcome --reset.",
                f"Configured execution Agent is unavailable: {selected_agent}; install it, then run onevoke welcome --reset.",
            )
        )

    for role in REVIEW_ROLES:
        reviewer = effective["reviewers"][role]
        reviewer_state = agents.get(reviewer, {})
        if not agent_usable(reviewer_state):
            healthy = False
            warning(
                t(
                    f"配置的 {role} Reviewer 不可用: {reviewer}; 请安装后重新运行 onevoke welcome --reset.",
                    f"Configured {role} Reviewer is unavailable: {reviewer}; install it, then run onevoke welcome --reset.",
                )
            )
            continue
        wrapper_name = f"{reviewer}-review.sh"
        if not shutil.which(wrapper_name):
            healthy = False
            warning(
                t(
                    f"配置的 {role} wrapper 不在 PATH: {wrapper_name}; 请把 ~/.local/bin 加入 PATH 或重新安装 Onevoke.",
                    f"Configured {role} wrapper is not in PATH: {wrapper_name}; add ~/.local/bin to PATH or reinstall Onevoke.",
                )
            )

    launcher = effective["launcher"]
    if launcher == "tmux":
        if not shutil.which("tmux"):
            healthy = False
            warning(
                t(
                    "配置的 launcher 是 tmux, 但 tmux 不在 PATH; 请安装 tmux 或运行 onevoke welcome --reset 改选 foreground.",
                    "The configured launcher is tmux, but tmux is not in PATH; install tmux or run onevoke welcome --reset and select foreground.",
                )
            )
        elif not os.environ.get("TMUX") and config.get("welcome_complete"):
            # 通用 tmux 段已给出唯一启动命令; 这里只在已完成配置时补充契约提示.
            print(
                t(
                    "[-] launcher=tmux 需要先进入上述 tmux session",
                    "[-] launcher=tmux requires entering the tmux session shown above",
                ),
                file=sys.stderr,
            )
    elif launcher == "foreground":
        # 仅在配置已完成时提示, 避免与通用 doctor 输出叠床架屋.
        if config.get("welcome_complete"):
            print(
                t(
                    "[-] launcher=foreground 需要交互终端 (stdin/stdout/stderr 均为 tty); 无 TTY 时改用 tmux 或在真实终端运行.",
                    "[-] launcher=foreground requires an interactive terminal (stdin/stdout/stderr must be TTYs); use tmux without a TTY or run in a real terminal.",
                ),
                file=sys.stderr,
            )

    memory_enabled = bool(
        memory["cli_ready"] and memory.get(f"{selected_agent}_plugin", False)
    )
    if effective["memsearch"]["enabled"] and not memory_enabled:
        healthy = False
        warning(
            t(
                "配置启用了 MemSearch, 但当前执行 Agent 的 CLI 或插件未就绪; 请重新运行 onevoke welcome --reset.",
                "MemSearch is enabled, but the current execution Agent's CLI or plugin is not ready; run onevoke welcome --reset.",
            )
        )
    return healthy


def ask_choice(prompt: str, choices: list[tuple[str, str]], default: str | None = None) -> str:
    if not choices:
        raise OnevokeError(t(f"没有可选项: {prompt}", f"No choices available: {prompt}"))
    while True:
        print(f"\n{color('1;36', prompt)}", file=sys.stderr)
        for index, (_, label) in enumerate(choices, 1):
            suffix = t(" (当前)", " (current)") if choices[index - 1][0] == default else ""
            print(f"  {index}. {label}{suffix}", file=sys.stderr)
        print(t(f"请选择 [1-{len(choices)}]: ", f"Choose [1-{len(choices)}]: "), end="", file=sys.stderr, flush=True)
        answer = sys.stdin.readline()
        if not answer:
            raise OnevokeError(t("输入已结束, 配置未更改", "Input ended; configuration was not changed"))
        answer = answer.strip()
        if answer.isdigit() and 1 <= int(answer) <= len(choices):
            return choices[int(answer) - 1][0]
        print(t("输入无效, 请重新选择.", "Invalid input; choose again."), file=sys.stderr)


def ask_yes_no(prompt: str, default: bool = False) -> bool:
    choices = [("yes", t("是", "Yes")), ("no", t("否", "No"))]
    selected = ask_choice(prompt, choices, "yes" if default else "no")
    return selected == "yes"


def verify_memsearch_source(source: Path, *, quiet: bool = False) -> bool:
    def reject(message: str) -> bool:
        if not quiet:
            warning(message)
        return False

    if source.is_symlink() or not source.is_dir():
        return reject(t("MemSearch 源码目录无效.", "The MemSearch source directory is invalid."))
    if not shutil.which("git"):
        return reject(t("未找到 git, 无法校验 MemSearch 源码.", "git was not found; cannot verify the MemSearch source."))
    remote = subprocess.run(
        ["git", "-C", str(source), "remote", "get-url", "origin"],
        text=True,
        capture_output=True,
        check=False,
    )
    remote_url = remote.stdout.strip()
    if remote.returncode != 0 or remote_url != MEMSEARCH_REPOSITORY:
        return reject(
            t(
                f"MemSearch 源码来源不是官方仓库: {remote_url or '无法读取'}",
                f"MemSearch source is not from the official repository: {remote_url or 'unreadable'}",
            )
        )
    status = subprocess.run(
        [
            "git",
            "-C",
            str(source),
            "status",
            "--porcelain=v1",
            "--untracked-files=all",
            "--ignore-submodules=none",
        ],
        text=True,
        capture_output=True,
        check=False,
    )
    if status.returncode != 0 or status.stdout:
        return reject(t("MemSearch 源码工作树不干净, 拒绝执行插件安装器.", "The MemSearch source worktree is dirty; refusing to run the plugin installer."))
    return True


def print_claude_memsearch_install() -> None:
    print("  /plugin marketplace add zilliztech/memsearch", file=sys.stderr)
    print("  /plugin marketplace update memsearch-plugins", file=sys.stderr)
    print("  /plugin install memsearch@memsearch-plugins", file=sys.stderr)


def print_memsearch_manual_install(agent: str | None = None) -> None:
    """提示用户自行安装 MemSearch; 失败时调用, 不阻断 welcome/工具包安装."""
    print(t(
        "请自行安装 MemSearch (不影响 Onevoke 其它配置与工具包安装):",
        "Install MemSearch manually (this does not affect other Onevoke configuration or tools):",
    ), file=sys.stderr)
    print(f"  uv tool install -U {MEMSEARCH_PACKAGE}", file=sys.stderr)
    if agent in (None, "codex"):
        print(
            f"  {t('Codex 插件', 'Codex plugin')}: git clone --depth 1 "
            f"{MEMSEARCH_REPOSITORY} "
            "&& bash memsearch/plugins/codex/scripts/install.sh",
            file=sys.stderr,
        )
    if agent in (None, "claude"):
        print(
            t("  Claude 插件 (在 Claude Code 内):", "  Claude plugin (in Claude Code):"),
            file=sys.stderr,
        )
        print_claude_memsearch_install()
    print(t("完成后可运行 onevoke doctor 查看接入状态.", "Run onevoke doctor afterward to check integration status."), file=sys.stderr)


def install_memsearch_cli() -> bool:
    """执行 CLI 安装命令. 以命令是否跑完为准; 异常与失败只返回 False, 不抛错."""
    try:
        command, version, _ = memsearch_cli_state()
        if command:
            print(
                t(
                    f"现有 MemSearch CLI 版本为 {version or '无法识别'}, 将升级到 PyPI 最新版.",
                    f"Current MemSearch CLI version is {version or 'unknown'}; upgrading to the latest PyPI release.",
                ),
                file=sys.stderr,
            )
        if not shutil.which("uv"):
            warning(t("未找到 uv, 无法自动安装 MemSearch CLI.", "uv was not found; cannot install the MemSearch CLI automatically."))
            return False
        print(
            t(
                f"即将通过 PyPI 安装最新版 {MEMSEARCH_PACKAGE}, 首次使用会下载 ONNX 模型.",
                f"Installing the latest {MEMSEARCH_PACKAGE} from PyPI; first use will download the ONNX model.",
            ),
            file=sys.stderr,
        )
        result = subprocess.run(
            ["uv", "tool", "install", "-U", MEMSEARCH_PACKAGE], check=False
        )
        if result.returncode != 0:
            warning(t("MemSearch CLI 安装命令未成功退出.", "The MemSearch CLI installation command failed."))
            return False
        success(t(
            f"已执行 MemSearch CLI 安装命令: uv tool install -U {MEMSEARCH_PACKAGE}",
            f"Ran the MemSearch CLI installation command: uv tool install -U {MEMSEARCH_PACKAGE}",
        ))
        return True
    except (OSError, UnicodeError, subprocess.SubprocessError) as error:
        warning(t(f"MemSearch CLI 安装过程异常: {error}", f"MemSearch CLI installation failed: {error}"))
        return False


def path_exists(path: Path) -> bool:
    return path.exists() or path.is_symlink()


def remove_path(path: Path) -> None:
    if path.is_symlink() or path.is_file():
        path.unlink()
    elif path.is_dir():
        shutil.rmtree(path)


def cleanup_committed_temporary_roots(*roots: Path) -> None:
    for root in roots:
        try:
            remove_path(root)
        except BaseException as error:
            warning(
                t(
                    f"MemSearch 已安装, 但临时目录清理失败: {root}: {error}",
                    f"MemSearch was installed, but temporary directory cleanup failed: {root}: {error}",
                )
            )


def prepare_staged_memsearch_home(staged_home: Path) -> bool:
    home = Path.home()
    staged_home.mkdir()
    for relative in MEMSEARCH_CODEX_FILES:
        source = home / relative
        if not path_exists(source):
            continue
        if source.is_symlink() or not source.is_file():
            return False
        target = staged_home / relative
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, target)
    return True


def staged_memsearch_targets(staged_home: Path) -> tuple[Path, ...] | None:
    required_files = {Path(".codex/config.toml")}
    optional_files = {
        Path(".codex/hooks.json"),
        Path(".codex/hooks.json.bak"),
    }
    skill_roots = {
        Path(".agents/skills") / skill_name for skill_name in MEMSEARCH_SKILLS
    }
    allowed_files = required_files | optional_files

    try:
        for entry in staged_home.rglob("*"):
            relative = entry.relative_to(staged_home)
            if entry.is_symlink() or not (entry.is_file() or entry.is_dir()):
                return None
            if entry.is_file() and relative in allowed_files:
                continue
            if any(relative == root or root in relative.parents for root in skill_roots):
                continue
            if entry.is_dir() and any(relative in root.parents for root in skill_roots):
                continue
            if entry.is_dir() and any(relative in path.parents for path in allowed_files):
                continue
            return None
    except OSError:
        return None

    if any(not (staged_home / relative).is_file() for relative in required_files):
        return None
    if any(not (staged_home / relative).is_dir() for relative in skill_roots):
        return None
    targets = [*required_files, *skill_roots]
    targets.extend(
        relative
        for relative in optional_files
        if path_exists(staged_home / relative)
    )
    return tuple(sorted(targets, key=str))


def replace_path_transactionally(
    source: Path,
    target: Path,
    backup: Path,
    journal: list[PathReplacement],
) -> None:
    replacement = PathReplacement(target, backup, path_exists(target))
    journal.append(replacement)
    if replacement.had_target:
        backup.parent.mkdir(parents=True, exist_ok=True)
        os.replace(target, backup)
    target.parent.mkdir(parents=True, exist_ok=True)
    os.replace(source, target)


def rollback_path_replacements(journal: list[PathReplacement]) -> None:
    for replacement in reversed(journal):
        if replacement.had_target and path_exists(replacement.backup):
            remove_path(replacement.target)
            replacement.target.parent.mkdir(parents=True, exist_ok=True)
            os.replace(replacement.backup, replacement.target)
        elif not replacement.had_target:
            remove_path(replacement.target)
    journal.clear()


def commit_staged_memsearch_home(
    staged_home: Path,
    backup_root: Path,
    targets: tuple[Path, ...],
    journal: list[PathReplacement] | None = None,
) -> bool:
    home = Path.home()
    owns_journal = journal is None
    active_journal = [] if journal is None else journal
    try:
        for relative in targets:
            replace_path_transactionally(
                staged_home / relative,
                home / relative,
                backup_root / relative,
                active_journal,
            )
    except BaseException:
        if owns_journal:
            rollback_path_replacements(active_journal)
        raise
    if owns_journal:
        active_journal.clear()
    return True


def install_memsearch_for(agent: str) -> bool:
    """帮用户执行当前 Agent 的可自动安装步骤.

    返回 True 仅表示该 Agent 可自动完成的步骤已做完, 且足以标 enabled:
    - Codex: CLI 命令与插件 install.sh 都执行成功 (不做 hooks 二次门禁)
    - Claude: CLI 命令成功, 且 Claude 插件在安装前/后已接入
      (插件只能手工装; 仅 CLI 成功不算接入完成)
    源码校验失败、安装器缺失/跳过、Claude 插件未接入时返回 False,
    即使 CLI 已装好也不把配置标为启用. doctor 仍检查实际状态.
    失败只返回 False, 由调用方提示自行安装, 不中断 welcome.
    """
    try:
        cli_ok = install_memsearch_cli()
        if agent == "codex":
            if not cli_ok:
                warning(t("CLI 安装未完成, 已跳过 Codex 插件安装.", "CLI installation did not complete; skipped the Codex plugin installation."))
                return False
            source = Path(
                os.environ.get(
                    "ONEVOKE_MEMSEARCH_SOURCE",
                    Path.home() / ".local" / "share" / "onevoke" / "memsearch",
                )
            ).expanduser()
            cached_source = source.exists() or source.is_symlink()
            if cached_source and not verify_memsearch_source(source):
                warning(
                    t(
                        "缓存的 MemSearch 源码未通过来源或工作树校验, 已跳过 Codex 插件安装器.",
                        "Cached MemSearch source failed repository or worktree verification; skipped the Codex plugin installer.",
                    )
                )
                return False
            if not shutil.which("git"):
                warning(t("未找到 git, 无法下载 MemSearch Codex 插件源码.", "git was not found; cannot download the MemSearch Codex plugin source."))
                return False
            source.parent.mkdir(parents=True, exist_ok=True)
            print(
                t(
                    f"正在把 MemSearch 默认分支最新版克隆到 {source}.",
                    f"Cloning the latest MemSearch default branch to {source}.",
                ),
                file=sys.stderr,
            )
            temporary_root_path = Path(
                tempfile.mkdtemp(prefix="memsearch.", dir=source.parent)
            )
            environment_root_path: Path | None = None
            transaction: list[PathReplacement] = []
            committed = False
            try:
                temporary_source = temporary_root_path / "source"
                result = subprocess.run(
                    [
                        "git",
                        "clone",
                        "--depth",
                        "1",
                        MEMSEARCH_REPOSITORY,
                        str(temporary_source),
                    ],
                    check=False,
                )
                if result.returncode != 0:
                    warning(t("MemSearch 源码下载命令未成功退出.", "The MemSearch source download command failed."))
                    return False
                if not verify_memsearch_source(temporary_source):
                    warning(t("最新源码未通过来源或工作树校验, 已跳过 Codex 插件安装器.", "The latest source failed repository or worktree verification; skipped the Codex plugin installer."))
                    return False
                temporary_installer = (
                    temporary_source
                    / "plugins"
                    / "codex"
                    / "scripts"
                    / "install.sh"
                )
                if not temporary_installer.is_file():
                    warning(t(f"找不到 MemSearch Codex 安装器: {temporary_installer}", f"MemSearch Codex installer not found: {temporary_installer}"))
                    return False
                previous_source = temporary_root_path / "previous"
                try:
                    replace_path_transactionally(
                        temporary_source,
                        source,
                        previous_source,
                        transaction,
                    )
                    installer = source / "plugins" / "codex" / "scripts" / "install.sh"
                    print(
                        t(
                            "Codex 插件会修改 ~/.codex 配置并替换 MemSearch skills.",
                            "The Codex plugin will modify ~/.codex configuration and replace MemSearch skills.",
                        ),
                        file=sys.stderr,
                    )
                    environment_root_path = Path(
                        tempfile.mkdtemp(prefix=".onevoke-memsearch.", dir=Path.home())
                    )
                    staged_home = environment_root_path / "home"
                    if not prepare_staged_memsearch_home(staged_home):
                        rollback_path_replacements(transaction)
                        warning(t(
                            "Codex 配置目标不是普通文件, 已取消插件安装并恢复原缓存.",
                            "A Codex configuration target is not a regular file; cancelled the plugin installation and restored the previous cache.",
                        ))
                        return False
                    installer_environment = os.environ.copy()
                    installer_environment["HOME"] = str(staged_home)
                    result = subprocess.run(
                        ["bash", str(installer)],
                        check=False,
                        env=installer_environment,
                    )
                    if result.returncode != 0:
                        rollback_path_replacements(transaction)
                        warning(
                            t(
                                "Codex 插件安装命令未成功退出; 已恢复原缓存."
                                if cached_source
                                else "Codex 插件安装命令未成功退出; 未保留失败缓存.",
                                "The Codex plugin installation command failed; restored the previous cache."
                                if cached_source
                                else "The Codex plugin installation command failed; discarded the failed cache.",
                            )
                        )
                        return False
                    targets = staged_memsearch_targets(staged_home)
                    if targets is None:
                        rollback_path_replacements(transaction)
                        warning(t(
                            "Codex 插件安装器生成了不受支持的文件布局; 已恢复原缓存且未修改真实 Agent 环境.",
                            "The Codex plugin installer produced an unsupported file layout; restored the previous cache without modifying the real Agent environment.",
                        ))
                        return False
                    committed = commit_staged_memsearch_home(
                        staged_home,
                        environment_root_path / "backup",
                        targets,
                        transaction,
                    )
                except BaseException:
                    if not committed:
                        rollback_path_replacements(transaction)
                    raise
                success(t("已执行 MemSearch Codex 插件安装命令.", "Ran the MemSearch Codex plugin installation command."))
                return True
            finally:
                temporary_roots = tuple(
                    root
                    for root in (environment_root_path, temporary_root_path)
                    if root is not None
                )
                if committed:
                    cleanup_committed_temporary_roots(*temporary_roots)
                else:
                    for root in temporary_roots:
                        remove_path(root)
        if agent == "claude":
            # 插件只能在 Claude Code 内手工装; 仅 CLI 成功不算接入完成.
            if not cli_ok:
                warning(t("CLI 安装命令未完成; 仍给出 Claude 插件接入步骤.", "CLI installation did not complete; Claude plugin setup steps follow."))
                print(
                    t(
                        "Claude 的 MemSearch 插件需在 Claude Code 内手动安装 (Onevoke 只代跑 CLI):",
                        "Install Claude's MemSearch plugin manually in Claude Code (Onevoke only runs the CLI installation):",
                    ),
                    file=sys.stderr,
                )
                print_claude_memsearch_install()
                return False
            if claude_memsearch_ready():
                success(t("MemSearch CLI 已就绪, 且 Claude 插件已接入.", "MemSearch CLI is ready and the Claude plugin is connected."))
                return True
            print(
                t(
                    "Claude 的 MemSearch 插件需在 Claude Code 内手动安装 (Onevoke 只代跑 CLI):",
                    "Install Claude's MemSearch plugin manually in Claude Code (Onevoke only runs the CLI installation):",
                ),
                file=sys.stderr,
            )
            print_claude_memsearch_install()
            return False
        return cli_ok
    except (OSError, UnicodeError, subprocess.SubprocessError) as error:
        warning(t(f"MemSearch 安装过程异常: {error}", f"MemSearch installation failed: {error}"))
        return False


def install_tmux() -> bool:
    managers = (
        ("brew", ["brew", "install", "tmux"]),
        ("apt-get", ["apt-get", "install", "-y", "tmux"]),
        ("dnf", ["dnf", "install", "-y", "tmux"]),
        ("pacman", ["pacman", "-S", "--needed", "--noconfirm", "tmux"]),
        ("apk", ["apk", "add", "tmux"]),
    )
    selected = next((command for name, command in managers if shutil.which(name)), None)
    if selected is None:
        warning(t("没有找到受支持的包管理器, 请手动安装 tmux.", "No supported package manager was found; install tmux manually."))
        return False
    if selected[0] != "brew" and hasattr(os, "geteuid") and os.geteuid() != 0:
        sudo = shutil.which("sudo")
        if not sudo:
            warning(t(f"安装 tmux 需要管理员权限: {' '.join(selected)}", f"Installing tmux requires administrator privileges: {' '.join(selected)}"))
            return False
        selected = [sudo, *selected]
    print(t(f"即将运行: {' '.join(selected)}", f"About to run: {' '.join(selected)}"), file=sys.stderr)
    result = subprocess.run(selected, check=False)
    if result.returncode != 0 or not shutil.which("tmux"):
        warning(t("tmux 安装失败或安装后仍不在 PATH.", "tmux installation failed or tmux is still not in PATH."))
        return False
    success(t("tmux 已安装.", "tmux is installed."))
    return True


def configure_welcome(existing: dict[str, Any]) -> dict[str, Any]:
    agents = find_agents()
    for name, state in agents.items():
        if state["path"] and not agent_usable(state):
            warning(
                t(
                    f"{AGENT_LABELS[name]} 的 --version 失败, 已从可选列表排除: {state['path']}",
                    f"{AGENT_LABELS[name]} --version failed; excluded from choices: {state['path']}",
                )
            )
    execution_choices = [
        (name, f"{AGENT_LABELS[name]} ({state['version']})")
        for name, state in agents.items()
        if agent_usable(state)
    ]
    if not execution_choices:
        raise OnevokeError(
            t(
                "没有发现可用的 Agent (--version 须成功). 请先安装 Codex、Claude 或 Grok.",
                "No usable Agent found (--version must succeed). Install Codex, Claude, or Grok first.",
            )
        )

    config = default_config()
    config["kanban_agent"] = ask_choice(
        t("kanban 默认用哪个 Agent 执行任务?", "Which Agent should kanban use by default?"),
        execution_choices,
        existing["kanban_agent"] if agent_usable(agents.get(existing["kanban_agent"], {})) else None,
    )

    review_choices = [
        (name, f"{AGENT_LABELS[name]} ({agents[name]['version']})")
        for name in REVIEW_AGENTS
        if agent_usable(agents[name])
    ]
    if not review_choices:
        raise OnevokeError(t("没有发现可用 Reviewer. 请安装 Codex 或 Grok.", "No usable Reviewer found. Install Codex or Grok."))
    for role in REVIEW_ROLES:
        previous = existing["reviewers"][role]
        config["reviewers"][role] = ask_choice(
            t(f"{role} 使用哪个 Reviewer?", f"Which Reviewer should {role} use?"),
            review_choices,
            previous if agent_usable(agents.get(previous, {})) else None,
        )

    if shutil.which("tmux"):
        # doctor 已输出唯一启动命令; 这里不再重复.
        launcher_choices = [
            ("tmux", t("tmux 新窗口", "new tmux window")),
            ("foreground", t("当前终端前台运行", "foreground in this terminal")),
        ]
        config["launcher"] = ask_choice(
            t("kanban start 使用哪种启动方式?", "How should kanban start launch tasks?"),
            launcher_choices,
            existing["launcher"],
        )
    else:
        warning(t("未安装 tmux.", "tmux is not installed."))
        if ask_yes_no(t("是否现在安装 tmux?", "Install tmux now?"), default=False):
            if install_tmux():
                config["launcher"] = "tmux"
            elif ask_yes_no(t("tmux 未安装成功, 是否改用当前终端前台模式?", "tmux was not installed; use foreground mode in this terminal?"), default=True):
                config["launcher"] = "foreground"
            else:
                raise OnevokeError(t("没有可用启动方式, 配置未更改", "No launcher is available; configuration was not changed"))
        else:
            config["launcher"] = "foreground"
            print(t("已选择当前终端前台运行模式.", "Selected foreground mode in this terminal."), file=sys.stderr)

    selected_agent = config["kanban_agent"]
    integrated, detail = rules_integration(selected_agent)
    if integrated:
        success(t(f"{AGENT_LABELS[selected_agent]} 已接入 Onevoke 规则: {detail}", f"{AGENT_LABELS[selected_agent]} is connected to Onevoke rules: {detail}"))
    else:
        warning(t(f"{AGENT_LABELS[selected_agent]} 尚未接入 Onevoke 规则: {detail}", f"{AGENT_LABELS[selected_agent]} is not connected to Onevoke rules: {detail}"))
        print(t(
            "请按 README 的接入章节配置, welcome 不会覆盖你的全局规则文件.",
            "Follow the README integration section; welcome will not overwrite your global rules file.",
        ), file=sys.stderr)

    memory = memsearch_state()
    memory_agent = selected_agent if selected_agent in ("codex", "claude") else None
    memory_ready = bool(
        memory_agent
        and memory["cli_ready"]
        and memory.get(f"{memory_agent}_plugin", False)
    )
    config["memsearch"]["enabled"] = False
    if memory_ready:
        config["memsearch"]["enabled"] = True
        success(t(f"MemSearch CLI 和 {AGENT_LABELS[memory_agent]} 插件均可用.", f"MemSearch CLI and the {AGENT_LABELS[memory_agent]} plugin are ready."))
    elif memory_agent:
        print(
            t(
                "MemSearch 未完整安装. 若确认, Onevoke 将代为执行安装命令 ",
                "MemSearch is not fully installed. With confirmation, Onevoke will run the installation commands ",
            )
            + f"(CLI: uv tool install -U {MEMSEARCH_PACKAGE}"
            + (
                t("; 另会 clone 默认分支最新版并运行 Codex 插件 install.sh", "; it will also clone the latest default branch and run the Codex plugin install.sh")
                if memory_agent == "codex"
                else t("; Claude 插件仍须在 Claude Code 内手动装", "; the Claude plugin must still be installed manually in Claude Code")
            )
            + t("). 拒绝或安装失败时仅提示自行安装, 不中断其它配置.", "). If declined or unsuccessful, manual steps are shown and other configuration continues."),
            file=sys.stderr,
        )
        if ask_yes_no(t("确认现在由 Onevoke 执行 MemSearch 安装过程?", "Allow Onevoke to install MemSearch now?"), default=False):
            # 失败不抛错、不中断 welcome; 只提示自行安装.
            installed = install_memsearch_for(memory_agent)
            if installed:
                config["memsearch"]["enabled"] = True
                print(
                    t(
                        "已按确认执行安装步骤. doctor 仍可检查实际就绪状态.",
                        "Ran the confirmed installation steps. doctor can still check actual readiness.",
                    ),
                    file=sys.stderr,
                )
            else:
                warning(t("MemSearch 安装未完成.", "MemSearch installation did not complete."))
                print_memsearch_manual_install(memory_agent)
        else:
            print(t("已跳过 MemSearch 安装.", "Skipped MemSearch installation."), file=sys.stderr)
            print_memsearch_manual_install(memory_agent)
    else:
        warning(t("当前可用 Agent 没有 Onevoke 支持的 MemSearch 插件.", "The current Agent has no MemSearch plugin supported by Onevoke."))
        cli_prompt = (
            t("MemSearch CLI 未安装, 是否确认执行 CLI 安装命令?", "MemSearch CLI is not installed; run its installation command?")
            if not memory["cli"]
            else (
                t(
                    "MemSearch CLI 无法正常报告版本, 是否确认安装 PyPI 最新版?",
                    "MemSearch CLI could not report a valid version; install the latest PyPI release?",
                )
            )
        )
        if not memory["cli_ready"] and ask_yes_no(cli_prompt, default=False):
            if install_memsearch_cli():
                success(t("已执行 MemSearch CLI 安装命令; 当前 Agent 无对应插件.", "Ran the MemSearch CLI installation command; the current Agent has no matching plugin."))
            else:
                warning(t("MemSearch CLI 安装未完成.", "MemSearch CLI installation did not complete."))
                print_memsearch_manual_install(None)
        elif not memory["cli_ready"]:
            print_memsearch_manual_install(None)

    print(t("\n配置摘要:", "\nConfiguration summary:"), file=sys.stderr)
    print(f"  {t('执行 Agent', 'Execution Agent')}: {config['kanban_agent']}", file=sys.stderr)
    print(f"  {t('启动方式', 'Launcher')}: {config['launcher']}", file=sys.stderr)
    for role in REVIEW_ROLES:
        print(f"  {role}: {config['reviewers'][role]}", file=sys.stderr)
    print(f"  MemSearch: {t('启用', 'enabled') if config['memsearch']['enabled'] else t('未启用', 'disabled')}", file=sys.stderr)
    print(
        color("1;33", t(
            "注意: kanban start 会使用 Agent 的免确认模式执行已确认任务.",
            "Note: kanban start uses the Agent's no-confirmation mode for confirmed tasks.",
        )),
        file=sys.stderr,
    )
    if not ask_yes_no(t("保存以上配置?", "Save this configuration?"), default=True):
        raise OnevokeError(t("用户取消, 配置未更改", "Cancelled; configuration was not changed"))
    config["welcome_complete"] = True
    return config


def command_welcome(reset: bool) -> int:
    print_doctor()
    try:
        existing = load_config()
    except ConfigError as error:
        warning(str(error))
        if not reset:
            print(t("使用 onevoke welcome --reset 重新创建配置.", "Run onevoke welcome --reset to recreate the configuration."), file=sys.stderr)
            return 1
        existing = default_config()

    if existing["welcome_complete"] and not reset:
        success(t(f"welcome 已完成: {config_path()}", f"welcome is complete: {config_path()}"))
        print(t("如需重新选择, 运行 onevoke welcome --reset.", "Run onevoke welcome --reset to choose again."), file=sys.stderr)
        return 0
    if not (sys.stdin.isatty() and sys.stderr.isatty()):
        warning(t("当前没有交互终端, welcome 未完成.", "No interactive terminal is available; welcome is incomplete."))
        print(t("请在终端运行 onevoke welcome.", "Run onevoke welcome in a terminal."), file=sys.stderr)
        return 0
    try:
        configured = configure_welcome(existing)
        path = save_config(configured)
    except (OnevokeError, ConfigError, OSError, UnicodeError) as error:
        warning(str(error))
        return 1
    success(t(f"配置已保存: {path}", f"Configuration saved: {path}"))
    return 0


def command_review(arguments: list[str]) -> NoReturn:
    if len(arguments) < 5 or len(arguments) > 6:
        raise OnevokeError(
            t(
                "用法: onevoke review <worktree> <base> <commit> <role> <task> [context]",
                "usage: onevoke review <worktree> <base> <commit> <role> <task> [context]",
            )
        )
    role = arguments[3]
    aliases = {name.lower(): name for name in REVIEW_ROLES}
    aliases["codesecurityanalyst"] = "CSA"
    normalized = aliases.get(role.lower())
    if not normalized:
        raise OnevokeError(t(f"不支持的 Reviewer 角色: {role}", f"Unsupported Reviewer role: {role}"))
    config = effective_config(load_config())
    reviewer = config["reviewers"][normalized]
    wrapper = shutil.which(f"{reviewer}-review.sh")
    if not wrapper:
        raise OnevokeError(t(f"Reviewer wrapper 不在 PATH: {reviewer}-review.sh", f"Reviewer wrapper is not in PATH: {reviewer}-review.sh"))
    arguments[3] = normalized
    os.execv(wrapper, [wrapper, *arguments])


def print_config(config: dict[str, Any]) -> None:
    effective = effective_config(config)
    status = t("已完成", "complete") if config["welcome_complete"] else t("未完成", "incomplete")
    print(f"welcome: {status}")
    print(f"kanban agent: {effective['kanban_agent']}")
    print(f"launcher: {effective['launcher']}")
    for role in REVIEW_ROLES:
        print(f"{role}: {effective['reviewers'][role]}")
    print(f"MemSearch: {t('启用', 'enabled') if effective['memsearch']['enabled'] else t('未启用', 'disabled')}")


def parser() -> argparse.ArgumentParser:
    result = LocalizedArgumentParser(prog="onevoke", description=t("Onevoke 配置与诊断", "Onevoke configuration and diagnostics"))
    result.add_argument("--lang", choices=LANGUAGES, help=t("覆盖输出语言", "override the output language"))
    commands = result.add_subparsers(dest="command", required=True)
    welcome = commands.add_parser("welcome", help=t("检查环境并完成首次配置", "check the environment and complete initial setup"))
    welcome.add_argument("--reset", action="store_true", help=t("重新执行配置向导", "run the setup wizard again"))
    commands.add_parser("doctor", help=t("检查 Onevoke 环境", "check the Onevoke environment"))
    config = commands.add_parser("config", help=t("输出当前配置", "print the current configuration"))
    config.add_argument("--json", action="store_true", help=t("以 JSON 输出", "output JSON"))
    review = commands.add_parser("review", help=t("按配置选择 Reviewer wrapper", "select a Reviewer wrapper from configuration"))
    review.add_argument("arguments", nargs=argparse.REMAINDER, metavar=t("参数", "arguments"))
    return result


def main() -> int:
    args = parser().parse_args()
    try:
        if args.command == "welcome":
            return command_welcome(args.reset)
        if args.command == "doctor":
            return 0 if print_doctor() else 1
        if args.command == "config":
            config = load_config()
            if args.json:
                print(json.dumps(config, ensure_ascii=False, indent=2))
            else:
                print_config(config)
            return 0
        if args.command == "review":
            command_review(args.arguments)
        return 0
    except KeyboardInterrupt:
        print(t("\nonevoke: 用户取消, 配置未更改", "\nonevoke: cancelled; configuration was not changed"), file=sys.stderr)
        return 130
    except (OnevokeError, ConfigError, OSError, UnicodeError) as error:
        print(f"onevoke: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
